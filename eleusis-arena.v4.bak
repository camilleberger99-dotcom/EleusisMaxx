<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ELEUSIS ARENA — the induction arena</title>
<style>
:root{
  --bg0:#0b0d20; --bg1:#141737; --panel:#181c40; --panel2:#1f2450;
  --ink:#eef0ff; --dim:#8b90c0; --accent:#ffd32a; --ok:#2ed573; --ko:#ff4757;
  --cardline:#343a6e; --char:#3d8bff; --charA:#3d8bff55;
}
*{box-sizing:border-box; -webkit-user-select:none; user-select:none;}
html,body{height:100%;}
body{
  margin:0; color:var(--ink); --amp:1;
  font-family:"Segoe UI","Hiragino Sans","Yu Gothic",system-ui,sans-serif;
  background:
    radial-gradient(1200px 600px at 20% -10%, #232a66 0%, transparent 60%),
    radial-gradient(900px 500px at 110% 110%, #3a1856 0%, transparent 55%),
    linear-gradient(160deg, var(--bg0), var(--bg1));
  overflow:hidden;
}
button{font-family:inherit;}
.hidden{display:none !important;}

/* ===== decor: floating symbols, gears, glow ===== */
#bgSymbols{position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden;}
#bgSymbols span{position:absolute; color:#8b90c0; opacity:.075; font-weight:800; white-space:nowrap;
  font-family:"Cambria Math","Times New Roman",serif; font-style:italic;
  animation:drift var(--t,30s) ease-in-out infinite; animation-delay:var(--dl,0s);}
@keyframes drift{0%,100%{transform:translate(0,0) rotate(0);}50%{transform:translate(var(--dx,40px),var(--dy,-60px)) rotate(var(--r,20deg));}}
#gears{position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden;}
.gear{position:absolute; animation:gearspin var(--d,16s) linear infinite; opacity:var(--o,.09);}
.gear.rev{animation-direction:reverse;}
@keyframes gearspin{to{transform:rotate(360deg);}}
body.rush .gear{animation-duration:calc(var(--d,16s)/5);}
#glowFrame{position:fixed; inset:0; pointer-events:none; z-index:46;
  box-shadow:inset 0 0 90px 12px rgba(90,110,255,.20), inset 0 0 240px 40px rgba(160,80,255,.10);
  animation:breathe 5.5s ease-in-out infinite;}
@keyframes breathe{50%{box-shadow:inset 0 0 130px 20px rgba(90,110,255,.33), inset 0 0 300px 70px rgba(255,120,220,.13);}}
#glowFrame.flash-good{animation:glowGood 1s ease-out;}
@keyframes glowGood{0%{box-shadow:inset 0 0 170px 45px rgba(46,213,115,.6), inset 0 0 320px 90px rgba(255,211,42,.25);}
  100%{box-shadow:inset 0 0 90px 12px rgba(90,110,255,.20), inset 0 0 240px 40px rgba(160,80,255,.10);}}
#glowFrame.flash-bad{animation:glowBad 1s ease-out;}
@keyframes glowBad{0%{box-shadow:inset 0 0 190px 60px rgba(255,71,87,.65), inset 0 0 340px 100px rgba(255,40,40,.3);}
  100%{box-shadow:inset 0 0 90px 12px rgba(90,110,255,.20), inset 0 0 240px 40px rgba(160,80,255,.10);}}

/* ===== layout ===== */
#app{position:relative; z-index:2; height:100vh; display:grid; grid-template-rows:auto minmax(0,1fr) auto auto; gap:8px; padding:8px 12px;}
#app.punch{animation:punch .22s ease-out;}
@keyframes punch{40%{transform:scale(1.014);}}

/* ===== HUD ===== */
#hud{display:flex; align-items:center; gap:8px; min-width:0;}
#logo{font-weight:900; font-size:20px; letter-spacing:2px; font-style:italic; white-space:nowrap;
  background:linear-gradient(90deg,#ffd32a,#ff7f2a,#ff4757); -webkit-background-clip:text; background-clip:text; color:transparent;
  filter:drop-shadow(0 0 10px rgba(255,150,40,.35)); animation:logoGlow 3s ease-in-out infinite;}
@keyframes logoGlow{50%{filter:drop-shadow(0 0 18px rgba(255,150,40,.75));}}
#levelMap{display:flex; gap:5px; align-items:center; padding:0 6px;}
.lvdot{width:17px; height:17px; border-radius:4px; transform:rotate(45deg); background:var(--panel2);
  border:2px solid var(--cardline); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:transform .15s;}
.lvdot span{transform:rotate(-45deg); font-size:9px; font-weight:900; color:var(--dim);}
.lvdot:hover{transform:rotate(45deg) scale(1.3);}
.lvdot.cleared{background:linear-gradient(135deg,#ffd32a,#ff9f2a); border-color:#fff6;}
.lvdot.cleared span{color:#1a1206;}
.lvdot.cur{border-color:var(--char); box-shadow:0 0 10px var(--char); animation:lvpulse 1.2s ease-in-out infinite;}
@keyframes lvpulse{50%{box-shadow:0 0 20px var(--char);}}
.hudbox{background:var(--panel); border:1px solid var(--cardline); border-radius:12px;
  padding:5px 11px; display:flex; align-items:baseline; gap:7px; min-width:0; white-space:nowrap;}
.hudbox .lbl{font-size:9px; letter-spacing:2px; color:var(--dim); text-transform:uppercase;}
.hudbox .val{font-weight:800; font-size:17px; font-variant-numeric:tabular-nums;}
#brierBox{border-color:var(--accent); box-shadow:0 0 16px rgba(255,211,42,.25);}
#brierBox .val{font-size:23px; display:inline-block;}
#brierVal.good{color:var(--ok); text-shadow:0 0 10px rgba(46,213,115,.7);}
#brierVal.bad{color:var(--ko); text-shadow:0 0 10px rgba(255,71,87,.7);}
#brierVal.bump{animation:bump .35s;}
@keyframes bump{40%{transform:scale(1.35);}}
#rankVal{max-width:150px; overflow:hidden; text-overflow:ellipsis; font-size:13px !important; color:var(--char); text-shadow:0 0 8px var(--char); font-style:italic; letter-spacing:1px;}
#comboBox{position:relative; overflow:hidden; min-width:90px;}
#comboMeter{position:absolute; left:0; right:0; bottom:0; height:3px; background:#2a2f5e;}
#comboFill{height:100%; width:0; background:linear-gradient(90deg,#ffd32a,#ff4757); transition:width .3s;}
#comboBox.fire{border-color:#ff7f2a; background:linear-gradient(0deg, rgba(255,90,30,.4), transparent 75%), var(--panel);
  animation:fire .4s ease-in-out infinite alternate;}
#comboBox.fire .val{color:var(--accent); text-shadow:0 0 12px #ff7f2a;}
@keyframes fire{to{box-shadow:0 -4px 20px rgba(255,120,40,.75);}}
#hud .spacer{flex:1;}
.iconbtn{background:var(--panel); color:var(--ink); border:1px solid var(--cardline);
  border-radius:10px; padding:6px 10px; font-size:15px; cursor:pointer; transition:transform .08s;}
.iconbtn:hover{transform:translateY(-2px); border-color:var(--char);}
select#levelSel{background:var(--panel); color:var(--ink); border:1px solid var(--cardline);
  border-radius:10px; padding:6px 8px; font-size:12px; cursor:pointer; max-width:165px;}
@media (max-width:1420px){ #logo{display:none;} }
@media (max-width:1180px){ #levelMap{display:none;} }
#csStats{display:flex; flex-direction:column; gap:7px;}

/* ===== main area ===== */
#main{display:grid; grid-template-columns:270px minmax(0,1fr); gap:10px; min-height:0;}
#leftPanel{display:flex; flex-direction:column; gap:8px; min-height:0;}
#stage{position:relative; flex:1; min-height:150px; border-radius:16px; overflow:hidden; border:2px solid var(--char);
  box-shadow:0 0 22px var(--charA);}
#stageBg{position:absolute; inset:0;
  background:radial-gradient(circle at 50% 82%, var(--charA), transparent 62%),
    repeating-linear-gradient(-55deg, rgba(255,255,255,.035) 0 14px, transparent 14px 28px), #12153a;
  animation:stripes 8s linear infinite;}
@keyframes stripes{to{background-position:0 0, 79px 0, 0 0;}}
#stageBg::after{content:""; position:absolute; left:50%; bottom:-26px; width:230px; height:56px; transform:translateX(-50%);
  border-radius:50%; background:radial-gradient(ellipse, var(--char), transparent 70%); opacity:.55;}
#avatarMotion{position:absolute; left:0; right:0; bottom:0; top:40px; display:flex; justify-content:center; align-items:flex-end;}
#avatar{height:100%; aspect-ratio:200/264; max-width:100%;}
#avatar svg, #csAvatar svg, #mChar svg{width:100%; height:100%; display:block; overflow:visible;}
.rx-idle > div{animation:bob 2.6s ease-in-out infinite;}
@keyframes bob{50%{transform:translateY(-4px);}}
.rx-win > div{animation:jump .55s cubic-bezier(.3,1.6,.5,1) 2;}
@keyframes jump{40%{transform:translateY(-22px) scale(1.04,.96);}}
.rx-victory > div{animation:jump .5s cubic-bezier(.3,1.6,.5,1) 5;}
.rx-lose > div{animation:droop .9s ease-out;}
@keyframes droop{30%{transform:translateY(6px) rotate(-3deg);}60%{transform:translateY(4px) rotate(2deg);}}
.rx-shocked > div{animation:jolt .55s;}
@keyframes jolt{0%{transform:none;}15%{transform:scale(1.15) translateY(-12px);}30%{transform:translateX(-7px);}45%{transform:translateX(7px);}60%{transform:translateX(-4px);}100%{transform:none;}}
.rx-combo > div{animation:vibe .08s linear infinite;}
@keyframes vibe{50%{transform:translate(1.5px,-1px);}}
.rx-thinking > div{animation:sway 1.6s ease-in-out infinite;}
@keyframes sway{50%{transform:rotate(2deg);}}
.rx-select > div{animation:selpop .6s cubic-bezier(.2,1.8,.4,1);}
@keyframes selpop{0%{transform:scale(.6) rotate(-8deg);}100%{transform:none;}}
.rx-defeat > div{animation:sink 1.2s ease-out forwards;}
@keyframes sink{to{transform:translateY(8px) scale(.97);}}
.chr .chr-eyes{transform-box:fill-box; transform-origin:center; animation:blink 4.2s infinite;}
@keyframes blink{0%,94%,100%{transform:scaleY(1);}96%{transform:scaleY(.1);}}
.chr .chr-rays{transform-box:view-box; transform-origin:100px 150px; animation:gearspin 9s linear infinite;}
.chr .chr-aura{transform-box:view-box; transform-origin:100px 262px; animation:flick .16s ease-in-out infinite alternate;}
@keyframes flick{to{transform:scale(1.05,1.1);}}
.chr .chr-twinkle{transform-box:fill-box; transform-origin:center; animation:twinkle 1s ease-in-out infinite;}
@keyframes twinkle{50%{transform:scale(.4) rotate(45deg); opacity:.5;}}
.chr .chr-smoke{transform-box:fill-box; transform-origin:center; animation:smoke 2.4s ease-out infinite;}
@keyframes smoke{0%{opacity:0; transform:translate(0,0) scale(.6);}30%{opacity:.7;}100%{opacity:0; transform:translate(10px,-34px) scale(1.7);}}
.chr .chr-cloud{animation:bob 2s ease-in-out infinite;}
.chr .chr-glow{transform-box:fill-box; transform-origin:center; animation:twinkle 1.4s ease-in-out infinite;}
#bubble{position:absolute; top:8px; left:10px; right:10px; z-index:3; background:#fff; color:#141737; font-weight:800;
  font-size:13px; line-height:1.3; padding:8px 11px; border-radius:14px; border:3px solid #0b0d20; box-shadow:0 4px 0 #0b0d20; min-height:22px;}
#bubble::after{content:""; position:absolute; left:50%; bottom:-15px; border:8px solid transparent; border-top-color:#0b0d20; transform:translateX(-50%);}
#bubble.pop{animation:popin .3s cubic-bezier(.2,2,.4,1);}
#charTag{position:absolute; left:8px; bottom:8px; z-index:3; display:flex; flex-direction:column; background:rgba(8,10,26,.8);
  border-left:4px solid var(--char); padding:3px 8px; border-radius:4px;}
#charTag b{font-size:13px; letter-spacing:2px; font-style:italic;}
#charTag span{font-size:9px; color:var(--dim); letter-spacing:1px;}
#gaugeBox{display:flex; align-items:center; gap:6px; background:var(--panel); border:1px solid var(--cardline); border-radius:14px; padding:4px 10px;}
#gauge{width:118px; height:66px; flex:0 0 auto; overflow:visible;}
#needle{transform-origin:100px 100px; transition:transform .7s cubic-bezier(.3,1.7,.5,1);}
#gaugeNum{font-size:25px; font-weight:900; font-variant-numeric:tabular-nums; line-height:1;}
#gaugeRank{font-size:11px; letter-spacing:1px; color:var(--char); font-weight:900; text-transform:uppercase; font-style:italic;}
#gaugeSub{font-size:9px; color:var(--dim);}
#charts{display:grid; grid-template-columns:1fr 1fr; gap:6px;}
.chart{background:var(--panel); border:1px solid var(--cardline); border-radius:12px; padding:4px 6px;}
.chart svg{width:100%; height:64px; display:block;}
.clbl{font-size:9px; letter-spacing:1.5px; color:var(--dim); text-transform:uppercase;}
@media (max-height:760px){ #charts{display:none;} }

/* ===== timeline ===== */
#timelineWrap{position:relative; min-height:0; background:rgba(10,12,30,.55); border:1px solid var(--cardline);
  border-radius:16px; padding:10px; overflow:hidden;}
#tlLabels{position:absolute; left:14px; top:8px; bottom:8px; display:flex; flex-direction:column;
  justify-content:space-around; z-index:1; pointer-events:none;}
#tlLabels div{font-size:10px; letter-spacing:2px; color:var(--dim); text-transform:uppercase;
  writing-mode:vertical-rl; transform:rotate(180deg); opacity:.8;}
#tlHint{position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); color:var(--dim); font-size:15px; letter-spacing:3px;
  text-align:center; pointer-events:none; opacity:.7; animation:hintpulse 2.2s ease-in-out infinite; text-transform:uppercase;}
#timeline{height:100%; overflow-x:auto; overflow-y:auto; display:flex; align-items:flex-start;
  gap:8px; padding:6px 10px 6px 34px; scroll-behavior:smooth;}
#timeline::-webkit-scrollbar{height:8px; width:8px;}
#timeline::-webkit-scrollbar-thumb{background:#333a72; border-radius:4px;}
.tlcol{display:flex; flex-direction:column; gap:6px; align-items:center; flex:0 0 auto;}
.tlAccept{height:118px; display:flex; align-items:center;}
.tlRejects{display:flex; flex-direction:column; gap:4px; align-items:center;}
.startMark{width:86px; height:112px; border:2px dashed #3a3f75; border-radius:12px;
  display:flex; align-items:center; justify-content:center; color:var(--dim); font-size:11px; letter-spacing:2px; text-align:center;}
.card{position:relative; border-radius:12px; filter:drop-shadow(0 4px 10px rgba(0,0,0,.5)); transition:transform .12s;}
.card:hover{transform:translateY(-6px) scale(1.08) rotate(-2deg); z-index:3;}
.card.ok{animation:popin .45s cubic-bezier(.2,2.2,.4,1);}
.card.ko{animation:koslide .4s ease-out; opacity:.7;}
.card.ko::after{content:"✕"; position:absolute; inset:0; display:flex; align-items:center;
  justify-content:center; font-size:38px; font-weight:900; color:var(--ko); text-shadow:0 0 10px rgba(255,71,87,.9); pointer-events:none;}
.card .betTag{position:absolute; right:3px; bottom:3px; font-size:10px; font-weight:900;
  padding:1px 5px; border-radius:6px; background:rgba(10,12,30,.9);}
.card .betTag.g{color:var(--ok);} .card .betTag.b{color:var(--ko);} .card .betTag.n{color:var(--dim);}
.card.great{box-shadow:0 0 0 2px var(--ok), 0 0 16px rgba(46,213,115,.6);}
.card.awful{box-shadow:0 0 0 2px var(--ko), 0 0 16px rgba(255,71,87,.6);}
@keyframes popin{0%{transform:scale(.2) rotate(-14deg);}60%{transform:scale(1.15) rotate(3deg);}100%{transform:scale(1) rotate(0);}}
@keyframes koslide{0%{transform:translateY(-18px); opacity:0;}100%{transform:translateY(0); opacity:.7;}}

/* ===== builder ===== */
#builder{display:grid; grid-template-columns:auto minmax(0,1fr) auto auto; gap:12px; background:var(--panel);
  border:1px solid var(--cardline); border-radius:16px; padding:10px 12px; align-items:center; box-shadow:0 -6px 30px rgba(0,0,0,.25);}
#preview{perspective:600px; display:flex; flex-direction:column; align-items:center; gap:4px;}
#previewCard{transition:transform .12s; filter:drop-shadow(0 8px 14px rgba(0,0,0,.5));}
#previewLbl{font-size:9px; letter-spacing:2px; color:var(--dim); text-transform:uppercase;}
#dims{display:flex; flex-direction:column; gap:6px; justify-content:center; min-width:0; overflow-y:auto; max-height:210px;}
.dimrow{display:flex; align-items:center; gap:6px; flex-wrap:wrap;}
.dimlbl{font-size:9px; letter-spacing:2px; color:var(--dim); text-transform:uppercase; width:56px; flex:0 0 auto;}
.chip{background:var(--panel2); border:1.5px solid var(--cardline); color:var(--ink); border-radius:999px; padding:3px 10px;
  font-size:12px; cursor:pointer; transition:transform .07s, border-color .07s, background .07s; display:inline-flex; align-items:center; gap:5px;}
.chip:hover{transform:translateY(-2px) scale(1.06);}
.chip.sel{border-color:var(--accent); background:#33307a; box-shadow:0 0 10px rgba(255,211,42,.35); font-weight:800;}
.chip .dot{width:10px; height:10px; border-radius:50%; display:inline-block;}
#betPanel{display:flex; flex-direction:column; align-items:center; gap:4px; background:var(--panel2);
  border:1px solid var(--cardline); border-radius:14px; padding:8px 12px;}
#betHead{font-size:12px; letter-spacing:1px; color:var(--dim);}
#betVal{font-size:22px; color:var(--accent); font-variant-numeric:tabular-nums; display:inline-block; min-width:58px; text-align:center;}
#betSlider{-webkit-appearance:none; appearance:none; width:230px; height:14px; border-radius:7px; outline:none; cursor:pointer;
  background:linear-gradient(90deg,#ff4757 0%,#7a5a9e 50%,#2ed573 100%); box-shadow:inset 0 2px 4px rgba(0,0,0,.5);}
#betSlider::-webkit-slider-thumb{-webkit-appearance:none; width:26px; height:26px; border-radius:50%; background:#fff;
  border:5px solid var(--char); box-shadow:0 0 14px var(--char); cursor:grab;}
#betSlider::-moz-range-thumb{width:18px; height:18px; border-radius:50%; background:#fff; border:5px solid var(--char); box-shadow:0 0 14px var(--char);}
#betScale{display:flex; justify-content:space-between; width:230px; font-size:9px; color:var(--dim); letter-spacing:1px;}
#betQuick{display:flex; gap:4px;}
#betQuick button{background:#141737; border:1px solid var(--cardline); color:var(--ink); border-radius:8px; padding:2px 7px;
  font-size:11px; font-weight:800; cursor:pointer; transition:transform .07s;}
#betQuick button:hover{border-color:var(--char); transform:translateY(-2px);}
#betVerbal{font-size:12px; font-weight:900; letter-spacing:1.5px; text-transform:uppercase; transition:color .2s;}
#betStakes{font-size:10px; color:var(--dim);}
#betStakes b{color:var(--ink);}
#actions{display:flex; flex-direction:column; gap:10px; justify-content:center; align-items:stretch;}
#btnTest{font-size:22px; font-weight:900; letter-spacing:2px; padding:14px 30px; border:none; border-radius:14px; cursor:pointer; color:#1a1206;
  font-style:italic; background:linear-gradient(135deg,#ffd32a,#ff9f2a); box-shadow:0 6px 0 #9c6c00, 0 8px 24px rgba(255,180,40,.35);
  transition:transform .07s, box-shadow .07s; animation:btnpulse 2.2s infinite;}
#btnTest small, #btnReveal small{display:block; font-size:9px; letter-spacing:2px; opacity:.7; font-style:normal;}
#btnTest:active{transform:translateY(5px); box-shadow:0 1px 0 #9c6c00;}
@keyframes btnpulse{0%,100%{filter:brightness(1);}50%{filter:brightness(1.15);}}
#btnReveal{font-size:13px; font-weight:900; letter-spacing:1px; padding:9px 14px; border:none; border-radius:12px; cursor:pointer; color:#fff;
  background:linear-gradient(135deg,#a55eea,#5e6cea); box-shadow:0 4px 0 #3c2c86; transition:transform .07s;}
#btnReveal:active{transform:translateY(3px); box-shadow:0 1px 0 #3c2c86;}
#btnReveal:disabled{opacity:.4; cursor:not-allowed;}

/* ===== ticker ===== */
#ticker{display:flex; align-items:center; gap:8px; height:26px; overflow:hidden; background:rgba(10,12,30,.6);
  border:1px solid var(--cardline); border-radius:10px; padding:0 8px;}
.tlbl{font-size:9px; letter-spacing:2px; color:var(--accent); font-weight:900;}
#tickerItems{display:flex; gap:6px; overflow:hidden; flex:1;}
.tick{flex:0 0 auto; font-size:11px; padding:1px 8px; border-radius:6px; background:var(--panel2); border:1px solid var(--cardline); white-space:nowrap;}
.tick:first-child{animation:tickin .35s ease-out;}
.tick.g{border-color:rgba(46,213,115,.6);} .tick.b{border-color:rgba(255,71,87,.6);}
@keyframes tickin{from{transform:translateX(-30px); opacity:0;}}

/* ===== overlays / fx ===== */
#fxCanvas{position:fixed; inset:0; pointer-events:none; z-index:50;}
#speedlines{position:fixed; inset:0; pointer-events:none; z-index:40; opacity:0;
  background:repeating-conic-gradient(from 0deg at 50% 50%, rgba(255,255,255,.09) 0deg 1.2deg, transparent 1.2deg 9deg); transition:opacity .3s;}
body.rush #speedlines{opacity:1; animation:spin 1.4s linear infinite;}
@keyframes spin{to{transform:rotate(9deg) scale(1.06);}}
body.shake #app{animation:bodyshake .42s;}
@keyframes bodyshake{0%,100%{transform:translate(0,0);}
  20%{transform:translate(calc(var(--amp)*-9px),calc(var(--amp)*4px)) rotate(calc(var(--amp)*-.3deg));}
  40%{transform:translate(calc(var(--amp)*8px),calc(var(--amp)*-5px));}
  60%{transform:translate(calc(var(--amp)*-5px),calc(var(--amp)*3px));}
  80%{transform:translate(calc(var(--amp)*3px),calc(var(--amp)*-2px));}}
body.impact #app{filter:invert(1) hue-rotate(180deg) contrast(1.4);}
.floater{position:fixed; z-index:60; pointer-events:none; font-weight:900; font-size:22px; white-space:nowrap;
  text-shadow:0 2px 6px rgba(0,0,0,.7); animation:floatup 1.2s ease-out forwards;}
@keyframes floatup{from{opacity:1; transform:translate(-50%,0) scale(.7);}30%{transform:translate(-50%,-18px) scale(1.2);}to{opacity:0; transform:translate(-50%,-70px) scale(1);}}
#comboBurst{position:fixed; left:50%; top:34%; transform:translate(-50%,-50%); z-index:61; pointer-events:none; font-weight:900;
  font-size:60px; letter-spacing:2px; opacity:0; color:var(--accent); text-shadow:0 0 24px rgba(255,211,42,.9), 0 4px 0 #7a5c00; font-style:italic; white-space:nowrap;}
#comboBurst.go{animation:comboAnim .9s ease-out;}
@keyframes comboAnim{0%{opacity:0; transform:translate(-50%,-50%) scale(3) rotate(-8deg);}25%{opacity:1; transform:translate(-50%,-50%) scale(1) rotate(2deg);}
  80%{opacity:1;}100%{opacity:0; transform:translate(-50%,-50%) scale(1.1);}}
#onoma{position:fixed; left:60%; top:38%; z-index:62; pointer-events:none; display:flex; flex-direction:column; align-items:center; opacity:0;}
#onoma .jp{font-size:clamp(48px,7vw,92px); font-weight:900; font-style:italic; color:#fff; -webkit-text-stroke:4px #0b0d20; paint-order:stroke fill;
  text-shadow:6px 6px 0 var(--oc,#ff4757); line-height:1; font-family:"Yu Gothic","Hiragino Sans","Meiryo",sans-serif;}
#onoma .en{font-size:15px; font-weight:900; letter-spacing:4px; color:var(--oc); background:#0b0d20; padding:1px 8px; margin-top:4px; transform:rotate(-4deg);}
#onoma.go{animation:onoIn .95s cubic-bezier(.2,1.8,.4,1) forwards;}
@keyframes onoIn{0%{opacity:0; transform:scale(2.4) rotate(-14deg);}18%{opacity:1; transform:scale(1) rotate(var(--rot,-6deg));}
  75%{opacity:1; transform:scale(1.05) rotate(var(--rot,-6deg));}100%{opacity:0; transform:scale(1.15) translateY(-20px) rotate(var(--rot,-6deg));}}
.ring{position:fixed; z-index:58; pointer-events:none; width:20px; height:20px; margin:-10px 0 0 -10px; border-radius:50%;
  border:4px solid var(--rc,#2ed573); animation:ringOut .6s ease-out forwards;}
@keyframes ringOut{to{transform:scale(9); opacity:0; border-width:1px;}}
.modalveil{position:fixed; inset:0; background:rgba(5,6,18,.8); z-index:100; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(3px);}
.modal{background:var(--panel); border:2px solid var(--char); border-radius:18px; max-width:min(860px,94vw); max-height:88vh; overflow:auto;
  padding:22px 26px; box-shadow:0 20px 60px rgba(0,0,0,.6), 0 0 40px var(--charA); animation:popin .35s cubic-bezier(.2,1.8,.4,1);}
.modal h2{margin:0 0 10px; letter-spacing:2px; font-style:italic;}
.modal pre{background:#0d1029; border:1px solid var(--cardline); border-radius:10px; padding:12px; font-size:12px; overflow:auto;
  user-select:text; -webkit-user-select:text; white-space:pre-wrap;}
.modal .btnrow{display:flex; gap:10px; justify-content:flex-end; margin-top:14px; flex-wrap:wrap;}
.pbtn{border:none; border-radius:12px; padding:13px 24px; font-weight:900; cursor:pointer; font-size:16px; letter-spacing:1px; font-style:italic; transition:transform .08s;}
.pbtn:hover{transform:translateY(-2px) scale(1.04);}
.pbtn.gold{background:linear-gradient(135deg,#ffd32a,#ff9f2a); color:#1a1206; box-shadow:0 5px 0 #9c6c00;}
.pbtn.ghost{background:var(--panel2); color:var(--ink); border:1px solid var(--cardline);}
.pbtn.danger{background:linear-gradient(135deg,#ff4757,#c0392b); color:#fff; box-shadow:0 5px 0 #7a1d16;}
#ruleReveal{font-size:clamp(15px,2.4vw,22px); line-height:1.5; background:#0d1029; border:2px solid var(--accent); border-radius:14px;
  padding:16px 20px; margin:12px 0; box-shadow:0 0 30px rgba(255,211,42,.3); min-height:3em;}
#wipe{position:fixed; inset:-10%; z-index:400; pointer-events:none; transform:translateX(-130%) skewX(-12deg);
  background:linear-gradient(90deg, #0b0d20 0 40%, var(--char) 40% 70%, #ffd32a 70% 74%, #0b0d20 74%);}
#wipe.go{animation:wipe .9s cubic-bezier(.7,0,.3,1) forwards;}
@keyframes wipe{0%{transform:translateX(-130%) skewX(-12deg);}45%,55%{transform:translateX(0) skewX(-12deg);}100%{transform:translateX(130%) skewX(-12deg);}}

/* ===== character select ===== */
#charSelect{position:fixed; inset:0; z-index:250; display:flex; flex-direction:column; padding:16px 22px; gap:12px; background:#090b1c; overflow:hidden;}
#csBg{position:absolute; inset:0; z-index:0;
  background:repeating-linear-gradient(-55deg, rgba(255,255,255,.035) 0 26px, transparent 26px 52px),
    radial-gradient(circle at 28% 55%, var(--csA,#3d8bff55), transparent 60%);
  animation:csScroll 5s linear infinite;}
@keyframes csScroll{to{background-position:127px 0, 0 0;}}
#csHeader{position:relative; z-index:1; display:flex; align-items:baseline; gap:16px; flex-wrap:wrap;}
#csTitle{font-size:clamp(26px,4vw,48px); font-weight:900; font-style:italic; letter-spacing:4px;
  background:linear-gradient(90deg,#ffd32a,#ff7f2a,#ff4757); -webkit-background-clip:text; background-clip:text; color:transparent;
  filter:drop-shadow(0 0 16px rgba(255,150,40,.4));}
#csSub{color:var(--dim); letter-spacing:3px; font-size:12px; text-transform:uppercase;}
#csBody{position:relative; z-index:1; flex:1; min-height:0; display:grid; grid-template-columns:minmax(320px,1.15fr) minmax(0,1fr); gap:18px;}
#csShowcase{position:relative; border-radius:20px; overflow:hidden; border:3px solid var(--csC,#3d8bff);
  box-shadow:0 0 40px var(--csA); background:radial-gradient(circle at 30% 85%, var(--csA), transparent 65%), #10132e; transition:border-color .2s;}
#csBigName{position:absolute; left:-6px; top:2px; font-size:clamp(56px,9vw,130px); font-weight:900; font-style:italic; color:transparent;
  -webkit-text-stroke:2px var(--csC); opacity:.28; white-space:nowrap; letter-spacing:4px; line-height:1;}
#csAvatarMotion{position:absolute; left:0; width:56%; top:44px; bottom:0; display:flex; align-items:flex-end; justify-content:center;}
#csAvatar{height:100%; aspect-ratio:200/264; max-width:100%;}
#csInfo{position:absolute; right:16px; top:20px; bottom:16px; width:43%; display:flex; flex-direction:column; gap:7px; justify-content:center;}
#csName{font-size:clamp(20px,2.5vw,34px); font-weight:900; font-style:italic; line-height:1.05;}
#csTitleC{font-size:13px; color:var(--csC); font-weight:900; letter-spacing:2px; text-transform:uppercase;}
#csEra{font-size:11px; color:var(--dim); letter-spacing:1px;}
.csStat{display:grid; grid-template-columns:74px 1fr; align-items:center; gap:6px; font-size:10px; letter-spacing:1px; color:var(--dim); text-transform:uppercase;}
.csBar{height:9px; background:#22264f; border-radius:5px; overflow:hidden;}
.csBar i{display:block; height:100%; width:0; background:linear-gradient(90deg,var(--csC),#fff); border-radius:5px; transition:width .55s cubic-bezier(.3,1.5,.5,1);}
#csQuote{background:#fff; color:#141737; font-weight:800; font-size:14px; border-radius:14px; border:3px solid #0b0d20; padding:10px 12px;
  box-shadow:0 4px 0 #0b0d20; min-height:60px; position:relative; margin-top:6px;}
#csQuote::before{content:""; position:absolute; left:-17px; top:18px; border:8px solid transparent; border-right-color:#0b0d20;}
#csQuote small{display:block; font-size:9px; letter-spacing:2px; color:#8b90c0; margin-bottom:2px;}
#csRoster{display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10px; align-content:center;}
.cstile{position:relative; border-radius:14px; overflow:hidden; cursor:pointer; border:3px solid #2a2f5e; aspect-ratio:3/4;
  background:linear-gradient(160deg, var(--tc), #10132e 78%); transition:transform .12s, border-color .12s, box-shadow .12s;}
.cstile svg{position:absolute; inset:0; width:100%; height:100%;}
.cstile .tn{position:absolute; left:0; right:0; bottom:0; background:rgba(8,10,26,.88); font-size:10px; font-weight:900;
  letter-spacing:1.5px; text-align:center; padding:4px 2px; font-style:italic;}
.cstile:hover{transform:translateY(-5px) scale(1.06); border-color:#fff; z-index:2;}
.cstile.sel{border-color:var(--tc); box-shadow:0 0 0 3px #fff, 0 0 26px var(--tc); transform:scale(1.07); z-index:2;}
.cstile.sel::after{content:"P1"; position:absolute; top:4px; left:4px; font-size:10px; font-weight:900; background:var(--accent);
  color:#1a1206; padding:1px 5px; border-radius:4px; animation:btnpulse .8s infinite;}
#csFooter{position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; gap:12px;}
#csHint{color:var(--dim); font-size:12px; letter-spacing:2px;}
#csGo{font-size:22px; font-weight:900; letter-spacing:3px; padding:14px 34px; border:none; border-radius:14px; cursor:pointer; color:#1a1206;
  background:linear-gradient(135deg,#ffd32a,#ff9f2a); box-shadow:0 6px 0 #9c6c00, 0 0 30px rgba(255,180,40,.45); animation:btnpulse 1.3s infinite; font-style:italic;}
#csGo:active{transform:translateY(5px); box-shadow:0 1px 0 #9c6c00;}
#csFlash{position:absolute; inset:0; z-index:5; pointer-events:none; background:#fff; opacity:0;}
#csFlash.go{animation:flashout .35s ease-out;}
@keyframes flashout{0%{opacity:.9;}100%{opacity:0;}}

/* ===== INTRO ===== */
#intro{position:fixed; inset:0; z-index:300; background:#04050e; overflow:hidden;}
#intro.fadeout{transition:opacity .6s ease; opacity:0;}
#introCanvas{position:absolute; inset:0; width:100%; height:100%;}
#introGate{position:absolute; inset:0; z-index:4; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18px; cursor:pointer; text-align:center;}
#introGate .gatelogo{font-size:76px; animation:gearspin 9s linear infinite; opacity:.6; filter:drop-shadow(0 0 18px rgba(255,211,42,.45));}
#introGate .gatetitle{font-size:clamp(26px,5vw,46px); font-weight:900; letter-spacing:8px; color:#3c4382; font-style:italic;}
#introGate .gatehint{font-size:14px; letter-spacing:5px; color:var(--accent); animation:hintpulse 1.6s ease-in-out infinite;}
#introGate .gatesub{font-size:11px; letter-spacing:3px; color:#4a5090;}
@keyframes hintpulse{0%,100%{opacity:.35;}50%{opacity:1; text-shadow:0 0 16px rgba(255,211,42,.8);}}
#introStage{position:absolute; inset:0; z-index:2;}
#introStage.shk{animation:bodyshake .4s;}
#introSkip{position:absolute; top:16px; right:20px; z-index:20; background:rgba(0,0,0,.4); border:1px solid #2a2f5e;
  color:var(--dim); border-radius:8px; padding:6px 12px; font-size:11px; letter-spacing:2px; cursor:pointer;}
#introSkip:hover{color:var(--ink); border-color:var(--dim);}
#kanji{position:absolute; left:50%; top:50%; transform:translate(-50%,-50%) scale(.8); font-size:min(72vh,72vw); font-weight:900; line-height:1;
  color:transparent; -webkit-text-stroke:3px rgba(255,71,87,.4); opacity:0; font-family:"Yu Mincho","Hiragino Mincho ProN","MS Mincho",serif;}
#kanji.show{transition:opacity 1.2s, transform 5s ease-out; opacity:1; transform:translate(-50%,-50%) scale(1.06);}
#kanji.hide{transition:opacity .25s; opacity:0;}
.slam{position:absolute; left:0; right:0; top:50%; text-align:center; font-weight:900; font-size:clamp(36px,8.5vw,112px); letter-spacing:6px;
  color:#fff; opacity:0; text-shadow:4px 0 #ff2a6d, -4px 0 #05d9e8; transform:translateY(-50%) skewX(-6deg); font-style:italic; padding:0 10px;}
.slam.small{font-size:clamp(26px,5.5vw,70px);}
.slam.go{animation:slamIn .32s cubic-bezier(.2,1.9,.4,1) forwards, glitch .3s steps(3) .32s 2;}
.slam.out{opacity:1; animation:slamOut .22s ease-in forwards;}
@keyframes slamIn{0%{opacity:0; transform:translateY(-50%) scale(3.2) skewX(-14deg); filter:blur(10px);}100%{opacity:1; transform:translateY(-50%) scale(1) skewX(-6deg); filter:blur(0);}}
@keyframes glitch{0%{text-shadow:7px 0 #ff2a6d,-7px 0 #05d9e8; clip-path:inset(0 0 55% 0);}33%{text-shadow:-6px 2px #ff2a6d,6px -2px #05d9e8; clip-path:inset(40% 0 0 0);}66%,100%{clip-path:inset(0);}}
@keyframes slamOut{from{opacity:1;} to{opacity:0; transform:translateY(-50%) scale(.7) skewX(-6deg); filter:blur(6px);}}
#formula{position:absolute; left:4%; width:92%; top:50%; transform:translateY(-50%); opacity:0;}
#formula.show{opacity:1;}
#formula text{font-size:70px; font-weight:800; fill:transparent; stroke:#ffd32a; stroke-width:1.6; stroke-dasharray:1100; stroke-dashoffset:1100;
  font-family:"Cambria Math","Times New Roman",serif; font-style:italic;}
#formula.show text{animation:drawText 1.7s ease forwards;}
@keyframes drawText{70%{stroke-dashoffset:0; fill:transparent;}100%{stroke-dashoffset:0; fill:#fff4c2;}}
#formulaSub{position:absolute; left:0; right:0; top:64%; text-align:center; color:var(--dim); letter-spacing:8px; font-size:14px; opacity:0;}
#formula.show + #formulaSub{transition:opacity .6s .9s; opacity:1;}
#montage{position:absolute; inset:0; opacity:0; overflow:hidden;}
#montage.on{opacity:1;}
#mBg{position:absolute; inset:-20%; background:repeating-linear-gradient(-60deg, var(--mc) 0 40px, #0b0d20 40px 80px); opacity:.32;}
#mBand{position:absolute; left:-10%; right:-10%; top:24%; height:54%; background:linear-gradient(90deg, #0b0d20, var(--mc) 55%, #0b0d20); transform:skewY(-8deg); opacity:.85;}
#mChar{position:absolute; right:7%; bottom:-2%; height:94%; aspect-ratio:200/264;}
#mName{position:absolute; left:5%; top:36%; font-size:clamp(40px,9vw,124px); font-weight:900; font-style:italic; color:#fff;
  -webkit-text-stroke:3px #0b0d20; paint-order:stroke fill; text-shadow:8px 8px 0 #0b0d20; letter-spacing:2px; transform:skewY(-8deg); white-space:nowrap;}
#mTitle{position:absolute; left:6%; top:calc(36% + clamp(52px,10vw,136px)); font-size:clamp(13px,2vw,22px); font-weight:900; letter-spacing:6px;
  color:#0b0d20; background:#fff; padding:2px 12px; transform:skewY(-8deg); text-transform:uppercase;}
#mNum{position:absolute; left:5%; top:24%; font-size:16px; font-weight:900; letter-spacing:4px; color:var(--mc); transform:skewY(-8deg);}
#montage.cut #mChar{animation:mCharIn .38s cubic-bezier(.2,1.4,.4,1);}
#montage.cut #mName{animation:mNameIn .38s cubic-bezier(.2,1.4,.4,1);}
#montage.cut #mTitle, #montage.cut #mNum{animation:mNameIn .44s cubic-bezier(.2,1.4,.4,1);}
#montage.cut #mBg{animation:mBgIn .4s linear;}
@keyframes mCharIn{0%{transform:translateX(60%) scale(1.25); opacity:0;}100%{transform:none; opacity:1;}}
@keyframes mNameIn{0%{transform:translateX(-80%) skewY(-8deg); opacity:0;}100%{transform:skewY(-8deg); opacity:1;}}
@keyframes mBgIn{from{background-position:0 0;}to{background-position:180px 0;}}
#cutflash, #whiteflash{position:absolute; inset:0; background:#fff; opacity:0; pointer-events:none; z-index:6;}
#cutflash.go{animation:flashout .18s ease-out;}
#whiteflash.go{animation:flashout .6s ease-out;}
.introGear{position:absolute; opacity:0; transition:opacity .5s;}
.introGear.show{opacity:.25; animation:gearspin 2.2s linear infinite;}
#introGearL{left:-150px; top:50%; margin-top:-200px;}
#introGearR{right:-130px; top:50%; margin-top:-160px; animation-direction:reverse !important;}
#introLogo{position:absolute; left:0; right:0; top:34%; text-align:center; opacity:0; z-index:3;
  font-size:clamp(40px,9.5vw,118px); font-weight:900; letter-spacing:6px; font-style:italic;
  background:linear-gradient(90deg,#ffd32a,#ff7f2a,#ff4757); -webkit-background-clip:text; background-clip:text; color:transparent;
  filter:drop-shadow(0 0 30px rgba(255,150,40,.55));}
#introLogo.show{animation:logoslam .7s cubic-bezier(.2,1.6,.4,1) forwards, logoGlow 1.6s ease-in-out .7s infinite;}
@keyframes logoslam{0%{opacity:0; transform:scale(4.5) rotate(-8deg); filter:blur(14px);}
  55%{opacity:1; transform:scale(.93) rotate(1.5deg); filter:blur(0) drop-shadow(0 0 30px rgba(255,150,40,.5));}100%{opacity:1; transform:scale(1);}}
#introTag{position:absolute; left:0; right:0; top:calc(34% + clamp(60px,12vw,150px)); text-align:center; z-index:3;
  font-size:clamp(13px,2vw,20px); font-weight:800; letter-spacing:9px; color:#cdd3ff; min-height:1.4em;}
.iring{position:absolute; left:50%; top:44%; width:40px; height:40px; margin:-20px; border-radius:50%; border:6px solid #ffd32a; opacity:0; z-index:2;}
.iring.go{animation:iring 1.1s ease-out forwards;}
@keyframes iring{0%{opacity:1; transform:scale(.2);}100%{opacity:0; transform:scale(42); border-width:1px;}}
#flare{position:absolute; top:0; bottom:0; width:28%; left:-40%; z-index:4; pointer-events:none;
  background:linear-gradient(100deg, transparent, rgba(255,255,255,.8), transparent); transform:skewX(-20deg); opacity:0;}
#flare.go{animation:flare .9s ease-in-out;}
@keyframes flare{0%{left:-40%; opacity:1;}100%{left:125%; opacity:1;}}
#introPress{position:absolute; left:0; right:0; bottom:9%; text-align:center; z-index:3; font-size:13px; letter-spacing:6px;
  color:var(--accent); opacity:0;}
#introPress.show{opacity:1; animation:hintpulse 1s ease-in-out infinite;}


/* ===== DANSE MODE ===== */
#danse{position:fixed; inset:0; z-index:45; background:#070818; overflow:hidden; --pulse:0;}
#dBg{position:absolute; inset:0;
  background:radial-gradient(circle at 50% 55%, rgba(140,100,255,calc(.10 + var(--pulse)*.28)), transparent 62%),
    repeating-linear-gradient(90deg, rgba(255,255,255,.028) 0 2px, transparent 2px 64px),
    repeating-linear-gradient(0deg, rgba(255,255,255,.02) 0 2px, transparent 2px 64px),
    linear-gradient(160deg,#0b0d20,#170b30);}
#dBg.down{animation:dDown .35s ease-out;}
@keyframes dDown{0%{filter:brightness(1.7) saturate(1.4);}100%{filter:none;}}
#dEq{position:absolute; left:0; bottom:0; width:100%; height:42%; opacity:.33; pointer-events:none;}
#danse .dpanel{background:rgba(24,28,64,.88); border:1px solid var(--cardline); border-radius:16px;}
/* setup */
#dSetup{position:absolute; inset:0; display:flex; flex-direction:column; gap:12px; padding:16px 22px; overflow:auto;}
#dsHead{display:flex; align-items:baseline; gap:16px; flex-wrap:wrap;}
#dsTitle{font-size:clamp(28px,4vw,50px); font-weight:900; font-style:italic; letter-spacing:4px;
  background:linear-gradient(90deg,#a55eea,#ff4757,#ffd32a); -webkit-background-clip:text; background-clip:text; color:transparent;
  filter:drop-shadow(0 0 16px rgba(165,94,234,.5)); animation:logoGlow 2.4s ease-in-out infinite;}
#dsSub{color:var(--dim); letter-spacing:3px; font-size:12px; text-transform:uppercase; flex:1;}
#dsGrid{display:grid; grid-template-columns:1.1fr 1fr 1.1fr; gap:14px; flex:1; min-height:0;}
.dsCol{padding:14px; display:flex; flex-direction:column; gap:10px; min-height:0; overflow:auto;}
.dsLbl{font-size:12px; letter-spacing:3px; color:var(--accent); font-weight:900;}
.dsTrack{padding:10px 12px; border:2px solid var(--cardline); border-radius:12px; cursor:pointer; background:#141737; transition:transform .08s;}
.dsTrack:hover{transform:translateX(4px); border-color:#fff6;}
.dsTrack.sel{border-color:var(--accent); box-shadow:0 0 16px rgba(255,211,42,.35);}
.dsTrack b{display:block; font-size:15px;} .dsTrack small{color:var(--dim); font-size:11px;}
#dsDrop{display:block; border:2px dashed #3a3f75; border-radius:12px; padding:16px; text-align:center; color:var(--dim); cursor:pointer; font-size:13px;}
#dsDrop.over{border-color:var(--accent); color:var(--ink); background:rgba(255,211,42,.07);}
#dsTrackInfo{font-size:12px; color:var(--dim); line-height:1.5; min-height:3em;}
#dsTrackInfo b{color:var(--ink);}
.dsDiff{position:relative; padding:12px 14px; border-radius:14px; border:3px solid #2a2f5e; cursor:pointer; overflow:hidden;
  background:linear-gradient(120deg, var(--dc), #141737 70%); transition:transform .1s;}
.dsDiff:hover{transform:scale(1.03);}
.dsDiff.sel{border-color:#fff; box-shadow:0 0 0 2px var(--dc), 0 0 26px var(--dc); transform:scale(1.03);}
.dsDiff b{font-size:26px; font-weight:900; font-style:italic; letter-spacing:3px;}
.dsDiff p{margin:4px 0 0; font-size:12px; color:#dfe3ff;}
.dsDiff .stars{position:absolute; right:12px; top:12px; font-size:16px; letter-spacing:2px;}
.dsToggle{display:flex; gap:8px;}
.dsToggle button{flex:1; padding:8px; border-radius:10px; border:2px solid var(--cardline); background:#141737; color:var(--ink); font-weight:900; letter-spacing:2px; cursor:pointer;}
.dsToggle button.sel{border-color:var(--accent); background:#33307a; box-shadow:0 0 12px rgba(255,211,42,.3);}
#dsKeyViz{display:grid; gap:6px; justify-content:center; padding:6px 0;}
#dsKeyViz.diamond{grid-template-columns:repeat(3,64px); grid-template-rows:repeat(3,54px);}
#dsKeyViz.row{grid-template-columns:repeat(5,60px);}
.kcap{border-radius:10px; border:3px solid var(--kc); background:#141737; display:flex; flex-direction:column; align-items:center; justify-content:center; box-shadow:0 4px 0 #0b0d20;}
.kcap b{font-size:18px;} .kcap span{font-size:11px; font-weight:900; color:var(--kc);}
#dsKeyHint{font-size:11px; color:var(--dim); text-align:center; letter-spacing:1px;}
.dsRow{display:flex; align-items:center; gap:10px; font-size:12px; color:var(--dim);}
.dsRow input[type=range]{flex:1; accent-color:#a55eea;}
.dsRow b{color:var(--ink); min-width:56px; text-align:right; font-variant-numeric:tabular-nums;}
#dsFoot{display:flex; align-items:center; gap:14px;}
#dsStatus{flex:1; color:var(--dim); font-size:13px; letter-spacing:1px;}
#dsStatus b{color:var(--accent);}
#dsGo{font-size:26px; font-weight:900; letter-spacing:3px; padding:14px 40px; border:none; border-radius:14px; cursor:pointer; color:#fff; font-style:italic;
  background:linear-gradient(135deg,#a55eea,#ff4757); box-shadow:0 6px 0 #5a1d6e, 0 0 30px rgba(165,94,234,.5); animation:btnpulse 1.3s infinite;}
#dsGo:disabled{filter:grayscale(1); opacity:.5; cursor:wait; animation:none;}
/* play */
#dPlay{position:absolute; inset:0; display:grid; grid-template-rows:auto minmax(0,1fr) auto; gap:8px; padding:10px 14px;}
body.shake #dPlay{animation:bodyshake .42s;}
body.impact #dPlay{filter:invert(1) hue-rotate(180deg) contrast(1.4);}
#dHud{display:flex; gap:8px; align-items:center; min-width:0;}
#dTrackName{font-weight:900; font-style:italic; letter-spacing:1px; font-size:14px; max-width:230px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
#dTrackName small{display:block; font-size:10px; color:var(--dim); letter-spacing:2px; font-style:normal;}
.dStat{padding:3px 12px; display:flex; flex-direction:column; align-items:center; min-width:74px;}
.dStat span{font-size:9px; letter-spacing:2px; color:var(--dim); white-space:nowrap;}
.dStat b{font-size:19px; font-variant-numeric:tabular-nums; line-height:1.15;}
.dStat.big b{font-size:28px; color:var(--accent); text-shadow:0 0 12px rgba(255,211,42,.5);}
.dStat.fire{border-color:#ff7f2a; animation:fire .4s ease-in-out infinite alternate;}
.dStat.fire b{color:var(--accent);}
#dProgress{flex:1; height:12px; background:#1f2450; border-radius:6px; position:relative; overflow:hidden; min-width:80px; border:1px solid var(--cardline);}
#dProgFill{height:100%; width:0; background:linear-gradient(90deg,var(--char),#ffd32a);}
.dMark{position:absolute; top:0; bottom:0; width:4px; margin-left:-2px; background:var(--mc); box-shadow:0 0 6px var(--mc);}
#dMain{display:grid; grid-template-columns:220px minmax(0,1fr); gap:10px; min-height:0;}
#dSide{display:flex; flex-direction:column; gap:8px; min-height:0;}
#dStage{position:relative; flex:1; min-height:120px; border-radius:16px; border:2px solid var(--char); overflow:hidden;
  background:radial-gradient(circle at 50% 85%, var(--charA), transparent 65%), #12153a; box-shadow:0 0 calc(10px + var(--pulse)*24px) var(--charA);}
#dAvatarMotion{position:absolute; left:0; right:0; bottom:0; top:30px; display:flex; justify-content:center; align-items:flex-end;
  transform:translateY(calc(var(--pulse)*-5px)) scale(calc(1 + var(--pulse)*.02)); transform-origin:50% 100%;}
#dAvatar{height:100%; aspect-ratio:200/264; max-width:100%;}
#dAvatar svg{width:100%; height:100%; display:block; overflow:visible;}
#dBubble{position:absolute; top:6px; left:8px; right:8px; z-index:3; background:#fff; color:#141737; font-weight:800; font-size:12px; line-height:1.25;
  padding:6px 9px; border-radius:12px; border:3px solid #0b0d20; box-shadow:0 3px 0 #0b0d20;}
#dBubble.pop{animation:popin .3s cubic-bezier(.2,2,.4,1);}
#dJudge{height:118px; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:4px;}
#dJudge .jt{font-size:30px; font-weight:900; font-style:italic; letter-spacing:2px; line-height:1;}
#dJudge .jp{font-size:13px; font-weight:900; margin-top:4px;}
#dJudge .js{font-size:11px; color:var(--dim); margin-top:2px;}
#dJudge .jpts{font-size:17px; font-weight:900; color:var(--accent); margin-top:3px;}
#dJudge.pop .jt{animation:popin .25s cubic-bezier(.2,2,.4,1);}
#dTiming{height:26px; position:relative;}
#dTiming .bar{position:absolute; left:6px; right:6px; top:11px; height:4px; border-radius:2px;
  background:linear-gradient(90deg,#a55eea,#3d8bff,#2ed573,#ffd32a,#2ed573,#3d8bff,#a55eea);}
#dTiming .tk{position:absolute; top:5px; width:3px; height:16px; margin-left:-1.5px; background:#fff; border-radius:2px; animation:tkfade 2.5s forwards;}
@keyframes tkfade{to{opacity:0;}}
#dLanes{display:flex; flex-direction:column; gap:8px; min-height:0;}
.lane{flex:1; min-height:0; display:flex; flex-direction:column; border-radius:16px; border:2px solid var(--lc); overflow:hidden;
  background:linear-gradient(90deg, rgba(10,12,30,.92), rgba(20,23,55,.55)); box-shadow:0 0 calc(8px + var(--pulse)*20px) var(--lcA);}
.lane.flash{animation:laneFlash .8s ease-out;}
@keyframes laneFlash{0%{background:var(--lc);}100%{}}
.laneHead{display:flex; gap:10px; align-items:center; padding:4px 12px; font-size:11px; background:rgba(0,0,0,.25);}
.laneHead b{color:var(--lc); letter-spacing:2px; font-style:italic; font-size:12px;}
.laneHead .lr{color:var(--dim); letter-spacing:1px;}
.pips{display:flex; gap:3px;}
.pip{width:9px; height:9px; border-radius:50%; background:#2a2f5e; transition:background .15s;}
.pip.on{background:var(--lc); box-shadow:0 0 6px var(--lc);}
.laneStatus{margin-left:auto; color:var(--accent); font-weight:900; letter-spacing:1px;}
.laneStatus.blink{animation:hintpulse .8s ease-in-out infinite;}
.laneBody{position:relative; flex:1; min-height:0; overflow:hidden;}
.laneBody::after{content:""; position:absolute; left:var(--fx); right:0; top:50%; height:2px; background:linear-gradient(90deg,var(--lc),transparent); opacity:.35;}
.chain{position:absolute; left:0; width:calc(var(--fx) - var(--fw)/2 - 10px); top:50%; transform:translateY(-62%); display:flex; flex-direction:row-reverse; gap:4px; overflow:hidden; align-items:center;}
.chain .ch{flex:0 0 auto; animation:chIn .35s cubic-bezier(.2,1.8,.4,1); filter:drop-shadow(0 2px 6px rgba(0,0,0,.5));}
.chain .ch:first-child{filter:drop-shadow(0 0 8px var(--lc));}
@keyframes chIn{0%{transform:translateX(60px) scale(1.4); opacity:0;}100%{transform:none; opacity:1;}}
.chainLbl{position:absolute; left:8px; top:4px; font-size:9px; letter-spacing:2px; color:var(--dim);}
.rejs{position:absolute; left:0; width:calc(var(--fx) - var(--fw)/2 - 10px); bottom:3px; display:flex; flex-direction:row-reverse; gap:3px; overflow:hidden; opacity:.75;}
.rejs .rj{position:relative; flex:0 0 auto;}
.rejs .rj::after{content:"✕"; position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:var(--ko); font-weight:900; font-size:14px;}
.frame{position:absolute; top:50%; left:var(--fx); width:calc(var(--fw) + 14px); height:calc(var(--fw)*1.3 + 14px); border-radius:16px; z-index:2; pointer-events:none;
  transform:translate(-50%,-50%) scale(calc(1 + var(--pulse)*.07)); border:4px solid var(--lc);
  box-shadow:0 0 calc(12px + var(--pulse)*30px) var(--lc), inset 0 0 calc(10px + var(--pulse)*20px) var(--lcA);}
.frame::before, .frame::after{content:"▶"; position:absolute; top:50%; transform:translateY(-50%); left:-22px; color:var(--lc); font-size:16px;}
.frame::after{content:"◀"; left:auto; right:-22px;}
.frame.hitflash{animation:frHit .3s ease-out;}
@keyframes frHit{0%{background:var(--fc,rgba(255,255,255,.5));}100%{background:transparent;}}
.dcard{position:absolute; top:50%; left:0; will-change:transform; z-index:1;}
.dcard .dci{position:relative; filter:drop-shadow(0 4px 10px rgba(0,0,0,.55));}
.dcard .dci svg{display:block;}
.dcard.fresh .dci::before{content:"NEW RULE!"; position:absolute; left:50%; top:-16px; transform:translateX(-50%); font-size:10px; font-weight:900;
  letter-spacing:1px; padding:1px 6px; border-radius:6px; background:var(--accent); color:#1a1206; white-space:nowrap; animation:btnpulse .5s infinite;}
.dcard .verd{position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); font-size:38px; font-weight:900; z-index:2;
  -webkit-text-stroke:2px #0b0d20; paint-order:stroke fill;}
.dcard.acc .dci{animation:dAcc .42s ease-in forwards;}
.dcard.rej .dci{animation:dRej .6s ease-in forwards;}
.dcard.miss .dci svg{filter:grayscale(1) brightness(.55);}
@keyframes dAcc{0%{transform:scale(1.2); filter:drop-shadow(0 0 18px #2ed573);}40%{transform:scale(1.28); filter:drop-shadow(0 0 22px #2ed573);}100%{transform:translateX(-90px) scale(.45); opacity:0;}}
@keyframes dRej{0%{transform:scale(1.15);}25%{transform:scale(1.15) rotate(-6deg);}100%{transform:translateY(160px) rotate(28deg) scale(.7); opacity:0;}}
#dKeys{display:flex; justify-content:center; gap:12px; align-items:flex-end;}
.dkey{width:112px; padding:6px 8px; border-radius:14px; background:#141737; border:3px solid var(--kc); text-align:center;
  box-shadow:0 5px 0 #0b0d20; transition:transform .05s, box-shadow .05s;}
.dkey .kc{font-size:20px; font-weight:900; line-height:1.1;}
.dkey .kc small{font-size:11px; color:var(--dim); margin-left:4px;}
.dkey .kp{font-size:16px; font-weight:900; color:var(--kc);}
.dkey .kn{font-size:9px; color:var(--dim); letter-spacing:1px; text-transform:uppercase;}
.dkey.hit{transform:translateY(4px) scale(.95); box-shadow:0 1px 0 #0b0d20, 0 0 26px var(--kc); background:var(--kc);}
.dkey.hit .kc, .dkey.hit .kp, .dkey.hit .kn, .dkey.hit small{color:#0b0d20;}
#dBanner{position:absolute; left:50%; top:70px; transform:translateX(-50%); width:min(860px,78vw); z-index:7; text-align:center;
  background:rgba(11,13,32,.95); border:3px solid var(--bc,#ffd32a); border-radius:16px; padding:10px 20px; box-shadow:0 0 40px var(--bc);
  animation:bannerIn .5s cubic-bezier(.2,1.6,.4,1);}
#dBanner small{display:block; font-size:11px; letter-spacing:3px; color:var(--bc); font-weight:900;}
#dBannerText{font-size:clamp(14px,1.8vw,20px); font-weight:800; margin-top:4px; line-height:1.35;}
#dBanner.out{animation:bannerOut .4s ease-in forwards;}
@keyframes bannerIn{0%{transform:translate(-50%,-40px) scale(.6); opacity:0;}100%{transform:translateX(-50%); opacity:1;}}
@keyframes bannerOut{to{transform:translate(-50%,-30px) scale(.8); opacity:0;}}
#dCount{position:absolute; left:50%; top:46%; transform:translate(-50%,-50%); font-size:150px; font-weight:900; font-style:italic; color:#fff;
  text-shadow:7px 7px 0 var(--char), 0 0 40px var(--char); pointer-events:none; z-index:8; opacity:0; white-space:nowrap;}
#dCount.go{animation:countPop .85s ease-out;}
@keyframes countPop{0%{opacity:0; transform:translate(-50%,-50%) scale(2.6);}20%{opacity:1; transform:translate(-50%,-50%) scale(1);}80%{opacity:1;}100%{opacity:0; transform:translate(-50%,-50%) scale(.85);}}
#dPause, #dResults{position:absolute; inset:0; z-index:9; display:flex; align-items:center; justify-content:center; background:rgba(5,6,18,.82); backdrop-filter:blur(3px);}
#dPause .modal, #dResults .modal{text-align:center;}
#dResults .grade{font-size:150px; font-weight:900; font-style:italic; line-height:1; animation:logoslam .8s cubic-bezier(.2,1.6,.4,1);
  background:linear-gradient(180deg,#fff,var(--gc)); -webkit-background-clip:text; background-clip:text; color:transparent; filter:drop-shadow(0 0 26px var(--gc));}
.rgrid{display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin:12px 0;}
.rgrid div{background:#0d1029; border:1px solid var(--cardline); border-radius:10px; padding:8px;}
.rgrid span{display:block; font-size:10px; letter-spacing:2px; color:var(--dim);}
.rgrid b{font-size:22px;}
.rrules{text-align:left; max-height:30vh; overflow:auto; font-size:13px; line-height:1.45;}
.rrules div{padding:6px 10px; border-left:4px solid var(--lc); margin:6px 0; background:#0d1029; border-radius:6px;}
.rrules small{color:var(--dim); letter-spacing:1px;}
#csDanse{font-size:16px; font-weight:900; letter-spacing:2px; padding:12px 22px; border:none; border-radius:14px; cursor:pointer; color:#fff; font-style:italic;
  background:linear-gradient(135deg,#a55eea,#ff4757); box-shadow:0 5px 0 #5a1d6e, 0 0 24px rgba(165,94,234,.45);}
#csDanse:active{transform:translateY(4px); box-shadow:0 1px 0 #5a1d6e;}

/* ===== turbo (AI harness) & accessibility ===== */
body.turbo *, body.turbo *::before, body.turbo *::after{animation:none !important; transition:none !important;}
body.turbo #fxCanvas, body.turbo #bgSymbols, body.turbo #gears, body.turbo #speedlines, body.turbo #onoma,
body.turbo .floater, body.turbo .ring, body.turbo #bubble, body.turbo #dBubble, body.turbo #dEq{display:none !important;}
@media (prefers-reduced-motion: reduce){ body.shake #app{animation:none;} body.impact #app{filter:none;} }
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute"><defs id="patternDefs"></defs></svg>
<div id="bgSymbols"></div>
<div id="gears"></div>
<div id="glowFrame"></div>
<div id="speedlines"></div>
<canvas id="fxCanvas"></canvas>
<div id="comboBurst"></div>
<div id="onoma"><span class="jp"></span><span class="en"></span></div>
<div id="wipe"></div>

<!-- Optional music: put intro.mp3 and music.mp3 next to this HTML file -->
<audio id="introMusic" src="intro.mp3" preload="auto"></audio>
<audio id="bgm" src="music.mp3" loop preload="auto"></audio>

<div id="app">
  <div id="hud">
    <div id="logo">ELEUSIS ⚡ ARENA</div>
    <div id="levelMap" title="Level progress — click to jump"></div>
    <div class="hudbox hidden"><span class="lbl">Level</span><span class="val" id="levelName">—</span></div>
    <div class="hudbox" id="brierBox" title="Mean Brier per card: 0 = prophet, 0.25 = coin flip (p=50%), 1 = confidently wrong. LOWER IS BETTER.">
      <span class="lbl">Brier / card</span><span class="val" id="brierVal">—</span></div>
    <div class="hudbox"><span class="lbl">Rank</span><span class="val" id="rankVal">Unranked</span></div>
    <div class="hudbox" id="comboBox" title="Consecutive predictions better than a coin flip">
      <span class="lbl">Combo</span><span class="val" id="comboVal">×0</span><div id="comboMeter"><div id="comboFill"></div></div></div>
    <div class="hudbox"><span class="lbl">Cards</span><span class="val" id="movesVal">0</span></div>
    <div class="spacer"></div>
    <select id="levelSel" title="Level"></select>
    <button class="iconbtn" id="btnDanse" title="Danse mode (rhythm)">♪</button>
    <button class="iconbtn" id="btnChar" title="Change thinker">👤</button>
    <button class="iconbtn" id="btnNew" title="New secret rule (same level)">↻</button>
    <button class="iconbtn" id="btnHelp" title="Help & AI API">❓</button>
    <button class="iconbtn" id="btnSound" title="Sound on/off">🔊</button>
  </div>

  <div id="main">
    <div id="leftPanel">
      <div id="stage">
        <div id="stageBg"></div>
        <div id="avatarMotion" class="rx-idle"><div id="avatar"></div></div>
        <div id="bubble" class="hidden"><span id="bubbleText"></span></div>
        <div id="charTag"><b id="charName">—</b><span id="charTitle"></span></div>
      </div>
      <div id="gaugeBox">
        <svg id="gauge" viewBox="0 0 200 110"></svg>
        <div><div id="gaugeNum">—</div><div id="gaugeRank">Place your first bet</div><div id="gaugeSub">mean Brier · lower is better</div></div>
      </div>
      <div id="charts">
        <div class="chart"><div class="clbl">Brier over time</div><svg id="spark" viewBox="0 0 120 70" preserveAspectRatio="none"></svg></div>
        <div class="chart"><div class="clbl">Calibration</div><svg id="calib" viewBox="0 0 120 70"></svg></div>
      </div>
    </div>
    <div id="timelineWrap">
      <div id="tlLabels"><div>Accepted</div><div>Rejected</div></div>
      <div id="timeline"></div>
      <div id="tlHint">Build an item ↓ · bet your probability · TEST!</div>
    </div>
  </div>

  <div id="builder">
    <div id="preview"><div id="previewCard"></div><div id="previewLbl">your item</div></div>
    <div id="dims"></div>
    <div id="betPanel">
      <div id="betHead">🎲 P(accepted) = <b id="betVal">50%</b></div>
      <input type="range" id="betSlider" min="0" max="100" value="50" aria-label="Probability the item is accepted">
      <div id="betScale"><span>✕ SURE</span><span>NO IDEA</span><span>SURE ✔</span></div>
      <div id="betQuick"><button data-v="5">5%</button><button data-v="25">25%</button><button data-v="50">50%</button><button data-v="75">75%</button><button data-v="95">95%</button></div>
      <div id="betVerbal">No idea</div>
      <div id="betStakes">if ✔ brier <b>0.25</b> · if ✕ brier <b>0.25</b></div>
    </div>
    <div id="actions">
      <button id="btnTest">TEST!<small>ENTER</small></button>
      <button id="btnReveal">👁 REVEAL THE RULE<small>ONE SHOT ONLY!</small></button>
    </div>
  </div>

  <div id="ticker"><span class="tlbl">LOG</span><div id="tickerItems"></div></div>
</div>


<div id="danse" class="hidden">
  <div id="dBg"></div>
  <canvas id="dEq"></canvas>
  <div id="dSetup">
    <div id="dsHead"><div id="dsTitle">DANSE MODE ♪</div><div id="dsSub">The cards ride the beat · bet as they hit the frame · crack the rule mid-song</div>
      <button class="pbtn ghost" id="dsBack">← ARENA</button></div>
    <div id="dsGrid">
      <div class="dsCol dpanel">
        <div class="dsLbl">1 · TRACK</div>
        <div id="dsTracks"></div>
        <label id="dsDrop">🎵 Drop any audio file here, or <u>browse…</u><input type="file" id="dsFile" accept="audio/*" hidden></label>
        <div id="dsTrackInfo"></div>
      </div>
      <div class="dsCol dpanel">
        <div class="dsLbl">2 · DIFFICULTY</div>
        <div id="dsDiffs"></div>
      </div>
      <div class="dsCol dpanel">
        <div class="dsLbl">3 · CONTROLS</div>
        <div class="dsToggle" id="dsLayouts"><button data-l="diamond">DIAMOND</button><button data-l="row">ROW</button></div>
        <div id="dsKeyViz"></div>
        <div id="dsKeyHint"></div>
        <div class="dsRow">Note speed <input type="range" id="dsSpeed" min="60" max="160" step="5" value="100"><b id="dsSpeedV">1.00×</b></div>
        <div class="dsRow">Audio offset <input type="range" id="dsOffset" min="-200" max="200" step="5" value="0"><b id="dsOffsetV">0 ms</b></div>
        <div class="dsRow"><label><input type="checkbox" id="dsHitSfx" checked> Hit sounds</label></div>
      </div>
    </div>
    <div id="dsFoot"><div id="dsStatus"></div><button id="dsGo">♪ DANSE! ▶</button></div>
  </div>
  <div id="dPlay" class="hidden">
    <div id="dHud">
      <div id="dTrackName"></div>
      <div class="dStat dpanel big"><span>SCORE</span><b id="dScore">0</b></div>
      <div class="dStat dpanel"><span>RHYTHM</span><b id="dRhythm">—</b></div>
      <div class="dStat dpanel"><span>BRIER</span><b id="dBrier">—</b></div>
      <div class="dStat dpanel" id="dComboBox"><span>COMBO</span><b id="dCombo">0</b></div>
      <div class="dStat dpanel"><span>CRACKED</span><b id="dCracked">0</b></div>
      <div id="dProgress"><div id="dProgFill"></div></div>
      <button class="iconbtn" id="dPauseBtn" title="Pause (Esc)">⏸</button>
    </div>
    <div id="dMain">
      <div id="dSide">
        <div id="dStage"><div id="dAvatarMotion" class="rx-idle"><div id="dAvatar"></div></div><div id="dBubble" class="hidden"></div></div>
        <div id="dJudge" class="dpanel"><div class="jt">READY?</div><div class="js">bet when the card hits the frame</div></div>
        <div id="dTiming" class="dpanel" title="Timing of your last hits: left = early, right = late"><div class="bar"></div></div>
      </div>
      <div id="dLanes"></div>
    </div>
    <div id="dKeys"></div>
    <div id="dBanner" class="hidden"><small id="dBannerHead"></small><div id="dBannerText"></div></div>
    <div id="dCount"></div>
    <div id="dPause" class="hidden"><div class="modal"><h2>⏸ PAUSED</h2>
      <div class="btnrow" style="justify-content:center"><button class="pbtn gold" id="dpResume">▶ RESUME</button>
      <button class="pbtn ghost" id="dpRestart">↻ RESTART</button><button class="pbtn danger" id="dpQuit">✕ QUIT</button></div></div></div>
    <div id="dResults" class="hidden"></div>
  </div>
</div>

<div id="charSelect" class="hidden">
  <div id="csBg"></div>
  <div id="csHeader"><div id="csTitle">CHOOSE YOUR THINKER</div><div id="csSub">10 minds · 1 secret rule · infinite overconfidence</div></div>
  <div id="csBody">
    <div id="csShowcase">
      <div id="csBigName"></div>
      <div id="csAvatarMotion"><div id="csAvatar"></div></div>
      <div id="csInfo">
        <div id="csName"></div><div id="csTitleC"></div><div id="csEra"></div>
        <div id="csStats"></div>
        <div id="csQuote"><small>CATCHPHRASE</small><span id="csQuoteText"></span></div>
      </div>
      <div id="csFlash"></div>
    </div>
    <div id="csRoster"></div>
  </div>
  <div id="csFooter"><div id="csHint">← → ↑ ↓ browse · CLICK to pick · ENTER to fight</div><div style="display:flex;gap:12px;align-items:center"><button id="csDanse">♪ DANSE MODE</button><button id="csGo">ENTER THE ARENA ▶</button></div></div>
</div>

<div id="intro">
  <canvas id="introCanvas"></canvas>
  <div id="introGate">
    <div class="gatelogo">⚙</div>
    <div class="gatetitle">ELEUSIS ARENA</div>
    <div class="gatehint">— CLICK TO ENTER —</div>
    <div class="gatesub">turn your sound on 🔊</div>
  </div>
  <div id="introStage" class="hidden">
    <div id="kanji">法</div>
    <svg id="formula" viewBox="0 0 1000 120"><text x="500" y="90" text-anchor="middle">P(H | E) = P(E | H) · P(H) / P(E)</text></svg>
    <div id="formulaSub">EVERY CARD IS EVIDENCE</div>
    <div id="montage"><div id="mBg"></div><div id="mBand"></div><div id="mChar"></div><div id="mNum"></div><div id="mName"></div><div id="mTitle"></div></div>
    <div class="introGear" id="introGearL"></div>
    <div class="introGear" id="introGearR"></div>
    <div class="iring" id="ir1"></div><div class="iring" id="ir2"></div><div class="iring" id="ir3"></div>
    <div id="introLogo">ELEUSIS ⚡ ARENA</div>
    <div id="introTag"></div>
    <div id="introPress">— GET READY —</div>
    <div id="flare"></div>
    <div id="cutflash"></div>
    <div id="whiteflash"></div>
  </div>
  <button id="introSkip" class="hidden">SKIP ▸▸</button>
</div>
<!-- Optional built-in Danse track (sits next to this file). Missing file = harmless. -->
<script src="laplaces-angel.track.js" defer></script>
<script type="application/json" id="arena-state">{}</script>
<script>
/*ENGINE-START*/
const Engine = (() => {
  'use strict';
  function makeRng(seed){
    if(seed==null){ seed = (Math.random()*0xffffffff)>>>0; }
    let s = (seed>>>0) || 1;
    return function(){ s^=s<<13; s>>>=0; s^=s>>17; s^=s<<5; s>>>=0; return s/4294967296; };
  }
  const pick   = (rng,a)=>a[Math.floor(rng()*a.length)];
  const irange = (rng,a,b)=>a+Math.floor(rng()*(b-a+1));

  // ---------- Universe ----------
  const SHAPES = [
    {id:'triangle',sides:3},{id:'square',sides:4},{id:'pentagon',sides:5},
    {id:'hexagon',sides:6},{id:'octagon',sides:8},{id:'circle',sides:0}
  ];
  const COLORS  = ['red','blue','green','yellow','purple','orange'];
  const SYMBOLS = ['star','heart','moon','bolt','flower','diamond'];
  const SIZES   = ['small','medium','large'];
  const STYLES  = ['solid','outline','striped','dotted'];
  const LABEL = {shape:'shape', color:'color', symbol:'symbol', size:'size', style:'style', count:'count'};
  const sidesOf = it => SHAPES.find(s=>s.id===it.shape).sides; // circle = 0 sides
  const SIZE_ORD = {small:0, medium:1, large:2};

  // ---------- Levels ----------
  const LEVELS = [
    {name:'0 · Tutorial',              dims:{shape:2,color:2},                                tiers:[0]},
    {name:'1 · First Patterns',        dims:{shape:3,color:3},                                tiers:[0]},
    {name:'2 · Short Memory',          dims:{shape:4,color:4},                                tiers:[1]},
    {name:'3 · Three Dimensions',      dims:{shape:4,color:4,size:3},                         tiers:[0,1]},
    {name:'4 · Symbols',               dims:{shape:5,color:5,size:3,symbol:4},                tiers:[1,2]},
    {name:'5 · Numeracy',              dims:{shape:5,color:5,size:3,symbol:4,count:6},        tiers:[2]},
    {name:'6 · Grand Style',           dims:{shape:6,color:6,size:3,symbol:6,style:4,count:9},tiers:[3]},
    {name:'7 · Combinatorics',         dims:{shape:6,color:6,size:3,symbol:6,style:4,count:9},tiers:[3,4]},
    {name:'8 · Conditionals',          dims:{shape:6,color:6,size:3,symbol:6,style:4,count:9},tiers:[4]},
    {name:'9 · Master of Induction',   dims:{shape:6,color:6,size:3,symbol:6,style:4,count:9},tiers:[4,5]},
  ];

  function makeSpace(dims){
    const sp = {};
    sp.shape = SHAPES.slice(0,dims.shape);
    sp.color = COLORS.slice(0,dims.color);
    if(dims.symbol) sp.symbol = SYMBOLS.slice(0,dims.symbol);
    if(dims.size)   sp.size   = SIZES.slice(0,dims.size);
    if(dims.style)  sp.style  = STYLES.slice(0,dims.style);
    if(dims.count)  sp.count  = dims.count; // 1..count
    return sp;
  }
  const catDims = sp => ['shape','color','symbol','size','style'].filter(d=>sp[d]&&sp[d].length>=2);
  const valId = (d,v)=> d==='shape' ? v.id : v;
  const valsOf = (sp,d)=> sp[d].map(v=>valId(d,v));

  function randItem(sp,rng){
    const it = {shape:pick(rng,sp.shape).id, color:pick(rng,sp.color)};
    it.symbol = sp.symbol ? pick(rng,sp.symbol) : null;
    it.size   = sp.size   ? pick(rng,sp.size)   : null;
    it.style  = sp.style  ? pick(rng,sp.style)  : null;
    it.count  = sp.count  ? irange(rng,1,sp.count) : null;
    return it;
  }

  // ---------- Simple conditions ----------
  function makeCond(sp,rng){
    const kinds=[];
    const dims=catDims(sp);
    if(dims.length) kinds.push('attrEq','attrEq');
    if(dims.some(d=>valsOf(sp,d).length>=3)) kinds.push('attrIn');
    if(sp.count){ kinds.push('countParity'); if(sp.count>=4) kinds.push('countCmp'); if(sp.count>=6) kinds.push('countMult3'); }
    if(sp.shape.length>=3) kinds.push('sidesParity');
    const k=pick(rng,kinds);
    if(k==='attrEq'){
      const d=pick(rng,dims), v=pick(rng,valsOf(sp,d));
      return {desc:`its ${LABEL[d]} is “${v}”`, f:it=>it[d]===v};
    }
    if(k==='attrIn'){
      const d=pick(rng,dims.filter(d=>valsOf(sp,d).length>=3));
      const vs=valsOf(sp,d).slice(); const v1=vs.splice(Math.floor(rng()*vs.length),1)[0];
      const v2=vs[Math.floor(rng()*vs.length)];
      return {desc:`its ${LABEL[d]} is “${v1}” or “${v2}”`, f:it=>it[d]===v1||it[d]===v2};
    }
    if(k==='countParity'){
      const par=irange(rng,0,1);
      return {desc:`its symbol count is ${par?'odd':'even'}`, f:it=>it.count%2===par};
    }
    if(k==='countCmp'){
      const kk=irange(rng,2,sp.count-1), ge=rng()<.5;
      return {desc:`its symbol count is ${ge?'≥':'<'} ${kk}`, f:it=> ge? it.count>=kk : it.count<kk};
    }
    if(k==='countMult3'){
      return {desc:`its symbol count is a multiple of 3`, f:it=>it.count%3===0};
    }
    const par=irange(rng,0,1);
    return {desc:`its number of sides is ${par?'odd':'even'} (circle = 0 sides)`, f:it=>sidesOf(it)%2===par};
  }

  function makeRel(sp,rng){
    const kinds=[];
    catDims(sp).forEach(d=>{ kinds.push({t:'same',d}); kinds.push({t:'diff',d}); });
    const k=pick(rng,kinds);
    if(k.t==='same') return {desc:`its ${LABEL[k.d]} matches the previous item's`, f:(it,p)=>it[k.d]===p[k.d]};
    return {desc:`its ${LABEL[k.d]} differs from the previous item's`, f:(it,p)=>it[k.d]!==p[k.d]};
  }

  // ---------- Rule templates by tier ----------
  const TEMPLATES = [
    {tier:0, make:(sp,rng)=>{ const c=makeCond(sp,rng);
      return {desc:`An item is accepted if ${c.desc}.`, test:it=>c.f(it)}; }},
    {tier:1, make:(sp,rng)=>{ const r=makeRel(sp,rng);
      return {desc:`An item is accepted if ${r.desc}. (The very first item is always accepted.)`,
              test:(it,p)=> p==null || r.f(it,p)}; }},
    {tier:2, make:(sp,rng)=>{
      const opts=['sidesParityAlt'];
      if(sp.count){ opts.push('countParityAlt','countStep'); }
      if(sp.size && sp.size.length===3) opts.push('sizeCycle');
      const k=pick(rng,opts);
      if(k==='countParityAlt') return {desc:`The parity of the symbol count must alternate (even, odd, even…). (First item free.)`,
        test:(it,p)=> p==null || (it.count%2)!==(p.count%2)};
      if(k==='countStep') return {desc:`The symbol count must change by exactly 1 from the previous item. (First item free.)`,
        test:(it,p)=> p==null || Math.abs(it.count-p.count)===1};
      if(k==='sizeCycle') return {desc:`Size must step up each item (small → medium → large → small…). (First item free.)`,
        test:(it,p)=> p==null || SIZE_ORD[it.size]===(SIZE_ORD[p.size]+1)%3};
      return {desc:`The parity of the number of sides must alternate (circle = 0 sides). (First item free.)`,
        test:(it,p)=> p==null || (sidesOf(it)%2)!==(sidesOf(p)%2)};
    }},
    {tier:3, make:(sp,rng)=>{
      const mode=pick(rng,['and','or','condrel']);
      if(mode==='condrel'){
        const c=makeCond(sp,rng), r=makeRel(sp,rng);
        return {desc:`An item is accepted if ${c.desc} AND ${r.desc}.`,
                test:(it,p)=> c.f(it) && (p==null || r.f(it,p))};
      }
      let c1=makeCond(sp,rng), c2=makeCond(sp,rng), guard=0;
      while(c2.desc===c1.desc && guard++<20) c2=makeCond(sp,rng);
      if(mode==='and') return {desc:`An item is accepted if ${c1.desc} AND ${c2.desc}.`, test:it=>c1.f(it)&&c2.f(it)};
      return {desc:`An item is accepted if ${c1.desc} OR ${c2.desc}.`, test:it=>c1.f(it)||c2.f(it)};
    }},
    {tier:4, make:(sp,rng)=>{
      const mode=pick(rng,['ifelse','xor','prev2']);
      if(mode==='xor'){
        let c1=makeCond(sp,rng), c2=makeCond(sp,rng), guard=0;
        while(c2.desc===c1.desc && guard++<20) c2=makeCond(sp,rng);
        return {desc:`An item is accepted if EXACTLY ONE of these holds: (1) ${c1.desc}; (2) ${c2.desc}.`,
                test:it=> c1.f(it)!==c2.f(it)};
      }
      if(mode==='prev2'){
        const d=pick(rng,catDims(sp));
        return {desc:`An item must share its ${LABEL[d]} with the second-to-last accepted item. (The first two items are free.)`,
                test:(it,p,pp)=> pp==null || it[d]===pp[d]};
      }
      const a=makeCond(sp,rng), b=makeCond(sp,rng), c=makeCond(sp,rng);
      return {desc:`IF the previous item satisfied “${a.desc}”, THEN the new item must satisfy “${b.desc}”; OTHERWISE it must satisfy “${c.desc}”. (First item free.)`,
              test:(it,p)=> p==null || (a.f(p)? b.f(it) : c.f(it))};
    }},
    {tier:5, make:(sp,rng)=>{
      const opts=['exactlyOne']; if(sp.count){opts.push('sumParity','countSidesParity');}
      const k=pick(rng,opts);
      if(k==='sumParity'){ const par=irange(rng,0,1);
        return {desc:`The sum (this item's symbol count + the previous item's) must be ${par?'odd':'even'}. (First item free.)`,
                test:(it,p)=> p==null || (it.count+p.count)%2===par};
      }
      if(k==='countSidesParity'){
        return {desc:`The symbol count must have the same parity as the number of sides (circle = 0 sides).`,
                test:it=> (it.count%2)===(sidesOf(it)%2)};
      }
      const dims=catDims(sp);
      return {desc:`An item must share EXACTLY ONE attribute value (among: ${dims.map(d=>LABEL[d]).join(', ')}) with the previous item. (First item free.)`,
              test:(it,p)=> p==null || dims.filter(d=>it[d]===p[d]).length===1};
    }},
  ];

  // ---------- Balancing ----------
  function acceptRatio(rule,sp,rng,n){
    let acc=[], ok=0;
    for(let i=0;i<n;i++){
      const it=randItem(sp,rng);
      const p=acc[acc.length-1]||null, pp=acc[acc.length-2]||null;
      if(rule.test(it,p,pp)){ ok++; acc.push(it); if(acc.length>4) acc=acc.slice(-2); }
    }
    return ok/n;
  }
  function makeRule(lv,rng){
    const sp=makeSpace(lv.dims);
    const cands=TEMPLATES.filter(t=>lv.tiers.includes(t.tier));
    for(let tries=0;tries<80;tries++){
      const rule=pick(rng,cands).make(sp,rng);
      const r=acceptRatio(rule,sp,rng,300);
      const lo=lv.tiers.some(t=>t>=4)?0.08:0.12, hi=1-lo;
      if(r>=lo && r<=hi) return rule;
    }
    return TEMPLATES[0].make(sp,rng);
  }

  // ---------- Game ----------
  function validateSpec(sp,spec){
    if(!spec||typeof spec!=='object') throw new Error('play(spec) needs an item object, e.g. {shape:"square", color:"red"}.');
    const it={};
    for(const d of ['shape','color','symbol','size','style']){
      if(sp[d]){ const vs=valsOf(sp,d);
        if(!vs.includes(spec[d])) throw new Error(`Invalid or missing "${d}". Allowed values: ${vs.join(', ')}`);
        it[d]=spec[d];
      } else it[d]=null;
    }
    if(sp.count){ const n=Number(spec.count);
      if(!Number.isInteger(n)||n<1||n>sp.count) throw new Error(`"count" must be an integer between 1 and ${sp.count}`);
      it.count=n;
    } else it.count=null;
    return it;
  }
  function normProb(p){
    if(p==null) return 0.5; // no bet = total uncertainty
    if(typeof p==='object' && p) p=p.p;
    p=Number(p);
    if(!Number.isFinite(p)||p<0||p>1) throw new Error('The bet probability must be a number between 0 and 1.');
    return p;
  }

  function customLevel(c){
    const cl=(v,lo,hi)=>v==null?undefined:Math.max(lo,Math.min(hi,v|0));
    const d=c.dims||{};
    const dims={shape:cl(d.shape,2,6)||2, color:cl(d.color,2,6)||2};
    for(const [k,hi] of [['symbol',6],['size',3],['style',4],['count',9]]) if(d[k]) dims[k]=cl(d[k],2,hi);
    const tiers=(c.tiers&&c.tiers.length? c.tiers : [0]).map(t=>Math.max(0,Math.min(5,t|0)));
    return {name:c.name||'Custom', dims, tiers};
  }
  // newGame(level, seed?, custom?) — custom = {name, dims:{shape,color,symbol?,size?,style?,count?}, tiers:[0..5]}
  function newGame(level=0, seed=null, custom=null){
    level=Math.max(0,Math.min(LEVELS.length-1,level|0));
    const rng=makeRng(seed);
    const lv=custom? customLevel(custom) : LEVELS[level], sp=makeSpace(lv.dims);
    const rule=makeRule(lv,rng);            // ← the rule lives ONLY inside this closure
    let accepted=[], rejected=[], history=[], moves=0, combo=0, bestCombo=0;
    let brierSum=0, revealed=false;

    function ctx(){ return [accepted[accepted.length-1]||null, accepted[accepted.length-2]||null]; }

    function getState(){
      return {
        level, levelName:lv.name, dims:{...lv.dims},
        params:{
          shape:sp.shape.map(s=>s.id), color:[...sp.color],
          symbol:sp.symbol?[...sp.symbol]:null, size:sp.size?[...sp.size]:null,
          style:sp.style?[...sp.style]:null, count:sp.count||null
        },
        accepted:accepted.map(a=>({...a})),
        rejected:rejected.map(r=>({item:{...r.item}, afterIndex:r.afterIndex})),
        history:history.map(h=>({...h, item:{...h.item}})),
        moves, combo, bestCombo,
        // THE score: total Brier / cards played (0 = prophet, 0.25 = coin flip, lower = better)
        score: moves? brierSum/moves : null,
        brierSum,
        revealed,
        rule: revealed? rule.desc : null   // only revealed through reveal(), once
      };
    }
    function play(spec, prob=null){
      if(revealed) throw new Error('The rule has been revealed — this level is over. Judge your prediction, or call newGame().');
      prob=normProb(prob);
      const it=validateSpec(sp,spec);
      const [p,pp]=ctx();
      const ok=!!rule.test(it,p,pp);
      moves++;
      if(ok) accepted.push(it);
      else rejected.push({item:it, afterIndex:accepted.length-1});
      const y=ok?1:0, brier=(prob-y)*(prob-y);
      brierSum+=brier;
      const good = brier < 0.25-1e-12;         // better than a coin flip
      const neutral = Math.abs(brier-0.25)<=1e-12;
      combo = good? combo+1 : 0;
      bestCombo=Math.max(bestCombo,combo);
      history.push({n:moves, item:{...it}, p:prob, accepted:ok, brier});
      const bet={p:prob, outcome:y, brier, good, neutral};
      return {accepted:ok, item:{...it}, bet, state:getState()};
    }
    function reveal(){
      if(revealed) throw new Error('The rule has already been revealed — one submission per level!');
      revealed=true;
      return {rule:rule.desc, state:getState()};
    }
    return {getState, play, reveal, levelInfo:()=>({...lv})};
  }

  return {
    LEVELS, SHAPES, COLORS, SYMBOLS, SIZES, STYLES, LABEL, sidesOf,
    levels:()=>LEVELS.map((l,i)=>({index:i,name:l.name,dims:{...l.dims},tiers:[...l.tiers]})),
    newGame
  };
})();
/*ENGINE-END*/
</script>
<script>
window.__turbo=false;
/* =================== SFX — synthesized anime-style sound effects =================== */
const SFX = (() => {
  let ac=null, muted=false;
  const off=()=>muted||window.__turbo;
  const ctx=()=>{ if(!ac) ac=new (window.AudioContext||window.webkitAudioContext)(); if(ac.state==='suspended') ac.resume(); return ac; };
  function tone({f=880,f2=null,t=0,dur=.12,type='sine',vol=.2,glide=false}){
    if(off()) return; const a=ctx(), now=a.currentTime+t;
    const o=a.createOscillator(), g=a.createGain();
    o.type=type; o.frequency.setValueAtTime(f,now);
    if(f2) o.frequency[glide?'linearRampToValueAtTime':'setValueAtTime'](f2,now+dur*.9);
    g.gain.setValueAtTime(0,now);
    g.gain.linearRampToValueAtTime(vol,now+.008);
    g.gain.exponentialRampToValueAtTime(.0001,now+dur);
    o.connect(g).connect(a.destination); o.start(now); o.stop(now+dur+.02);
  }
  function noise({t=0,dur=.15,vol=.15,hp=2000,lp=null}){
    if(off()) return; const a=ctx(), now=a.currentTime+t;
    const len=Math.max(1,Math.floor(a.sampleRate*dur)), buf=a.createBuffer(1,len,a.sampleRate), d=buf.getChannelData(0);
    for(let i=0;i<len;i++) d[i]=(Math.random()*2-1)*(1-i/len);
    const s=a.createBufferSource(); s.buffer=buf;
    const f=a.createBiquadFilter(); f.type=lp?'lowpass':'highpass'; f.frequency.value=lp||hp;
    const g=a.createGain(); g.gain.value=vol;
    s.connect(f); f.connect(g).connect(a.destination); s.start(now);
  }
  return {
    isMuted:()=>muted,
    toggle(){ muted=!muted; return muted; },
    unlock(){ try{ if(!window.__turbo) ctx(); }catch(e){} },
    click(){ tone({f:1400,dur:.05,type:'triangle',vol:.1}); },
    tick(){ tone({f:2600,dur:.02,type:'square',vol:.022}); },
    blip(v=600){ tone({f:v*(0.9+Math.random()*0.25),dur:.035,type:'square',vol:.03}); },
    kakin(){ tone({f:2093,dur:.12,type:'square',vol:.08}); tone({f:3136,t:.03,dur:.28,type:'triangle',vol:.12});
      tone({f:4186,t:.06,dur:.4,type:'sine',vol:.08}); noise({dur:.15,vol:.08,hp:7000}); },
    confirm(){ [784,1046,1568,2093].forEach((f,i)=>tone({f,t:i*.06,dur:.25,type:'square',vol:.07})); noise({t:.15,dur:.45,vol:.08,hp:5000}); },
    whoosh(){ noise({dur:.26,vol:.16,hp:900}); tone({f:220,f2:1400,dur:.24,type:'sine',vol:.05,glide:true}); },
    thump(){ tone({f:90,f2:38,dur:.32,type:'sine',vol:.6,glide:true}); noise({dur:.08,vol:.12,lp:300}); },
    hit(){ tone({f:130,f2:48,dur:.28,type:'sine',vol:.5,glide:true}); noise({dur:.2,vol:.24,lp:1700}); tone({f:880,dur:.06,type:'square',vol:.05}); },
    goodBet(m,combo=1){
      const base=(620+m*180)*Math.pow(1.045,Math.min(combo,14));
      tone({f:base,dur:.09,type:'triangle',vol:.16+m*.12});
      tone({f:base*1.5,t:.07,dur:.14,type:'triangle',vol:.16+m*.12});
      noise({t:.05,dur:.14+m*.15,vol:.04+m*.05,hp:6000});
      if(m>.5) tone({f:base*2,t:.13,dur:.22,type:'sine',vol:.1});
    },
    badBet(m){
      tone({f:200-60*m,f2:90-30*m,dur:.24+.3*m,type:'sawtooth',vol:.12+.14*m,glide:true});
      tone({f:150,t:.02,dur:.16+.2*m,type:'square',vol:.05+.09*m});
      noise({dur:.1+.18*m,vol:.08+.14*m,lp:900});
    },
    gaan(){ [233,247,330,415].forEach(f=>tone({f,dur:.75,type:'sawtooth',vol:.055}));
      tone({f:116,f2:52,dur:.85,type:'square',vol:.1,glide:true}); noise({dur:.45,vol:.2,lp:700}); },
    neutral(){ tone({f:500,dur:.06,type:'sine',vol:.07}); },
    combo(){ [1046,1318,1568,2093].forEach((f,i)=>tone({f,t:i*.055,dur:.12,type:'triangle',vol:.16}));
      noise({t:.1,dur:.3,vol:.05,hp:7000}); },
    reveal(){ tone({f:98,f2:49,dur:.6,type:'sine',vol:.5,glide:true});
      [523,659,784,1046].forEach((f,i)=>tone({f,t:.12+i*.1,dur:.4,type:'square',vol:.07})); noise({t:.1,dur:.5,vol:.1,hp:4000}); },
    fail(){ tone({f:311,f2:155,dur:.6,type:'sawtooth',vol:.15,glide:true}); tone({f:233,t:.1,dur:.5,type:'square',vol:.08}); },
    fanfare(){
      const seq=[[523,0],[659,.12],[784,.24],[1046,.36],[784,.5],[1046,.62],[1318,.78]];
      seq.forEach(([f,t])=>{ tone({f,t,dur:.22,type:'square',vol:.1}); tone({f:f*2,t,dur:.22,type:'triangle',vol:.12}); });
      noise({t:.36,dur:.5,vol:.1,hp:5000}); noise({t:.78,dur:.8,vol:.12,hp:4000});
    },
    rumble(dur=6){ tone({f:38,dur,type:'sawtooth',vol:.07}); tone({f:45,dur,type:'sawtooth',vol:.06}); noise({dur,vol:.045,lp:150}); },
    riser(dur=2){ tone({f:80,f2:950,dur,type:'sawtooth',vol:.09,glide:true});
      tone({f:160,f2:1900,dur,type:'sine',vol:.06,glide:true}); noise({t:dur*.5,dur:dur*.5,vol:.06,hp:3000}); },
    boom(){ tone({f:64,f2:26,dur:1.1,type:'sine',vol:.6,glide:true}); noise({dur:.6,vol:.32,lp:400});
      noise({t:.05,dur:1.3,vol:.13,hp:4500}); [262,330,392,523].forEach(f=>tone({f,t:.05,dur:1.4,type:'sawtooth',vol:.035})); }
  };
})();

/* =================== Visual FX =================== */
const FX = (() => {
  const T=()=>window.__turbo;
  const cv=document.getElementById('fxCanvas'), cx=cv.getContext('2d');
  let parts=[], raf=null;
  function resize(){ cv.width=innerWidth; cv.height=innerHeight; }
  addEventListener('resize',resize); resize();
  const COLS=['#ffd32a','#ff4757','#2ed573','#3d8bff','#a55eea','#ff7f2a','#ffffff'];
  function burst(x,y,n=26,power=7,cols=COLS){
    if(T()) return;
    for(let i=0;i<n;i++){ const a=Math.random()*Math.PI*2, v=(0.35+Math.random())*power;
      parts.push({x,y,vx:Math.cos(a)*v,vy:Math.sin(a)*v-3,g:.22,r:3+Math.random()*4,
        c:cols[(Math.random()*cols.length)|0], life:1, spin:Math.random()*6, shape:Math.random()<.5});
    }
    if(!raf) raf=requestAnimationFrame(step);
  }
  function bigParty(){ if(T()) return; for(let k=0;k<7;k++) setTimeout(()=>burst(Math.random()*innerWidth, innerHeight*0.2+Math.random()*innerHeight*0.35, 44, 10), k*160); }
  function step(){
    cx.clearRect(0,0,cv.width,cv.height);
    parts=parts.filter(p=>p.life>0);
    for(const p of parts){
      p.x+=p.vx; p.y+=p.vy; p.vy+=p.g; p.vx*=.985; p.life-=.016; p.spin+=.2;
      cx.globalAlpha=Math.max(p.life,0); cx.fillStyle=p.c;
      cx.save(); cx.translate(p.x,p.y); cx.rotate(p.spin);
      if(p.shape) cx.fillRect(-p.r,-p.r/2,p.r*2,p.r);
      else { cx.beginPath(); cx.arc(0,0,p.r,0,7); cx.fill(); }
      cx.restore();
    }
    cx.globalAlpha=1;
    raf = parts.length? requestAnimationFrame(step) : null;
  }
  function floater(x,y,txt,color,size){
    if(T()) return;
    const el=document.createElement('div'); el.className='floater'; el.textContent=txt;
    el.style.left=x+'px'; el.style.top=(y-20)+'px'; el.style.color=color;
    if(size) el.style.fontSize=size+'px';
    document.body.appendChild(el); setTimeout(()=>el.remove(),1300);
  }
  function restart(el,cls){ el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); }
  function shake(amp=1){
    if(T()) return;
    document.body.style.setProperty('--amp', String(Math.max(.2,Math.min(3,amp))));
    restart(document.body,'shake');
  }
  function glow(kind){
    if(T()) return;
    const g=document.getElementById('glowFrame');
    g.classList.remove('flash-good','flash-bad'); void g.offsetWidth;
    g.classList.add(kind==='good'?'flash-good':'flash-bad');
  }
  function comboBurst(n){ if(T()) return; const el=document.getElementById('comboBurst'); el.textContent=`CALIBRATED ×${n}!!`; restart(el,'go'); }
  function onoma(jp,en,color='#ff4757',rot=-6){
    if(T()) return;
    const o=document.getElementById('onoma');
    o.querySelector('.jp').textContent=jp; o.querySelector('.en').textContent=en;
    o.style.setProperty('--oc',color); o.style.setProperty('--rot',rot+'deg');
    o.style.left=(52+Math.random()*16)+'%'; o.style.top=(28+Math.random()*16)+'%';
    restart(o,'go');
  }
  function ring(x,y,color){
    if(T()) return;
    const r=document.createElement('div'); r.className='ring'; r.style.left=x+'px'; r.style.top=y+'px'; r.style.setProperty('--rc',color);
    document.body.appendChild(r); setTimeout(()=>r.remove(),700);
  }
  function punch(){ if(T()) return; restart(document.getElementById('app'),'punch'); }
  function impact(){ if(T()) return; document.body.classList.add('impact'); setTimeout(()=>document.body.classList.remove('impact'),90); }
  function rush(on){ document.body.classList.toggle('rush',on && !T()); }
  return {burst,bigParty,floater,shake,glow,comboBurst,onoma,ring,punch,impact,rush,restart};
})();

/* =================== Gears & floating symbols =================== */
const GearSVG=(R,teeth,color,hole=.42)=>{
  const r=R*.82, steps=teeth*4; let d='';
  for(let i=0;i<=steps;i++){ const a=i/steps*2*Math.PI; const rad=(i%4<2)? R : r;
    d+=(i?'L':'M')+(Math.cos(a)*rad).toFixed(1)+','+(Math.sin(a)*rad).toFixed(1)+' '; }
  const h=(R*hole).toFixed(1);
  d+=`Z M${h},0 A${h},${h} 0 1,0 ${-h},0 A${h},${h} 0 1,0 ${h},0 Z`;
  const s=R+6;
  return `<svg width="${2*s}" height="${2*s}" viewBox="${-s} ${-s} ${2*s} ${2*s}" xmlns="http://www.w3.org/2000/svg"><path d="${d}" fill="${color}" fill-rule="evenodd"/></svg>`;
};
(() => {
  const host=document.getElementById('gears');
  const defs=[
    {x:'82%', y:'-90px', R:150, teeth:12, d:'22s', o:.10, rev:false, c:'#8b90c0'},
    {x:'-70px', y:'62%', R:110, teeth:10, d:'15s', o:.09, rev:true,  c:'#ffd32a'},
    {x:'93%', y:'70%',   R:64,  teeth:8,  d:'9s',  o:.12, rev:false, c:'#a55eea'},
    {x:'30%', y:'-60px', R:52,  teeth:8,  d:'11s', o:.07, rev:true,  c:'#8b90c0'},
    {x:'55%', y:'88%',   R:80,  teeth:9,  d:'13s', o:.06, rev:true,  c:'#3d8bff'},
  ];
  host.innerHTML=defs.map(g=>`<div class="gear ${g.rev?'rev':''}" style="left:${g.x};top:${g.y};--d:${g.d};--o:${g.o}">${GearSVG(g.R,g.teeth,g.c)}</div>`).join('');
  document.getElementById('introGearL').innerHTML=GearSVG(200,14,'#ffd32a');
  document.getElementById('introGearR').innerHTML=GearSVG(160,11,'#a55eea');
  const SYMS=['P(A|B)','Σ','∫','μ','σ²','Ω','⚀','⚁','⚂','⚃','⚄','⚅','E[X]','p̂','∞','≈','∝','𝔼','π','e','n→∞','½','Var','P(H)','ℙ','⊆','∀','∃'];
  const bg=document.getElementById('bgSymbols');
  for(let i=0;i<26;i++){
    const s=document.createElement('span'); s.textContent=SYMS[i%SYMS.length];
    s.style.left=(Math.random()*96)+'%'; s.style.top=(Math.random()*94)+'%';
    s.style.fontSize=(16+Math.random()*34)+'px';
    s.style.setProperty('--t',(18+Math.random()*24)+'s'); s.style.setProperty('--dl',(-Math.random()*30)+'s');
    s.style.setProperty('--dx',(Math.random()*120-60)+'px'); s.style.setProperty('--dy',(Math.random()*120-60)+'px');
    s.style.setProperty('--r',(Math.random()*60-30)+'deg');
    bg.appendChild(s);
  }
})();
</script>
<script>
/* =================== THINKERS — procedural SVG characters =================== */
const Chars = (() => {
  const OUT='#0b0d20';
  const LIST=[
    {id:'laplace', name:'Pierre-Simon Laplace', short:'LAPLACE', title:'Keeper of the Demon', era:'1749–1827 · France',
     color:'#3d8bff', skin:'#f4cfae', skinShade:'#d9a682', hair:'wigRolls', hairColor:'#eef0fa', browColor:'#9aa0b8',
     outfit:'#1f3c99', outfit2:'#e8c35a', collar:'jabot', prop:'orb', voice:620,
     stats:{Prior:5, Doubt:2, Calculus:5, Swagger:5},
     catch:'Probability is just common sense, reduced to calculus.',
     lines:{select:['Give me the state of the universe, and I will give you your next card.'],
       idle:['The demon is watching…','Every cause has its effect. Even this one.','Determinism is patient.'],
       win:['Calculated.','Common sense, reduced to calculus.','As foreseen.'],
       lose:['A mere perturbation.','The demon blinked.','Noise. Pure noise.'],
       combo:['DETERMINISM, BABY!','The universe obeys!'], shocked:['IMPOSSIBLE! The equations!'],
       thinking:['Summing over all possible worlds…'], victory:['I had no need of luck.'], defeat:['Even demons have off days.']}},
    {id:'bayes', name:'Thomas Bayes', short:'BAYES', title:'Reverend of the Posterior', era:'c.1701–1761 · England',
     color:'#2ed573', skin:'#f2cba8', skinShade:'#d39d78', hair:'grayBob', hairColor:'#a3a3ad', browColor:'#6e6e78',
     outfit:'#1d1d2b', outfit2:'#ffffff', collar:'bands', prop:'scroll', voice:520,
     stats:{Prior:5, Doubt:3, Calculus:4, Swagger:2},
     catch:'Bring me evidence. I will bring the update.',
     lines:{select:['Let me update you on something.'],
       idle:['Prior is warm. Bring evidence.','Every card is a data point.','Hmm. What would change my mind?'],
       win:['Posterior confirmed!','Likelihood ratio: delicious.','The evidence agrees.'],
       lose:['Updating… updating…','Noted. Revising priors.','A surprising likelihood.'],
       combo:['THE POSTERIOR IS ON FIRE!','Conjugate bliss!'], shocked:['My prior! It is RUINED!'],
       thinking:['P(H|E) ∝ P(E|H)·P(H)…'], victory:['And the evidence agreed.'], defeat:['A humbling update.']}},
    {id:'socrates', name:'Socrates', short:'SOCRATES', title:'The Gadfly of Athens', era:'c.470–399 BC · Athens',
     color:'#ffd32a', skin:'#e3b08a', skinShade:'#bf855f', hair:'baldFringe', hairColor:'#f4f4f4', browColor:'#cfcfcf',
     facial:'full', beardColor:'#f4f4f4', nose:'snub', outfit:'#efe6d0', outfit2:'#c0392b', collar:'toga', prop:'cup', voice:420,
     stats:{Prior:1, Doubt:5, Calculus:2, Swagger:4},
     catch:'I know that I know nothing. Yet.',
     lines:{select:['I know nothing. Shall we begin?'],
       idle:['What, then, is a rule?','Ask, and keep asking.','Is a card accepted because it is good, or good because it is accepted?'],
       win:['As I suspected… or did I?','The dialogue bears fruit!','Excellent, my friend.'],
       lose:['Ah. I knew I knew nothing.','Aporia! Wonderful!','Let us examine that.'],
       combo:['WISDOM FLOWS LIKE WINE!','The gadfly stings!'], shocked:['By the dog!'],
       thinking:['But what do we mean by “accepted”?'], victory:['The unexamined rule is not worth playing.'], defeat:['Then let us question again.']}},
    {id:'russell', name:'Bertrand Russell', short:'RUSSELL', title:'The Paradox Hunter', era:'1872–1970 · Britain',
     color:'#ff4757', skin:'#f3ceb0', skinShade:'#d6a585', hair:'sweptWhite', hairColor:'#f2f2f6', browColor:'#b8b8c2',
     outfit:'#3a3f52', outfit2:'#c0392b', collar:'suit', pipe:true, voice:560,
     stats:{Prior:2, Doubt:5, Calculus:4, Swagger:4},
     catch:'Doubt is the beginning of every good bet.',
     lines:{select:['Doubt is my sharpest tool.'],
       idle:['Is the set of all rules a rule?','*puffs pipe thoughtfully*','Define “accepted”. Rigorously.'],
       win:['Logically inevitable.','Q.E.D., more or less.','Quite.'],
       lose:['A paradox. How delightful.','The barber shaves no one.','Hmm. A type error.'],
       combo:['PRINCIPIA PROBABILITAS!','Logic triumphant!'], shocked:['CERTAINTY! My old nemesis!'],
       thinking:['Let us define our terms…'], victory:['Proved — in fewer than 362 pages.'], defeat:['The fools are cocksure. I was, briefly.']}},
    {id:'pascal', name:'Blaise Pascal', short:'PASCAL', title:'The Wagerer', era:'1623–1662 · France',
     color:'#a55eea', skin:'#f1cdb0', skinShade:'#d3a07f', hair:'longDark', hairColor:'#3b2a20', browColor:'#2a1c14',
     facial:'pencil', beardColor:'#3b2a20', outfit:'#20202e', collar:'rabat', prop:'pascaline', voice:600,
     stats:{Prior:3, Doubt:3, Calculus:5, Swagger:3},
     catch:'Let us weigh the gain and the loss.',
     lines:{select:['Let us weigh the gain and the loss.'],
       idle:['Infinite stakes, finite cards.','Wager wisely.','*cranks the Pascaline*'],
       win:['The wager pays!','The triangle provides.','Expected value, collected.'],
       lose:['The heart had its reasons…','Too clever by half.','Bad odds. Good lesson.'],
       combo:['EXPECTED VALUE: ASCENDING!','Infinite gain!'], shocked:['My wager!!'],
       thinking:['Cranking the Pascaline…'], victory:['A bet worth making.'], defeat:['Back to the Pensées.']}},
    {id:'fermat', name:'Pierre de Fermat', short:'FERMAT', title:'Lord of the Margin', era:'1601–1665 · France',
     color:'#ff7f2a', skin:'#f0c9a6', skinShade:'#d19c76', hair:'curlyWig', hairColor:'#6b4423', browColor:'#4a2e17',
     facial:'curled', beardColor:'#4a2e17', outfit:'#7a1f2b', outfit2:'#f5e6c4', collar:'jabot', prop:'book', voice:640,
     stats:{Prior:3, Doubt:2, Calculus:5, Swagger:5},
     catch:'I have a marvelous strategy. This margin is too small.',
     lines:{select:['I have a marvelous strategy…'],
       idle:['The margin is getting crowded.','Just a little note…','Proof? Later. Probably.'],
       win:['Proof left to the reader.','Elegant, non?','Naturally.'],
       lose:['That was… the margin’s fault.','Mere amateur hour.','I meant to do that.'],
       combo:['EVEN PASCAL WOULD WEEP!','Marvelous! Truly marvelous!'], shocked:['SACRÉ BLEU!'],
       thinking:['Scribbling in the margin…'], victory:['Proved! And this time I wrote it down.'], defeat:['This margin is too narrow for my excuses.']}},
    {id:'bernoulli', name:'Jacob Bernoulli', short:'BERNOULLI', title:'Master of Large Numbers', era:'1655–1705 · Basel',
     color:'#1abc9c', skin:'#f2cdae', skinShade:'#d4a380', hair:'fullWig', hairColor:'#d8cfbf', browColor:'#8a7f6e',
     outfit:'#123a3a', outfit2:'#ffffff', collar:'bands', prop:'urn', voice:500,
     stats:{Prior:3, Doubt:3, Calculus:4, Swagger:3},
     catch:'In the long run, I am always right.',
     lines:{select:['In the long run, I am always right.'],
       idle:['Draw another ball from the urn.','Large numbers, little patience.','n is still too small.'],
       win:['The law holds!','Convergence!','Frequencies, behave!'],
       lose:['Small sample. Ignore it.','The urn is cheating.','Variance, you rascal.'],
       combo:['THE LAW OF LARGE COMBOS!','It converges!'], shocked:['That is NOT in the urn!'],
       thinking:['n → ∞ … any minute now…'], victory:['Eadem mutata resurgo!'], defeat:['Same urn. I will be back.']}},
    {id:'cardano', name:'Gerolamo Cardano', short:'CARDANO', title:'The Gambling Polymath', era:'1501–1576 · Italy',
     color:'#e84393', skin:'#e6b48e', skinShade:'#c48862', hair:'capBeard', hairColor:'#2b2018', browColor:'#2b2018',
     facial:'pointed', beardColor:'#2b2018', outfit:'#5a2a1a', outfit2:'#7a5230', collar:'fur', prop:'dice', voice:470,
     stats:{Prior:4, Doubt:1, Calculus:3, Swagger:5},
     catch:'Roll with me. The odds are listening.',
     lines:{select:['Roll with me, friend.'],
       idle:['*rattles dice*','The house always calculates.','Feeling lucky? I always am.'],
       win:['Lady Luck owes me money.','Read the bones!','Winner winner!'],
       lose:['Loaded dice! Must be.','I will win it back.','A minor setback.'],
       combo:['HOT STREAK! NEVER STOP!','The dice LOVE me!'], shocked:['My purse! My reputation!'],
       thinking:['Counting the faces…'], victory:['The odds were mine all along.'], defeat:['Best advantage in gambling? Not playing.']}},
    {id:'nightingale', name:'Florence Nightingale', short:'NIGHTINGALE', title:'The Lady with the Data', era:'1820–1910 · Britain',
     color:'#74b9ff', skin:'#f5d3b8', skinShade:'#dcac8c', hair:'bunCap', hairColor:'#4a3022', browColor:'#3a2418',
     outfit:'#1e2a4a', outfit2:'#e8c35a', collar:'dress', prop:'lamp', voice:760,
     stats:{Prior:3, Doubt:4, Calculus:4, Swagger:3},
     catch:'Let the data speak — loudly.',
     lines:{select:['Let the data speak.'],
       idle:['Charting every case.','The lamp is lit.','Records, records, records.'],
       win:['The numbers do not lie.','Another petal on the diagram.','Exactly as the data said.'],
       lose:['Record it. Learn from it.','A reform is in order.','Noted in the ledger.'],
       combo:['THE STATISTICS ARE GLORIOUS!','Evidence, marching!'], shocked:['This needs a diagram!'],
       thinking:['Plotting the polar area…'], victory:['Evidence, presented beautifully.'], defeat:['Back to the wards, then.']}},
    {id:'kolmogorov', name:'Andrey Kolmogorov', short:'KOLMOGOROV', title:'Architect of the Axioms', era:'1903–1987 · USSR',
     color:'#e17055', skin:'#f1ccb0', skinShade:'#d2a083', hair:'baldSide', hairColor:'#a0a6ae', browColor:'#7c828a', glasses:true,
     outfit:'#5b6b80', outfit2:'#2d3446', collar:'sweater', prop:'slate', voice:540,
     stats:{Prior:2, Doubt:4, Calculus:5, Swagger:2},
     catch:'First, the axioms. Then, the victory.',
     lines:{select:['First, the axioms.'],
       idle:['Let Ω be a set…','Measure twice, predict once.','Complexity: suspicious.'],
       win:['Axiomatically correct.','σ-additive success.','As defined.'],
       lose:['A null set. Irrelevant.','Measure zero. Moving on.','Hmm. Unmeasurable.'],
       combo:['COMPLEXITY: MINIMAL!','Shortest description wins!'], shocked:['This violates the AXIOMS!'],
       thinking:['Constructing the σ-algebra…'], victory:['P(victory) = 1.'], defeat:['Even axioms need theorems.']}},
  ];
  const byId=Object.fromEntries(LIST.map(c=>[c.id,c]));

  const REACT={
    idle:    {pose:'idle',    eyes:'normal', brows:'neutral', mouth:'smile', fx:[]},
    select:  {pose:'select',  eyes:'normal', brows:'down',    mouth:'grin',  fx:['rays','sparkle']},
    win:     {pose:'win',     eyes:'happy',  brows:'raised',  mouth:'grin',  fx:['sparkle'], blush:true},
    lose:    {pose:'lose',    eyes:'sad',    brows:'up',      mouth:'wobble',fx:['sweat']},
    combo:   {pose:'combo',   eyes:'star',   brows:'down',    mouth:'shout', fx:['aura','sparkle']},
    shocked: {pose:'shocked', eyes:'wide',   brows:'raised',  mouth:'o',     fx:['exclaim','sweat','shock']},
    thinking:{pose:'thinking',eyes:'side',   brows:'tilt',    mouth:'flat',  fx:['question']},
    victory: {pose:'win',     eyes:'happy',  brows:'raised',  mouth:'grin',  fx:['rays','sparkle','confetti'], blush:true},
    defeat:  {pose:'defeat',  eyes:'spiral', brows:'up',      mouth:'frown', fx:['cloud','tears'], dy:8, tilt:-9},
  };
  const POSES={
    idle:    {L:[[64,176],[50,208],[60,236]], R:[[136,176],[150,208],[140,236]], prop:'R'},
    select:  {L:[[64,176],[40,204],[66,218]], R:[[136,176],[170,160],[180,124]], prop:'R'},
    win:     {L:[[64,176],[42,146],[40,110]], R:[[136,176],[158,146],[160,110]], prop:'R'},
    lose:    {L:[[64,176],[36,150],[64,70]],  R:[[136,176],[164,150],[136,70]],  prop:null},
    combo:   {L:[[64,176],[54,206],[86,198]], R:[[136,176],[172,164],[168,116]], prop:'L'},
    thinking:{L:[[64,176],[66,206],[116,202]],R:[[136,176],[152,196],[116,148]], prop:null},
    shocked: {L:[[64,176],[34,184],[22,156]], R:[[136,176],[166,184],[178,156]], prop:'R'},
    defeat:  {L:[[64,176],[58,214],[78,240]], R:[[136,176],[142,214],[122,240]], prop:null},
  };

  const P=(d,fill,sw=3)=>`<path d="${d}" fill="${fill}" stroke="${OUT}" stroke-width="${sw}" stroke-linejoin="round"/>`;
  const curls=(pts,r,col)=>pts.map(([x,y])=>`<circle cx="${x}" cy="${y}" r="${r}" fill="${col}" stroke="${OUT}" stroke-width="3"/>`).join('');
  function starPath(cx,cy,R,r,n=5){ let d=''; for(let i=0;i<n*2;i++){ const a=-Math.PI/2+i*Math.PI/n, rad=i%2?r:R;
      d+=(i?'L':'M')+(cx+Math.cos(a)*rad).toFixed(1)+','+(cy+Math.sin(a)*rad).toFixed(1); } return d+'Z'; }
  const spark=(x,y,s,col,delay=0)=>`<path class="chr-twinkle" style="animation-delay:${delay}s" d="M${x},${y-s} Q${x},${y} ${x+s},${y} Q${x},${y} ${x},${y+s} Q${x},${y} ${x-s},${y} Q${x},${y} ${x},${y-s}Z" fill="${col}" stroke="${OUT}" stroke-width="1.5"/>`;

  function hairBack(c){
    const h=c.hairColor;
    switch(c.hair){
      case 'wigRolls': return P('M50,104 Q44,40 100,38 Q156,40 150,104 Q150,132 132,142 L68,142 Q50,132 50,104 Z',h)+'<path d="M92,140 L100,172 L108,140 Z" fill="#1a1a2e"/>';
      case 'grayBob': return P('M48,100 Q44,38 100,38 Q156,38 152,100 L156,146 Q138,156 124,142 L76,142 Q62,156 44,146 Z',h);
      case 'longDark': return P('M46,100 Q40,36 100,36 Q160,36 154,100 Q160,140 162,172 Q144,182 130,164 L70,164 Q56,182 38,172 Q40,140 46,100 Z',h);
      case 'curlyWig': return curls([[50,80],[44,104],[44,128],[48,152],[60,170],[150,80],[156,104],[156,128],[152,152],[140,170],[64,56],[136,56],[100,44],[80,46],[120,46]],16,h);
      case 'fullWig': return curls([[48,78],[40,102],[38,128],[40,154],[50,178],[66,190],[152,78],[160,102],[162,128],[160,154],[150,178],[134,190],[62,52],[138,52],[100,38],[80,40],[120,40]],19,h);
      case 'bunCap': return P('M52,104 Q48,44 100,44 Q152,44 148,104 L148,124 L52,124 Z',h);
      default: return '';
    }
  }
  function hairFront(c){
    const h=c.hairColor;
    switch(c.hair){
      case 'wigRolls': return P('M54,98 Q50,44 100,42 Q150,44 146,98 Q138,66 100,62 Q62,66 54,98 Z',h)+curls([[52,96],[50,114],[148,96],[150,114]],9,h);
      case 'grayBob': return P('M54,94 Q56,48 100,46 Q144,48 146,94 Q130,64 100,62 Q70,64 54,94 Z',h);
      case 'baldFringe': return P('M51,84 Q44,104 56,124 Q58,104 64,90 Z',h)+P('M149,84 Q156,104 144,124 Q142,104 136,90 Z',h)
        +'<ellipse cx="84" cy="66" rx="12" ry="6" fill="#fff" opacity=".35" transform="rotate(-20 84 66)"/>'
        +`<path d="M84,76 Q100,72 116,76 M88,82 Q100,79 112,82" stroke="${c.skinShade}" stroke-width="2" fill="none"/>`;
      case 'sweptWhite': return P('M54,92 Q50,42 98,40 Q146,40 148,90 Q144,64 122,58 Q98,52 74,62 Q60,72 54,92 Z',h)
        +P('M50,96 Q48,112 56,120 Q56,106 60,98 Z',h)+P('M150,96 Q152,112 144,120 Q144,106 140,98 Z',h);
      case 'longDark': return P('M52,112 Q48,48 100,46 Q152,48 148,112 Q142,72 104,62 L100,70 L96,62 Q58,72 52,112 Z',h);
      case 'curlyWig': return curls([[62,62],[80,52],[100,50],[120,52],[138,62],[54,82],[146,82]],13,h);
      case 'fullWig': return curls([[60,58],[80,48],[100,46],[120,48],[140,58],[52,78],[148,78],[48,100],[152,100]],14,h);
      case 'capBeard': return P('M54,98 Q54,72 70,66 L130,66 Q146,72 146,98 Q140,82 130,80 L70,80 Q60,82 54,98 Z',h)
        +P('M42,76 Q44,30 100,26 Q158,30 158,76 Q100,62 42,76 Z','#b0263a')+'<path d="M46,73 Q100,59 154,73" stroke="#ffd32a" stroke-width="4" fill="none"/>';
      case 'bunCap': return P('M54,100 Q58,56 100,52 Q142,56 146,100 Q134,70 102,62 L100,66 L98,62 Q66,70 54,100 Z',h)
        +P('M58,66 Q100,24 142,66 Q100,52 58,66 Z','#ffffff')+'<path d="M60,66 Q54,100 62,142 M140,66 Q146,100 138,142" stroke="#fff" stroke-width="3" fill="none"/>';
      case 'baldSide': return P('M50,104 Q46,80 60,66 Q58,86 60,104 Z',h)+P('M150,104 Q154,80 140,66 Q142,86 140,104 Z',h)
        +`<path d="M74,60 Q100,50 128,60" stroke="${h}" stroke-width="3" fill="none"/>`+'<ellipse cx="88" cy="68" rx="11" ry="5" fill="#fff" opacity=".35" transform="rotate(-18 88 68)"/>';
      default: return '';
    }
  }
  function head(c){
    const sk=c.skin, sh=c.skinShade;
    let s=`<circle cx="53" cy="106" r="9" fill="${sk}" stroke="${OUT}" stroke-width="3"/><circle cx="147" cy="106" r="9" fill="${sk}" stroke="${OUT}" stroke-width="3"/>`;
    s+=`<ellipse cx="100" cy="102" rx="47" ry="47" fill="${sk}" stroke="${OUT}" stroke-width="3"/>`;
    s+= c.nose==='snub' ? `<ellipse cx="100" cy="114" rx="8" ry="6" fill="${sh}"/>` :
      `<path d="M100,104 Q95,116 102,117" stroke="${sh}" stroke-width="3" fill="none" stroke-linecap="round"/>`;
    return s;
  }
  function eyes(kind){
    const E=[[83,100],[117,100]];
    switch(kind){
      case 'happy': return E.map(([x,y])=>`<path d="M${x-7},${y+3} Q${x},${y-8} ${x+7},${y+3}" stroke="${OUT}" stroke-width="3.5" fill="none" stroke-linecap="round"/>`).join('');
      case 'sad': return E.map(([x,y])=>`<ellipse cx="${x}" cy="${y+1}" rx="4.5" ry="6" fill="${OUT}"/><circle cx="${x+1.5}" cy="${y-1.5}" r="2" fill="#fff"/><circle cx="${x-1.5}" cy="${y+3}" r="1" fill="#fff"/>`).join('');
      case 'wide': return E.map(([x,y])=>`<circle cx="${x}" cy="${y}" r="9.5" fill="#fff" stroke="${OUT}" stroke-width="2.5"/><circle cx="${x}" cy="${y}" r="2.6" fill="${OUT}"/>`).join('');
      case 'star': return E.map(([x,y])=>`<path d="${starPath(x,y,10,4.2)}" fill="#ffd32a" stroke="${OUT}" stroke-width="2"/>`).join('');
      case 'side': return E.map(([x,y])=>`<ellipse cx="${x+3}" cy="${y-2}" rx="5" ry="7" fill="${OUT}"/><circle cx="${x+4.5}" cy="${y-5}" r="1.8" fill="#fff"/>`).join('');
      case 'spiral': return E.map(([x,y])=>`<path d="M${x},${y} m-1,0 a1,1 0 1,1 2,0 a3,3 0 1,1 -5,0 a5,5 0 1,1 9,0 a7,7 0 1,1 -13,0" stroke="${OUT}" stroke-width="2" fill="none"/>`).join('');
      default: return '<g class="chr-eyes">'+E.map(([x,y])=>`<ellipse cx="${x}" cy="${y}" rx="5" ry="7" fill="${OUT}"/><circle cx="${x+1.8}" cy="${y-2.5}" r="1.8" fill="#fff"/>`).join('')+'</g>';
    }
  }
  function brows(kind,col){
    let lo=0, li=0, ri=0, ro=0;
    if(kind==='up'){ lo=2; li=-6; ri=-6; ro=2; }
    else if(kind==='down'){ lo=-4; li=4; ri=4; ro=-4; }
    else if(kind==='raised'){ lo=li=ri=ro=-7; }
    else if(kind==='tilt'){ lo=-8; li=-5; }
    return `<path d="M73,${86+lo} L92,${86+li} M108,${86+ri} L127,${86+ro}" stroke="${col}" stroke-width="4.5" stroke-linecap="round" fill="none"/>`;
  }
  function mouth(kind){
    const st=`stroke="${OUT}" stroke-width="3" fill="none" stroke-linecap="round"`;
    switch(kind){
      case 'grin': return `<path d="M86,122 Q100,141 114,122 Z" fill="#5a1520" stroke="${OUT}" stroke-width="2.5" stroke-linejoin="round"/><path d="M93,132 Q100,138 107,132 Q100,129 93,132Z" fill="#ff7a8a"/>`;
      case 'shout': return `<ellipse cx="100" cy="128" rx="11" ry="10" fill="#5a1520" stroke="${OUT}" stroke-width="2.5"/><ellipse cx="100" cy="133" rx="6" ry="3" fill="#ff7a8a"/>`;
      case 'o': return `<ellipse cx="100" cy="128" rx="5" ry="7" fill="#5a1520" stroke="${OUT}" stroke-width="2.5"/>`;
      case 'frown': return `<path d="M90,131 Q100,122 110,131" ${st}/>`;
      case 'wobble': return `<path d="M87,128 q3,-4 6.5,0 t6.5,0 t6.5,0 t6.5,0" ${st}/>`;
      case 'flat': return `<path d="M92,127 L108,127" ${st}/>`;
      default: return `<path d="M89,124 Q100,134 111,124" ${st}/>`;
    }
  }
  function beard(c){
    const b=c.beardColor||c.hairColor;
    if(c.facial==='full') return P('M54,100 Q56,152 100,174 Q144,152 146,100 Q134,136 100,138 Q66,136 54,100 Z',b);
    if(c.facial==='pointed') return P('M66,116 Q74,154 100,180 Q126,154 134,116 Q118,138 100,138 Q82,138 66,116 Z',b);
    return '';
  }
  function stache(c){
    const b=c.beardColor||c.hairColor;
    switch(c.facial){
      case 'full': case 'pointed': return P('M82,121 Q92,111 100,117 Q108,111 118,121 Q108,124 100,121 Q92,124 82,121 Z',b,2.5);
      case 'curled': return P('M84,120 Q92,112 100,117 Q108,112 116,120 Q122,116 124,110 Q123,123 112,122 Q106,120 100,120 Q94,120 88,122 Q77,123 76,110 Q78,116 84,120 Z',b,2)+P('M96,135 L104,135 L100,146 Z',b,2);
      case 'pencil': return `<path d="M88,119 Q100,114 112,119" stroke="${b}" stroke-width="3" fill="none" stroke-linecap="round"/>`;
      default: return '';
    }
  }
  const glasses=()=>`<g fill="none" stroke="#1a1a24" stroke-width="3"><circle cx="83" cy="100" r="12"/><circle cx="117" cy="100" r="12"/><path d="M95,99 Q100,95 105,99 M71,97 L54,93 M129,97 L146,93"/></g><path d="M76,94 L80,90 M110,94 L114,90" stroke="#fff" stroke-width="2" opacity=".7"/>`;
  const pipe=()=>`<path d="M106,127 L124,135" stroke="#3b2a20" stroke-width="4" stroke-linecap="round"/>`+P('M119,128 L133,128 L131,143 Q126,148 121,143 Z','#5a3a22',2)
    +`<circle class="chr-smoke" cx="128" cy="118" r="5" fill="#dfe3f0" opacity=".6"/><circle class="chr-smoke" style="animation-delay:1.2s" cx="130" cy="114" r="4" fill="#dfe3f0" opacity=".6"/>`;
  function torso(c){
    const o=c.outfit, o2=c.outfit2||'#fff';
    let s=P('M50,172 Q100,150 150,172 L168,266 L32,266 Z',o);
    switch(c.collar){
      case 'jabot': s+=`<path d="M70,168 L92,240 M130,168 L108,240" stroke="${o2}" stroke-width="4" fill="none"/>`
        +[[80,204],[120,204],[83,226],[117,226]].map(([x,y])=>`<circle cx="${x}" cy="${y}" r="3.5" fill="${o2}" stroke="${OUT}" stroke-width="1.5"/>`).join('')
        +P('M90,156 L110,156 Q119,176 108,198 Q100,206 92,198 Q81,176 90,156 Z','#fff',2.5)+'<path d="M89,170 Q100,176 111,170 M88,184 Q100,190 112,184" stroke="#b9bdd6" stroke-width="2" fill="none"/>'; break;
      case 'bands': s+='<path d="M84,160 Q100,170 116,160" stroke="#fff" stroke-width="5" fill="none"/>'+P('M93,163 L99,163 L98,192 L92,192 Z','#fff',2)+P('M101,163 L107,163 L108,192 L102,192 Z','#fff',2); break;
      case 'toga': s+=P('M52,176 Q92,192 150,266 L118,266 Q86,208 50,190 Z',o2,2.5)+'<path d="M70,200 Q90,230 96,266 M130,190 Q138,226 142,266" stroke="#cfc5ad" stroke-width="2" fill="none"/>'; break;
      case 'suit': s+=P('M86,158 L100,192 L114,158 Q100,152 86,158 Z','#fff',2.5)+P('M96,165 L104,165 L107,198 L100,208 L93,198 Z',o2,2)
        +P('M84,160 L100,198 L74,184 Z','#2b3040',2)+P('M116,160 L100,198 L126,184 Z','#2b3040',2); break;
      case 'rabat': s+=P('M64,170 Q100,188 136,170 L132,188 Q100,206 68,188 Z','#fff',2.5); break;
      case 'fur': s+=P('M90,160 L100,180 L110,160 Z','#fff',2)+curls([[56,176],[68,166],[82,162],[118,162],[132,166],[144,176],[58,194],[142,194]],11,o2); break;
      case 'dress': s+=P('M84,160 Q100,172 116,160 L114,172 Q100,184 86,172 Z','#fff',2.5)+`<circle cx="100" cy="182" r="4.5" fill="${o2}" stroke="${OUT}" stroke-width="1.5"/>`
        +'<path d="M60,220 Q100,232 140,220" stroke="#2c3b63" stroke-width="3" fill="none"/>'; break;
      case 'sweater': s+=P('M86,158 L94,174 L100,165 L106,174 L114,158 Q100,154 86,158 Z','#fff',2.5)
        +`<path d="M80,166 L100,200 L120,166" stroke="${o2}" stroke-width="6" fill="none"/>`
        +'<path d="M40,250 L160,250 M40,256 L160,256" stroke="#4a586b" stroke-width="2"/>'; break;
    }
    return s;
  }
  const armPath=(a,col)=>{ const [s,e,h]=a; const d=`M${s[0]},${s[1]} Q${e[0]},${e[1]} ${h[0]},${h[1]}`;
    return `<path d="${d}" stroke="${OUT}" stroke-width="22" fill="none" stroke-linecap="round"/><path d="${d}" stroke="${col}" stroke-width="16" fill="none" stroke-linecap="round"/>`; };
  const hand=(h,sk)=>`<circle cx="${h[0]}" cy="${h[1]}" r="10" fill="${sk}" stroke="${OUT}" stroke-width="3"/>`;
  function prop(kind,x,y){
    switch(kind){
      case 'orb': return `<circle class="chr-glow" cx="${x}" cy="${y-18}" r="20" fill="#a55eea" opacity=".3"/><circle cx="${x}" cy="${y-18}" r="13" fill="#2b1055" stroke="${OUT}" stroke-width="2.5"/>`
        +`<ellipse cx="${x}" cy="${y-18}" rx="8" ry="5" fill="#fff"/><circle cx="${x}" cy="${y-18}" r="3.4" fill="#ff2a6d"/><circle cx="${x-5}" cy="${y-24}" r="2" fill="#fff" opacity=".7"/>`;
      case 'scroll': return P(`M${x-16},${y-28} L${x+16},${y-28} L${x+16},${y-6} L${x-16},${y-6} Z`,'#f5e6c4',2)
        +`<circle cx="${x-16}" cy="${y-17}" r="4" fill="#d9c49a" stroke="${OUT}" stroke-width="1.5"/><circle cx="${x+16}" cy="${y-17}" r="4" fill="#d9c49a" stroke="${OUT}" stroke-width="1.5"/>`
        +`<text x="${x}" y="${y-14}" font-size="8" font-weight="900" text-anchor="middle" fill="#3b2a20" font-style="italic">P(H|E)</text>`;
      case 'cup': return P(`M${x-17},${y-16} Q${x},${y+2} ${x+17},${y-16} Z`,'#c0703a',2.5)+P(`M${x-3},${y-8} L${x+3},${y-8} L${x+5},${y+4} L${x-5},${y+4} Z`,'#c0703a',2)
        +`<path d="M${x-12},${y-14} Q${x},${y-6} ${x+12},${y-14}" stroke="#1a1206" stroke-width="2" fill="none"/>`;
      case 'pipeHand': return `<path d="M${x-14},${y-4} L${x+4},${y-2}" stroke="#3b2a20" stroke-width="4" stroke-linecap="round"/>`+P(`M${x+2},${y-12} L${x+15},${y-12} L${x+13},${y+2} Q${x+8},${y+6} ${x+4},${y+2} Z`,'#5a3a22',2);
      case 'pascaline': return P(`M${x-19},${y-26} L${x+19},${y-26} L${x+19},${y-4} L${x-19},${y-4} Z`,'#c9a227',2.5)
        +[-11,0,11].map(dx=>`<circle cx="${x+dx}" cy="${y-15}" r="4.5" fill="#3b2a20" stroke="${OUT}" stroke-width="1.5"/><path d="M${x+dx},${y-15} L${x+dx},${y-19}" stroke="#fff" stroke-width="1.5"/>`).join('');
      case 'book': return P(`M${x-20},${y-24} L${x},${y-20} L${x+20},${y-24} L${x+20},${y-4} L${x},${y} L${x-20},${y-4} Z`,'#f5e6c4',2)
        +`<path d="M${x},${y-20} L${x},${y} M${x-16},${y-17} L${x-4},${y-15} M${x-16},${y-12} L${x-4},${y-10} M${x+4},${y-15} L${x+16},${y-17} M${x+12},${y-8} L${x+17},${y-9}" stroke="#7a6a4a" stroke-width="1.3"/>`
        +`<path d="M${x+14},${y-34} L${x+6},${y-12}" stroke="#fff" stroke-width="3"/><path d="M${x+14},${y-34} Q${x+22},${y-30} ${x+12},${y-20}" fill="#fff" stroke="${OUT}" stroke-width="1.2"/>`;
      case 'urn': return [['#ff4757',-7],['#3d8bff',0],['#ffd32a',7]].map(([c,dx])=>`<circle cx="${x+dx}" cy="${y-30}" r="5" fill="${c}" stroke="${OUT}" stroke-width="1.5"/>`).join('')
        +P(`M${x-11},${y-27} L${x+11},${y-27} Q${x+20},${y-14} ${x+11},${y} L${x-11},${y} Q${x-20},${y-14} ${x-11},${y-27} Z`,'#b08850',2.5)+`<path d="M${x-14},${y-15} L${x+14},${y-15}" stroke="#7a5a30" stroke-width="2"/>`;
      case 'dice': { const die=(cx,cy,r,pips)=>`<g transform="rotate(${r} ${cx} ${cy})"><rect x="${cx-10}" y="${cy-10}" width="20" height="20" rx="4" fill="#fff" stroke="${OUT}" stroke-width="2.5"/>`
          +pips.map(([px,py])=>`<circle cx="${cx+px}" cy="${cy+py}" r="2.2" fill="#e84393"/>`).join('')+'</g>';
        return die(x-8,y-14,-14,[[-5,-5],[0,0],[5,5]])+die(x+10,y-22,18,[[-5,-5],[5,-5],[-5,5],[5,5],[0,0]]); }
      case 'lamp': return `<circle class="chr-glow" cx="${x}" cy="${y-28}" r="16" fill="#ffd32a" opacity=".35"/>`
        +P(`M${x-16},${y-10} Q${x},${y+4} ${x+16},${y-10} Q${x+22},${y-14} ${x+26},${y-12} L${x+14},${y-16} Q${x},${y-20} ${x-16},${y-10} Z`,'#c9a227',2)
        +`<path d="M${x+20},${y-14} Q${x+24},${y-34} ${x+20},${y-40} Q${x+16},${y-30} ${x+20},${y-14} Z" fill="#ff9f2a" stroke="#ffd32a" stroke-width="1.5"/>`;
      case 'slate': return P(`M${x-20},${y-34} L${x+20},${y-34} L${x+20},${y-4} L${x-20},${y-4} Z`,'#8a6a40',2.5)+`<rect x="${x-16}" y="${y-30}" width="32" height="22" fill="#24433a"/>`
        +`<text x="${x}" y="${y-13}" font-size="12" font-weight="700" text-anchor="middle" fill="#fff" font-family="serif">P(Ω)=1</text>`;
      default: return '';
    }
  }
  function fxBack(R,c){
    let s='';
    if(R.fx.includes('rays')){ s+='<g class="chr-rays">'; for(let i=0;i<12;i++){ const a=i*30*Math.PI/180, b=6*Math.PI/180;
        s+=`<path d="M100,150 L${(100+Math.cos(a-b)*200).toFixed(0)},${(150+Math.sin(a-b)*200).toFixed(0)} L${(100+Math.cos(a+b)*200).toFixed(0)},${(150+Math.sin(a+b)*200).toFixed(0)} Z" fill="${c.color}" opacity=".22"/>`; }
      s+='</g>'; }
    if(R.fx.includes('aura')) s+=`<g class="chr-aura"><path d="M36,266 Q22,180 58,138 Q56,170 76,150 Q66,96 100,52 Q134,96 124,150 Q144,170 142,138 Q178,180 164,266 Z" fill="${c.color}" opacity=".55"/>`
      +'<path d="M56,266 Q48,200 74,170 Q76,190 88,178 Q84,140 100,110 Q116,140 112,178 Q124,190 126,170 Q152,200 144,266 Z" fill="#ffd32a" opacity=".45"/></g>';
    return s;
  }
  function fxFront(R,c){
    let s='';
    if(R.fx.includes('sparkle')) s+=spark(36,62,9,'#fff',0)+spark(166,52,11,'#ffd32a',.3)+spark(168,140,7,'#fff',.6)+spark(30,150,6,'#ffd32a',.45);
    if(R.fx.includes('sweat')) s+=`<path d="M152,68 Q161,84 152,91 Q143,84 152,68 Z" fill="#7fd1ff" stroke="${OUT}" stroke-width="2"/>`;
    if(R.fx.includes('exclaim')) s+=`<text x="162" y="58" font-size="50" font-weight="900" fill="#ffd32a" stroke="${OUT}" stroke-width="3" paint-order="stroke" font-family="sans-serif">!</text>`;
    if(R.fx.includes('shock')){ for(let a=-160;a<=-20;a+=28){ const r=a*Math.PI/180;
        s+=`<path d="M${(100+Math.cos(r)*62).toFixed(0)},${(100+Math.sin(r)*62).toFixed(0)} L${(100+Math.cos(r)*78).toFixed(0)},${(100+Math.sin(r)*78).toFixed(0)}" stroke="${OUT}" stroke-width="3.5" stroke-linecap="round"/>`; } }
    if(R.fx.includes('question')) s+=`<text x="150" y="52" font-size="36" font-weight="900" fill="#fff" stroke="${OUT}" stroke-width="3" paint-order="stroke" font-family="sans-serif">?</text><text x="172" y="32" font-size="22" font-weight="900" fill="${c.color}" stroke="${OUT}" stroke-width="3" paint-order="stroke" font-family="sans-serif">?</text>`;
    if(R.fx.includes('cloud')) s+=`<g class="chr-cloud"><path d="M66,30 Q62,14 80,14 Q86,2 102,8 Q118,0 124,14 Q140,14 136,30 Z" fill="#6b7090" stroke="${OUT}" stroke-width="2.5"/><path d="M76,36 L72,46 M96,36 L92,46 M116,36 L112,46" stroke="#7fd1ff" stroke-width="3" stroke-linecap="round"/></g>`;
    if(R.fx.includes('confetti')) s+=[[30,40,'#ff4757',20],[170,30,'#2ed573',-30],[160,90,'#3d8bff',45],[40,110,'#ffd32a',-10],[100,14,'#a55eea',60]].map(([x,y,col,r])=>`<rect x="${x}" y="${y}" width="9" height="5" fill="${col}" transform="rotate(${r} ${x} ${y})"/>`).join('');
    return s;
  }
  function svg(id,rx='idle',opts={}){
    const c=byId[id]||LIST[0], R=REACT[rx]||REACT.idle, PO=POSES[R.pose];
    const vb=opts.portrait?'26 20 148 148':'0 0 200 266';
    const tilt=R.tilt||0, dy=R.dy||0;
    const pipeInMouth=!!c.pipe && ['smile','flat','frown'].includes(R.mouth);
    const propKind=c.pipe? (pipeInMouth? null : 'pipeHand') : c.prop;
    let s=`<svg viewBox="${vb}" xmlns="http://www.w3.org/2000/svg" class="chr" preserveAspectRatio="xMidYMax meet">`;
    s+=fxBack(R,c);
    s+=`<g transform="translate(0,${dy})">`;
    s+=`<g transform="rotate(${tilt} 100 150)">${hairBack(c)}</g>`;
    s+=`<rect x="89" y="136" width="22" height="26" fill="${c.skin}" stroke="${OUT}" stroke-width="3"/>`;
    s+=torso(c);
    s+=`<g transform="rotate(${tilt} 100 150)">`+head(c)+brows(R.brows,c.browColor)+eyes(R.eyes)
      +(c.glasses?glasses():'')
      +(R.blush?'<ellipse cx="70" cy="116" rx="8" ry="4.5" fill="#ff6b81" opacity=".5"/><ellipse cx="130" cy="116" rx="8" ry="4.5" fill="#ff6b81" opacity=".5"/>':'')
      +(R.fx.includes('tears')?'<path d="M80,108 Q77,126 82,142 M120,108 Q123,126 118,142" stroke="#7fd1ff" stroke-width="4.5" fill="none" stroke-linecap="round"/>':'')
      +beard(c)+mouth(R.mouth)+stache(c)+(pipeInMouth?pipe():'')+hairFront(c)+'</g>';
    s+=armPath(PO.L,c.outfit)+armPath(PO.R,c.outfit);
    const ph = PO.prop==='R'? PO.R[2] : PO.prop==='L'? PO.L[2] : null;
    if(ph && propKind) s+=prop(propKind,ph[0],ph[1]);
    s+=hand(PO.L[2],c.skin)+hand(PO.R[2],c.skin);
    s+='</g>'+fxFront(R,c)+'</svg>';
    return s;
  }
  function line(id,key){ const c=byId[id]||LIST[0]; const a=(c.lines&&c.lines[key])||['…']; return a[Math.floor(Math.random()*a.length)]; }
  return {list:()=>LIST.slice(), get:(id,strict)=> byId[id] || (strict? null : LIST[1]), svg, line, reactions:Object.keys(REACT)};
})();
</script>
<script>
/*DANSE-START*/
/* =================== DanseAnalysis — beat tracking for any track (pure JS) =================== */
const DanseAnalysis = (() => {
  function fft(re, im){ // in-place radix-2
    const n=re.length;
    for(let i=1,j=0;i<n;i++){ let bit=n>>1; for(;j&bit;bit>>=1) j^=bit; j^=bit;
      if(i<j){ let t=re[i]; re[i]=re[j]; re[j]=t; t=im[i]; im[i]=im[j]; im[j]=t; } }
    for(let len=2;len<=n;len<<=1){ const ang=-2*Math.PI/len, wr=Math.cos(ang), wi=Math.sin(ang);
      for(let i=0;i<n;i+=len){ let cr=1, ci=0;
        for(let k=0;k<len/2;k++){ const a=i+k, b=a+len/2;
          const tr=re[b]*cr-im[b]*ci, ti=re[b]*ci+im[b]*cr;
          re[b]=re[a]-tr; im[b]=im[a]-ti; re[a]+=tr; im[a]+=ti;
          const ncr=cr*wr-ci*wi; ci=cr*wi+ci*wr; cr=ncr; } } }
  }
  // mono Float32Array + sampleRate → {bpm, period, beats[], downbeatPhase, energy[], duration}
  function analyze(mono, sr, onProgress){
    // 1. downsample to ~11 kHz
    const f=Math.max(1,Math.round(sr/11025)), sr2=sr/f, n2=Math.floor(mono.length/f);
    const x=new Float32Array(n2);
    for(let i=0;i<n2;i++){ let s=0; for(let k=0;k<f;k++) s+=mono[i*f+k]; x[i]=s/f; }
    // 2. STFT → spectral flux (full band + low band) + RMS
    const N=512, H=128, frames=Math.max(1,Math.floor((n2-N)/H)), win=new Float32Array(N);
    for(let i=0;i<N;i++) win[i]=0.5-0.5*Math.cos(2*Math.PI*i/N);
    const flux=new Float32Array(frames), low=new Float32Array(frames), rms=new Float32Array(frames);
    let prev=new Float32Array(N/2), re=new Float32Array(N), im=new Float32Array(N);
    const lowBin=Math.max(2,Math.round(160/(sr2/N)));
    for(let t=0;t<frames;t++){
      let e=0;
      for(let i=0;i<N;i++){ const v=x[t*H+i]; re[i]=v*win[i]; im[i]=0; e+=v*v; }
      rms[t]=Math.sqrt(e/N);
      fft(re,im);
      let fl=0, lf=0;
      for(let k=1;k<N/2;k++){ const m=Math.log1p(100*Math.hypot(re[k],im[k])); const d=m-prev[k];
        if(d>0){ fl+=d; if(k<=lowBin) lf+=d; } prev[k]=m; }
      flux[t]=fl; low[t]=lf;
      if(onProgress && t%4000===0) onProgress(t/frames*0.7);
    }
    const fps=sr2/H;
    // 3. onset envelope: remove local mean, rectify, normalise
    const W=Math.round(fps*0.4), env=new Float32Array(frames);
    let acc=0; const cs=new Float64Array(frames+1); for(let t=0;t<frames;t++){ cs[t+1]=cs[t]+flux[t]; }
    for(let t=0;t<frames;t++){ const a=Math.max(0,t-W), b=Math.min(frames,t+W+1); const m=(cs[b]-cs[a])/(b-a); env[t]=Math.max(0,flux[t]-m); }
    let sd=0; for(let t=0;t<frames;t++) sd+=env[t]*env[t]; sd=Math.sqrt(sd/frames)||1;
    for(let t=0;t<frames;t++) env[t]/=sd;
    // 4. tempo: autocorrelation with log-normal prior centred on 120 BPM
    const minLag=Math.floor(fps*60/200), maxLag=Math.ceil(fps*60/60);
    const acf=new Float32Array(maxLag+2);
    for(let L=minLag;L<=maxLag+1;L++){ let s=0; for(let t=L;t<frames;t++) s+=env[t]*env[t-L]; acf[L]=s/(frames-L); }
    let best=minLag, bestV=-1;
    for(let L=minLag;L<=maxLag;L++){ const bpm=60*fps/L; const w=Math.exp(-0.5*Math.pow(Math.log2(bpm/120)/0.9,2));
      const comb=acf[L]+0.5*(acf[2*L]||0)+0.25*((acf[Math.round(L/2)]||0));
      const v=w*comb; if(v>bestV){ bestV=v; best=L; } }
    // parabolic refinement
    let lag=best; const a0=acf[best-1], a1=acf[best], a2=acf[best+1];
    const den=a0-2*a1+a2; if(den<0) lag=best+0.5*(a0-a2)/den;
    const bpm=60*fps/lag, P=lag;
    if(onProgress) onProgress(0.8);
    // 5. dynamic-programming beat tracker (Ellis 2007)
    const tight=100, score=new Float32Array(frames), back=new Int32Array(frames).fill(-1);
    for(let t=0;t<frames;t++){
      let bv=-1e9, bi=-1; const lo=Math.max(0,Math.floor(t-2*P)), hi=Math.floor(t-P/2);
      for(let s=lo;s<=hi;s++){ const v=score[s]-tight*Math.pow(Math.log((t-s)/P),2); if(v>bv){ bv=v; bi=s; } }
      score[t]=env[t]+(bi>=0? Math.max(0,bv) : 0); back[t]=bv>0? bi : -1;
    }
    // best end within the last period
    let end=frames-1, ev=-1e9; for(let t=Math.max(0,Math.floor(frames-P));t<frames;t++) if(score[t]>ev){ ev=score[t]; end=t; }
    let beatsF=[]; for(let t=end;t>=0;t=back[t]) { beatsF.push(t); if(back[t]<0) break; }
    beatsF.reverse();
    // 6. trim silent head/tail (smoothed RMS below 12% of the 95th percentile)
    const sm=new Float32Array(frames), R=Math.round(fps*1.0); const cr=new Float64Array(frames+1);
    for(let t=0;t<frames;t++) cr[t+1]=cr[t]+rms[t];
    for(let t=0;t<frames;t++){ const a=Math.max(0,t-R), b=Math.min(frames,t+R+1); sm[t]=(cr[b]-cr[a])/(b-a); }
    const sorted=Array.from(sm).sort((p,q)=>p-q), p95=sorted[Math.floor(sorted.length*0.95)]||1;
    beatsF=beatsF.filter(t=>sm[t]>0.12*p95);
    const beats=beatsF.map(t=>(t*H+N/2)/sr2);
    // 7. bar phase from low-band (kick) onsets
    let phase=0, pv=-1;
    for(let ph=0;ph<4;ph++){ let s=0; for(let i=ph;i<beatsF.length;i+=4){ const t=beatsF[i]; s+=low[t]+0.5*(low[t+1]||0); } if(s>pv){ pv=s; phase=ph; } }
    // 8. per-beat energy (0..1), smoothed over 2 bars
    const eb=beatsF.map((t,i)=>{ const b=beatsF[i+1]||Math.min(frames-1,t+Math.round(P)); let s=0; for(let k=t;k<b;k++) s+=rms[k]; return s/Math.max(1,b-t); });
    const es=eb.map((_,i)=>{ let s=0,c=0; for(let k=i-4;k<=i+4;k++) if(eb[k]!=null){ s+=eb[k]; c++; } return s/c; });
    const emax=[...es].sort((p,q)=>p-q)[Math.floor(es.length*0.95)]||1;
    const energy=es.map(v=>Math.min(1,v/emax));
    // onset strength at half-beats (for off-beat notes)
    const half=beatsF.map((t,i)=>{ const b=beatsF[i+1]; if(b==null) return 0; const m=Math.round((t+b)/2); return Math.max(env[m-1]||0,env[m]||0,env[m+1]||0); });
    const strength=beatsF.map(t=>Math.max(env[t-1]||0,env[t]||0,env[t+1]||0));
    if(onProgress) onProgress(1);
    const ibis=beats.slice(1).map((b,i)=>b-beats[i]).sort((p,q)=>p-q);
    const ibi=ibis.length? ibis[ibis.length>>1] : 60/bpm;   // tracked tempo (more precise than the ACF estimate)
    return {bpm:60/ibi, period:ibi, beats, downbeatPhase:phase, energy, half, strength, duration:mono.length/sr};
  }
  return {analyze};
})();

/* =================== DANSE MODE — rhythm × prediction =================== */
const Danse = (() => {
  const $=id=>document.getElementById(id);
  const KEYVALS=[0.05,0.25,0.5,0.75,0.95];
  const KCOL=['#ff4757','#ff8a9a','#8b90c0','#7fe0a5','#2ed573'];
  const KNAME=['sure ✕','likely ✕','no idea','likely ✔','sure ✔'];
  const LAYOUTS={
    diamond:{name:'DIAMOND', codes:['KeyX','KeyA','KeyS','KeyD','KeyW'], hint:'Diamond: down = rejected · up = accepted · centre = no idea'},
    row:{name:'ROW', codes:['KeyD','KeyF','Space','KeyJ','KeyK'], hint:'Row: left hand = rejected · thumbs = no idea · right hand = accepted'}
  };
  const ALWAYS={Numpad2:0,Numpad4:1,Numpad5:2,Numpad6:3,Numpad8:4,ArrowDown:0,ArrowLeft:1,ArrowRight:3,ArrowUp:4};
  const WINDOWS=[[0.045,'PERFECT',1,'#ffd32a'],[0.09,'GREAT',.75,'#2ed573'],[0.135,'GOOD',.5,'#3d8bff'],[0.185,'OK',.25,'#a55eea']];
  const MISS_W=0.185, SWAP_AFTER=10, LEAD=3.0;
  const DIFFS={
    easy:{name:'EASY', color:'#2ed573', stars:'★☆☆', lanes:1, target:1.6, approach:2.8,
      desc:'1 track · 4 parameters (shape, colour, size, symbol) · simple rules',
      ladders:[{dims:{shape:3,color:3,size:3,symbol:3}, tiers:[[0],[0],[0,1],[1],[1],[0,1,2]]}]},
    hard:{name:'HARD', color:'#ff7f2a', stars:'★★☆', lanes:1, target:0.8, approach:2.3,
      desc:'1 track · 6 parameters · relational, numeric & combined rules',
      ladders:[{dims:{shape:5,color:5,size:3,symbol:5,style:4,count:6}, tiers:[[1,2],[2,3],[3],[3,4],[4],[4,5],[5]]}]},
    epic:{name:'EPIC', color:'#a55eea', stars:'★★★', lanes:3, target:0.78, approach:2.6,
      desc:'3 tracks at once · 3 independent rules · 4 to 6 parameters',
      ladders:[{dims:{shape:3,color:3,size:3,symbol:3}, tiers:[[0,1],[1],[1,2],[2]]},
               {dims:{shape:4,color:4,size:3,symbol:4,style:3}, tiers:[[1,2],[2,3],[3],[3,4]]},
               {dims:{shape:5,color:5,size:3,symbol:5,style:4,count:6}, tiers:[[2,3],[3,4],[4],[4,5]]}]},
  };
  const LANES=[{name:'TRACK α',color:'#3d8bff'},{name:'TRACK β',color:'#ff7f2a'},{name:'TRACK γ',color:'#2ed573'}];
  let hooks=null, open=false, view='setup';
  const settings={diff:'easy', layout:'diamond', speed:1, offset:0, hitSfx:true, track:0};
  const tracks=[];
  let dac=null, G=null, raf=null, keyLabels={}, builtinsLoaded=0;
  const ctxA=()=>{ if(!dac) dac=new (window.AudioContext||window.webkitAudioContext)(); if(dac.state==='suspended' && !(G&&G.paused)) dac.resume(); return dac; };
  const wait=ms=>new Promise(r=>setTimeout(r,ms));
  const mulberry=a=>()=>{ a|=0; a=a+0x6D2B79F5|0; let t=Math.imul(a^a>>>15,1|a); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; };
  const fmtTime=s=>Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0');
  const turbo=()=>hooks&&hooks.isTurbo();

  /* ---------- tracks ---------- */
  function syncBuiltins(){
    const list=window.DANSE_TRACKS||[];
    for(;builtinsLoaded<list.length;builtinsLoaded++){
      const t=list[builtinsLoaded];
      tracks.splice(builtinsLoaded,0,{title:t.title, subtitle:t.subtitle||'', builtin:true,
        getBytes:async()=>{ if(t.b64){ const bin=atob(t.b64), u=new Uint8Array(bin.length); for(let i=0;i<bin.length;i++) u[i]=bin.charCodeAt(i); return u.buffer; }
          const r=await fetch(t.url); return await r.arrayBuffer(); }});
    }
  }
  function addTrack(bytes,title){ syncBuiltins(); tracks.push({title, subtitle:'your file', getBytes:async()=>bytes}); return tracks.length-1; }
  async function prepare(track,status=()=>{}){
    if(track.ana) return track;
    if(track.busy) return track.busy;
    track.busy=(async()=>{
      status('Loading audio…'); await wait(20);
      const bytes=await track.getBytes();
      status('Decoding…'); await wait(20);
      const ac=ctxA();
      track.audio=await new Promise((res,rej)=>{ const p=ac.decodeAudioData(bytes.slice(0),res,rej); if(p&&p.then) p.then(res,rej); });
      status('Detecting the beat…'); await wait(20);
      const b=track.audio, n=b.length, mono=new Float32Array(n), C=b.numberOfChannels;
      for(let c=0;c<C;c++){ const d=b.getChannelData(c); for(let i=0;i<n;i++) mono[i]+=d[i]/C; }
      track.ana=DanseAnalysis.analyze(mono,b.sampleRate);
      track.busy=null;
      return track;
    })();
    return track.busy;
  }

  /* ---------- chart ---------- */
  function pickK(period,target){ let best=1,bv=1e9; for(const k of [1,2,4,8]){ const v=Math.abs(Math.log(k*period/target)); if(v<bv){bv=v;best=k;} } return best; }
  function buildChart(ana,diff,rng){
    const D=DIFFS[diff], k=pickK(ana.period,D.target), B=ana.beats, notes=[];
    const minGap=2*MISS_W+0.02, ph=ana.downbeatPhase;
    for(let i=0;i<B.length;i++){
      const e=ana.energy[i]; if(e<0.33) continue;
      const kk=(diff!=='easy' && e<0.6)? k*2 : k;
      const pos=((i-ph)%k+k)%k, pos2=((i-ph)%kk+kk)%kk;
      let place=pos2===0;
      if(!place && diff!=='easy' && e>0.82 && k>=2 && pos===k/2 && (ana.strength[i]||0)>1.6 && rng()<0.45) place=true;
      if(!place) continue;
      const t=B[i];
      if(t<0.4 || t>ana.duration-1.0) continue;
      if(notes.length && t-notes[notes.length-1].t<minGap) continue;
      notes.push({t, beat:i, lane:0, state:'pending'});
    }
    if(D.lanes>1){ let bag=[], last=-1, run=0;
      notes.forEach(n=>{ if(!bag.length) bag=[...Array(D.lanes).keys()].sort(()=>rng()-.5);
        let l=bag.pop(); if(l===last && run>=1 && bag.length){ bag.unshift(l); l=bag.pop(); }
        run = l===last? run+1 : 0; last=l; n.lane=l; }); }
    return {notes, k};
  }

  /* ---------- run lifecycle ---------- */
  function laneCfg(l,idx){ const lad=G.D.ladders[l]; return {name:`${G.D.name} · ${LANES[l].name} · rule ${idx+1}`, dims:lad.dims, tiers:lad.tiers[Math.min(idx,lad.tiers.length-1)]}; }
  function newLaneGame(l,idx){ return Engine.newGame(0,(G.rng()*2**31)|0,laneCfg(l,idx)); }
  async function start(opts={}){
    for(const k of ['diff','layout','speed','offset','hitSfx','track']) if(opts[k]!=null) settings[k]=opts[k];
    if(opts.difficulty) settings.diff=opts.difficulty;
    if(!DIFFS[settings.diff]) throw new Error('Unknown difficulty: '+settings.diff+' (easy | hard | epic)');
    syncBuiltins();
    const track=tracks[settings.track]; if(!track) throw new Error('No track #'+settings.track+'. See arena.danse.tracks() or arena.danse.loadTrack().');
    if(!open) openSetup();
    stopRun();
    $('dsGo').disabled=true;
    try{ await prepare(track,setStatus); } catch(e){ $('dsGo').disabled=false; setStatus('⚠ Could not decode this file: '+e.message); throw e; }
    $('dsGo').disabled=false;
    const seed=opts.seed!=null? opts.seed|0 : (Math.random()*2**31)|0;
    const D=DIFFS[settings.diff], rng=mulberry(seed);
    G={seed, rng, track, ana:track.ana, D, diff:settings.diff, approach:D.approach/settings.speed, offset:settings.offset/1000,
       lanes:[], live:[], nextNote:0, ids:0, score:0, disp:0, combo:0, maxCombo:0, n:0, sumT:0, sumB:0, cracked:0, history:[],
       counts:{PERFECT:0,GREAT:0,GOOD:0,OK:0,MISS:0}, beatPtr:0, lastBeatT:-9, paused:false, ended:false, stopped:false, cd:null, lastRx:0};
    const ch=buildChart(G.ana,G.diff,rng); G.notes=ch.notes; G.k=ch.k;
    G.bounds=G.ana.beats.filter((_,i)=>((i-G.ana.downbeatPhase)%16+16)%16===0);
    for(let l=0;l<D.lanes;l++) G.lanes.push({l, ...LANES[l], ruleIdx:0, game:newLaneGame(l,0), nextGame:null, swapAt:Infinity, correct:0, cards:0, revealed:[], fresh:false});
    showView('play'); buildLanes(); renderKeys(); updateHud(true);
    $('dTrackName').innerHTML=`${esc(track.title)}<small>${D.name} · ${G.ana.bpm.toFixed(0)} BPM · ÷${G.k}</small>`;
    $('dProgress').querySelectorAll('.dMark').forEach(m=>m.remove());
    $('dJudge').innerHTML='<div class="jt">READY?</div><div class="js">bet when the card hits the frame</div>';
    dReact('select',1800); dSay(hooks.getChar().lines? pickLine('select') : 'Let us dance.');
    const ac=ctxA(); if(ac.state==='suspended') await ac.resume();
    G.src=ac.createBufferSource(); G.src.buffer=track.audio;
    G.gain=ac.createGain(); G.gain.gain.value=0.9; G.an=ac.createAnalyser(); G.an.fftSize=256; G.fq=new Uint8Array(G.an.frequencyBinCount);
    G.src.connect(G.gain); G.gain.connect(G.an); G.an.connect(ac.destination);
    G.startAt=ac.currentTime+LEAD; G.src.start(G.startAt);
    hooks.pauseBgm();
    cancelAnimationFrame(raf); raf=requestAnimationFrame(loop);
    hooks.emit({type:'danse-start', difficulty:G.diff, track:track.title, bpm:G.ana.bpm, seed, notes:G.notes.length});
    return getState();
  }
  function stopRun(){
    if(!G) return; G.stopped=true; G.ended=true;
    try{ G.src && G.src.stop(); }catch(e){}
    cancelAnimationFrame(raf); raf=null;
    $('dLanes').innerHTML=''; $('dBanner').classList.add('hidden'); $('dPause').classList.add('hidden'); $('dResults').classList.add('hidden');
    if(dac && dac.state==='suspended') dac.resume();
  }
  function songAt(perfMs){
    if(!G) return 0;
    if(G.paused) return G.pauseT;
    const ac=dac; let t=null;
    if(ac.getOutputTimestamp){ const o=ac.getOutputTimestamp(); if(o && o.performanceTime>0 && o.contextTime>0) t=o.contextTime+(perfMs-o.performanceTime)/1000; }
    if(t==null) t=ac.currentTime-(ac.outputLatency||0);
    return t-G.startAt-G.offset;
  }
  const songNow=()=>songAt(performance.now());

  /* ---------- main loop ---------- */
  function loop(){ if(!G||G.ended) return; raf=requestAnimationFrame(loop); if(!G.paused) frame(); }
  function frame(){
    const now=songNow();
    countdown(now);
    while(G.nextNote<G.notes.length && G.notes[G.nextNote].t-G.approach<=now){ const n=G.notes[G.nextNote++]; if(n.state!=='cut') spawn(n); }
    sweep(now);
    for(const L of G.lanes) if(now>=L.swapAt && !G.live.some(n=>n.lane===L.l && n.rule===L.ruleIdx)) doSwap(L);
    for(const n of G.live) place(n,now);
    while(G.beatPtr<G.ana.beats.length && G.ana.beats[G.beatPtr]<=now) onBeat(G.beatPtr++);
    const e=G.ana.energy[Math.max(0,G.beatPtr-1)]||0;
    $('danse').style.setProperty('--pulse', (Math.exp(-(now-G.lastBeatT)*7)*(0.35+0.65*e)).toFixed(3));
    G.disp+= (G.score-G.disp)*0.18; $('dScore').textContent=Math.round(G.disp).toLocaleString('en-US');
    $('dProgFill').style.width=Math.max(0,Math.min(100,now/G.ana.duration*100))+'%';
    drawEq();
    if(now>G.ana.duration+0.4 && G.live.length===0 && G.nextNote>=G.notes.length) finish();
  }
  function countdown(now){
    let v=null;
    if(now<0) v=String(Math.ceil(-now)); else if(now<0.7) v='DANSE!';
    if(v!==G.cd){ G.cd=v; const c=$('dCount');
      if(v){ c.textContent=v; FX.restart(c,'go'); v==='DANSE!'? SFX.confirm() : SFX.thump(); } }
  }
  function onBeat(i){
    G.lastBeatT=G.ana.beats[i];
    const down=((i-G.ana.downbeatPhase)%4+4)%4===0;
    if(down && !turbo()) FX.restart($('dBg'),'down');
    FX.rush(G.combo>=20);
  }
  function buildLanes(){
    const host=$('dLanes'); host.innerHTML='';
    const many=G.lanes.length>1;
    G.lanes.forEach(L=>{
      const el=document.createElement('div'); el.className='lane'; el.style.setProperty('--lc',L.color); el.style.setProperty('--lcA',L.color+'66');
      el.innerHTML=`<div class="laneHead"><b>${L.name}</b><span class="lr"></span><span class="pips"></span><span class="laneStatus"></span></div>
        <div class="laneBody"><span class="chainLbl">ACCEPTED SEQUENCE ◀</span><div class="chain"></div><div class="rejs"></div><div class="frame"></div><div class="cards"></div></div>`;
      host.appendChild(el);
      L.el=el; L.body=el.querySelector('.laneBody'); L.chainEl=el.querySelector('.chain'); L.rejEl=el.querySelector('.rejs');
      L.frameEl=el.querySelector('.frame'); L.cardsEl=el.querySelector('.cards');
      L.pipsEl=el.querySelector('.pips'); L.statusEl=el.querySelector('.laneStatus'); L.ruleEl=el.querySelector('.lr');
      L.pipsEl.innerHTML=Array.from({length:SWAP_AFTER+1},()=>'<i class="pip"></i>').join('');
      updateLaneHead(L);
    });
    measure(); requestAnimationFrame(measure);
    host.dataset.many=many?'1':'';
  }
  function measure(){
    if(!G) return;
    G.lanes.forEach(L=>{ const w=L.body.clientWidth||900, h=L.body.clientHeight||200;
      L.w=w; L.cw=Math.max(40,Math.min(96,Math.floor(h/1.3*0.78))); L.fx=Math.round(Math.max(w*0.3, L.cw*3.2));
      L.body.style.setProperty('--fx',L.fx+'px'); L.body.style.setProperty('--fw',L.cw+'px'); });
    const eq=$('dEq'); eq.width=eq.clientWidth||innerWidth; eq.height=eq.clientHeight||300;
  }
  addEventListener('resize',()=>{ if(G && !G.ended) measure(); });
  function randItem(params){ const r=G.rng, pk=a=>a[Math.floor(r()*a.length)];
    return {shape:pk(params.shape), color:pk(params.color), symbol:params.symbol?pk(params.symbol):null, size:params.size?pk(params.size):null,
            style:params.style?pk(params.style):null, count:params.count?1+Math.floor(r()*params.count):null}; }
  function spawn(n){
    const L=G.lanes[n.lane], after=n.t>=L.swapAt, g=after? L.nextGame : L.game;
    n.rule=L.ruleIdx+(after?1:0); n.item=randItem(g.getState().params); n.state='live'; n.id=++G.ids;
    const el=document.createElement('div'); el.className='dcard';
    if(after && !L.fresh){ L.fresh=true; el.classList.add('fresh'); }
    el.innerHTML=`<div class="dci">${Render.itemSVG(n.item,L.cw)}</div>`;
    el.dataset.item=JSON.stringify(n.item); el.dataset.lane=n.lane; el.dataset.t=n.t.toFixed(3);
    L.cardsEl.appendChild(el); n.el=el; G.live.push(n); place(n,songNow());
  }
  function place(n,now){ const L=G.lanes[n.lane];
    const x=L.fx+(n.t-now)/G.approach*(L.w-L.fx+L.cw*0.6);
    n.el.style.transform=`translate(${(x-L.cw/2).toFixed(1)}px,-50%)`; }
  function sweep(now){ for(const n of G.live.slice()) if(now>n.t+MISS_W) judge(n,null,null); }

  /* ---------- input ---------- */
  function keyIndex(code){ const i=LAYOUTS[settings.layout].codes.indexOf(code); if(i>=0) return i; if(code==='Space') return 2; return ALWAYS[code]; }
  function handleKey(e){
    if(!open) return false;
    if(view==='play' && G && !G.ended){
      if(e.code==='Escape'||e.code==='KeyP'){ e.preventDefault(); G.paused? resume() : pause(); return true; }
      if(G.paused) return true;
      const idx=keyIndex(e.code);
      if(idx!=null){ e.preventDefault(); if(!e.repeat) press(KEYVALS[idx], e.timeStamp||performance.now(), idx); }
      return true;
    }
    if(view==='setup'){ if(e.key==='Enter'){ e.preventDefault(); go(); } else if(e.key==='Escape') close(); return true; }
    if(view==='results'){ if(e.key==='Enter'){ e.preventDefault(); go(); } else if(e.key==='Escape') showView('setup'); return true; }
    return true;
  }
  function press(p,perfMs,keyIdx){
    if(!G||G.ended||G.paused) return null;
    if(!(p>=0&&p<=1)) throw new Error('press(p) needs a probability between 0 and 1.');
    const t=songAt(perfMs);
    sweep(t);
    let best=null, bd=1e9; for(const n of G.live){ const d=Math.abs(t-n.t); if(d<bd){bd=d;best=n;} }
    lightKey(keyIdx!=null? keyIdx : KEYVALS.reduce((bi,v,i)=>Math.abs(v-p)<Math.abs(KEYVALS[bi]-p)?i:bi,0));
    if(best && bd<=MISS_W){ judge(best,p,t-best.t); return best.out; }
    if(settings.hitSfx) SFX.tick();
    return null;
  }
  function lightKey(i){ const k=$('dKeys').children[i]; if(!k) return; k.classList.add('hit'); setTimeout(()=>k.classList.remove('hit'),110); }

  /* ---------- judging: rhythm × Brier ---------- */
  function judge(n,p,dt){
    const L=G.lanes[n.lane];
    if(n.rule>L.ruleIdx) doSwap(L);
    const miss=p==null, bet=miss? 0.5 : p;
    const r=L.game.play(n.item,bet);
    G.live.splice(G.live.indexOf(n),1); n.state='done';
    const w=miss? null : WINDOWS.find(([lim])=>Math.abs(dt)<=lim);
    const T=w? w[2]:0, grade=w? w[1]:'MISS', brier=r.bet.brier, S=1-brier/0.25;
    const side=!miss && bet!==0.5, correct=side && ((bet>0.5)===r.accepted);
    L.cards++; if(correct) L.correct++;
    if(miss||S<0) G.combo=0; else if(S>0 && T>0) G.combo++;
    G.maxCombo=Math.max(G.maxCombo,G.combo);
    let pts=300*T+700*S; if(pts>0) pts*=1+Math.min(G.combo,40)/40; pts=Math.round(pts);
    G.score+=pts; G.n++; G.sumT+=T; G.sumB+=brier; G.counts[grade]++;
    const rec={lane:n.lane, rule:n.rule, t:+n.t.toFixed(3), dt:miss?null:+dt.toFixed(4), p:bet, accepted:r.accepted, brier:+brier.toFixed(4), timing:grade, correct, points:pts};
    G.history.push(rec); n.out=rec;
    feedback(n,L,r,w,T,S,pts,dt,miss,brier,bet);
    if(L.correct>SWAP_AFTER && L.swapAt===Infinity) scheduleSwap(L);
    updateLaneHead(L); updateHud();
    hooks.emit({type:'danse-hit', ...rec, item:n.item});
  }
  function feedback(n,L,r,w,T,S,pts,dt,miss,brier,bet){
    const el=n.el, acc=r.accepted;
    el.classList.add(acc?'acc':'rej'); if(miss) el.classList.add('miss');
    const v=document.createElement('div'); v.className='verd'; v.textContent=acc?'✔':'✕'; v.style.color=acc?'#2ed573':'#ff4757'; el.appendChild(v);
    setTimeout(()=>el.remove(),650);
    setTimeout(()=>{
      const box=acc? L.chainEl : L.rejEl, sz=acc? Math.round(L.cw*0.62) : Math.round(L.cw*0.36);
      const c=document.createElement('div'); c.className=acc?'ch':'rj'; c.innerHTML=Render.itemSVG(n.item,sz);
      box.insertBefore(c,box.firstChild); while(box.children.length>(acc?9:10)) box.lastChild.remove();
    }, acc?220:120);
    const good=S>1e-9, bad=S<-1e-9;
    L.frameEl.style.setProperty('--fc', good?'rgba(46,213,115,.55)':bad?'rgba(255,71,87,.55)':'rgba(139,144,192,.35)');
    FX.restart(L.frameEl,'hitflash');
    const tcol=w? w[3] : '#8b90c0';
    const pl = miss? '<span style="color:#8b90c0">no bet · counted as 50%</span>'
      : bet===0.5? '<span style="color:#8b90c0">50% · no prediction</span>'
      : good? `<span style="color:#2ed573">${acc?'✔':'✕'} called it! · brier ${brier.toFixed(2)}</span>`
      : `<span style="color:#ff4757">${acc?'✔':'✕'} busted · brier ${brier.toFixed(2)}</span>`;
    $('dJudge').innerHTML=`<div class="jt" style="color:${tcol}">${w? w[1] : 'MISS'}</div><div class="jp">${pl}</div>
      <div class="js">${miss?'too late!': (dt<0? Math.round(-dt*1000)+' ms early' : Math.round(dt*1000)+' ms late')}</div><div class="jpts">${pts>=0?'+':''}${pts}</div>`;
    FX.restart($('dJudge'),'pop');
    if(!miss){ const tk=document.createElement('i'); tk.className='tk'; tk.style.left=(50+Math.max(-1,Math.min(1,dt/MISS_W))*47)+'%'; tk.style.background=tcol; $('dTiming').appendChild(tk); setTimeout(()=>tk.remove(),2600);
      while($('dTiming').querySelectorAll('.tk').length>12) $('dTiming').querySelector('.tk').remove(); }
    if(turbo()) return;
    const fr=L.frameEl.getBoundingClientRect(), cx=fr.left+fr.width/2, cy=fr.top+fr.height/2;
    const now=performance.now(), canReact=now-G.lastRx>380;
    if(good){
      const m=S;
      if(settings.hitSfx) SFX.goodBet(m,G.combo);
      FX.ring(cx,cy,acc?'#2ed573':'#ffd32a'); FX.burst(cx,cy,Math.round(6+m*22),4+m*4,[L.color,'#fff','#ffd32a']);
      if(G.combo>0 && G.combo%10===0){ FX.comboBurst(G.combo); SFX.combo(); FX.onoma('ゴゴゴゴ','COMBO '+G.combo,'#a55eea',-8); FX.punch(); dReact('combo',1600); dSay(pickLine('combo')); G.lastRx=now; }
      else if(canReact && m>0.8){ dReact('win',900); G.lastRx=now; if(T===1 && Math.random()<.35) FX.onoma('キラーン!','SHING!','#2ed573',-6); }
    } else if(bad){
      const m=(brier-0.25)/0.75;
      if(settings.hitSfx) SFX.badBet(m);
      FX.glow('bad'); FX.shake(0.4+m*2.4); FX.ring(cx,cy,'#ff4757');
      if(brier>=0.81){ FX.impact(); FX.onoma('ドーン!!','DOOM','#ff4757',-10); dReact('shocked',1300); if(Math.random()<.5) dSay(pickLine('shocked')); G.lastRx=now; }
      else if(canReact){ dReact('lose',900); G.lastRx=now; }
    } else if(miss){ if(settings.hitSfx) SFX.neutral(); if(canReact){ dReact('thinking',700); G.lastRx=now; } }
    else if(settings.hitSfx) SFX.tick();
  }

  /* ---------- rule swap at the next break ---------- */
  function scheduleSwap(L){
    const now=songNow(), earliest=now+G.approach+0.15, gapLen=Math.max(2.2, 6*G.ana.period);
    const ln=G.notes.filter(n=>n.lane===L.l && n.state!=='cut');
    let cand=Infinity, kind='';
    for(let j=0;j<ln.length;j++){ const a=ln[j], b=ln[j+1]; const st=a.t+MISS_W+0.03;
      if(st<earliest) continue; if(st>earliest+12) break;
      if(!b || b.t-st>=gapLen){ cand=st; kind='break'; break; } }
    const bnd=G.bounds.find(t=>t>=earliest);
    if(bnd!=null && bnd<cand && bnd<G.ana.duration-gapLen-1){
      G.notes.forEach(n=>{ if(n.lane===L.l && n.state==='pending' && n.t>=bnd-0.01 && n.t<bnd+gapLen) n.state='cut'; });
      cand=bnd; kind='phrase';
    }
    if(!isFinite(cand)) return;
    L.swapAt=cand; L.fresh=false; L.nextGame=newLaneGame(L.l,L.ruleIdx+1);
    const m=document.createElement('div'); m.className='dMark'; m.style.left=(cand/G.ana.duration*100)+'%'; m.style.setProperty('--mc',L.color); $('dProgress').appendChild(m);
    L.statusEl.textContent='★ CRACKED! REVEAL ON THE NEXT BREAK…'; L.statusEl.classList.add('blink');
    if(!turbo()){ dReact('win',1200); dSay(pickLine('win')); }
    hooks.emit({type:'danse-cracked', lane:L.l, swapAt:+cand.toFixed(3), kind});
  }
  function doSwap(L){
    if(!L.nextGame) return;
    const rule=L.game.reveal().rule, bonus=2000+Math.max(0,30-L.cards)*100;
    L.revealed.push({index:L.ruleIdx, rule, cards:L.cards, correct:L.correct, cracked:true});
    G.score+=bonus; G.cracked++;
    L.game=L.nextGame; L.nextGame=null; L.ruleIdx++; L.correct=0; L.cards=0; L.swapAt=Infinity;
    L.statusEl.textContent=''; L.statusEl.classList.remove('blink');
    [...L.chainEl.children, ...L.rejEl.children].forEach((c,i)=>{ c.style.transition='transform .5s, opacity .5s'; c.style.transform=`translateY(${60+i*6}px) rotate(${i*9}deg)`; c.style.opacity='0'; setTimeout(()=>c.remove(),520); });
    banner(L,`★ RULE CRACKED · ${L.name} · rule ${L.revealed.length} · ${L.revealed[L.revealed.length-1].cards} cards · +${bonus.toLocaleString('en-US')}`,rule);
    FX.restart(L.el,'flash'); updateLaneHead(L); updateHud();
    if(!turbo()){ SFX.reveal(); FX.onoma('ババーン!','RULE CRACKED!',L.color,-8); FX.bigParty(); dReact('victory',2400); setTimeout(()=>dSay(pickLine('victory')),300); }
    hooks.emit({type:'danse-swap', lane:L.l, rule, newRuleIndex:L.ruleIdx, bonus});
  }
  let bannerT=null;
  function banner(L,head,text){
    const b=$('dBanner'); b.classList.remove('hidden','out'); b.style.setProperty('--bc',L.color);
    $('dBannerHead').textContent=head; const tx=$('dBannerText'); FX.restart(b,'x');
    if(turbo()) tx.textContent=text; else { let i=0; tx.textContent=''; const iv=setInterval(()=>{ tx.textContent=text.slice(0,i+=3); if(i>=text.length){ tx.textContent=text; clearInterval(iv);} },18); }
    clearTimeout(bannerT); bannerT=setTimeout(()=>{ b.classList.add('out'); setTimeout(()=>b.classList.add('hidden'),420); }, 5200);
  }

  /* ---------- HUD ---------- */
  function updateLaneHead(L){
    if(!L.el) return;
    L.ruleEl.textContent=`RULE #${L.ruleIdx+1} · ${Object.keys(L.game.getState().params).filter(k=>L.game.getState().params[k]).length} params`;
    [...L.pipsEl.children].forEach((p,i)=>p.classList.toggle('on',i<L.correct));
  }
  function updateHud(){
    if(!G) return;
    $('dRhythm').textContent=G.n? Math.round(G.sumT/G.n*100)+'%' : '—';
    $('dBrier').textContent=G.n? (G.sumB/G.n).toFixed(3) : '—';
    $('dCombo').textContent=G.combo; $('dComboBox').classList.toggle('fire',G.combo>=10);
    $('dCracked').textContent=G.cracked;
  }
  function renderKeys(){
    const codes=LAYOUTS[settings.layout].codes, np=['2','4','5','6','8'];
    $('dKeys').innerHTML=KEYVALS.map((v,i)=>`<div class="dkey" style="--kc:${KCOL[i]}"><div class="kc">${lbl(codes[i])}<small>· ${np[i]}</small></div>
      <div class="kp">${Math.round(v*100)}%</div><div class="kn">${KNAME[i]}</div></div>`).join('');
  }
  function drawEq(){
    if(turbo()) return;
    const cv=$('dEq'), c=cv.getContext('2d'); if(!G.an) return;
    G.an.getByteFrequencyData(G.fq);
    const W=cv.width, H=cv.height, n=48, bw=W/n; c.clearRect(0,0,W,H);
    const col=hooks.getChar().color;
    for(let i=0;i<n;i++){ const v=G.fq[Math.floor(i*G.fq.length/n*0.85)]/255, h=v*v*H;
      c.fillStyle=i%2? col : '#a55eea'; c.globalAlpha=0.35+0.65*v; c.fillRect(i*bw+2,H-h,bw-4,h); }
    c.globalAlpha=1;
  }

  /* ---------- avatar ---------- */
  let rxT=null, bubT=null, typT=null;
  function dReact(rx,hold=1500){
    const ch=hooks.getChar(); $('dAvatar').innerHTML=Chars.svg(ch.id,rx);
    const m=$('dAvatarMotion'); FX.restart(m,'x'); m.className='rx-'+rx;
    clearTimeout(rxT); if(rx!=='idle' && hold>0) rxT=setTimeout(()=>dReact('idle',0),hold);
  }
  function dSay(text){
    if(turbo()||!text) return; const b=$('dBubble'); b.classList.remove('hidden'); FX.restart(b,'pop');
    clearInterval(typT); clearTimeout(bubT); let i=0; b.textContent='';
    typT=setInterval(()=>{ b.textContent=text.slice(0,++i); if(i>=text.length) clearInterval(typT); },20);
    bubT=setTimeout(()=>b.classList.add('hidden'),2200+text.length*20);
  }
  const pickLine=key=>Chars.line(hooks.getChar().id,key);

  /* ---------- pause / end ---------- */
  function pause(){ if(!G||G.paused||G.ended) return; G.pauseT=songNow(); G.paused=true; dac.suspend(); $('dPause').classList.remove('hidden'); }
  async function resume(){ if(!G||!G.paused) return; $('dPause').classList.add('hidden'); await dac.resume(); G.paused=false; } // audio clock froze while suspended
  function finish(){
    if(!G||G.ended) return; G.ended=true; cancelAnimationFrame(raf); raf=null; FX.rush(false);
    const rules=[]; G.lanes.forEach(L=>{ L.revealed.forEach(r=>rules.push({lane:L.l, name:L.name, color:L.color, ...r}));
      const st=L.game.getState(); const fin=st.revealed? st.rule : L.game.reveal().rule;
      rules.push({lane:L.l, name:L.name, color:L.color, index:L.ruleIdx, rule:fin, cards:L.cards, correct:L.correct, cracked:false}); });
    const acc=G.n? G.sumT/G.n : 0, mb=G.n? G.sumB/G.n : 0.25, skill=1-mb/0.25;
    const rating=0.35*acc+0.65*Math.max(0,Math.min(1,skill/0.7));
    const grade=rating>=0.9?'S':rating>=0.8?'A':rating>=0.66?'B':rating>=0.5?'C':'D';
    const gc={S:'#ffd32a',A:'#2ed573',B:'#3d8bff',C:'#a55eea',D:'#ff4757'}[grade];
    G.result={grade, rating:+rating.toFixed(3), score:G.score, rhythm:+acc.toFixed(3), brier:+mb.toFixed(4), maxCombo:G.maxCombo, cracked:G.cracked, counts:{...G.counts}, cards:G.n, rules};
    const R=$('dResults');
    R.innerHTML=`<div class="modal" style="min-width:min(640px,92vw)"><div style="letter-spacing:4px;color:var(--dim);font-size:12px">${esc(G.track.title)} · ${G.D.name}</div>
      <div class="grade" style="--gc:${gc}">${grade}</div>
      <div style="font-size:34px;font-weight:900;color:var(--accent)">${G.score.toLocaleString('en-US')}</div>
      <div class="rgrid"><div><span>RHYTHM</span><b>${Math.round(acc*100)}%</b></div><div><span>MEAN BRIER</span><b>${mb.toFixed(3)}</b></div><div><span>RULES CRACKED</span><b>${G.cracked}</b></div>
        <div><span>MAX COMBO</span><b>${G.maxCombo}</b></div><div><span>CARDS</span><b>${G.n}</b></div>
        <div><span>P · G · G · O · M</span><b style="font-size:15px">${G.counts.PERFECT} · ${G.counts.GREAT} · ${G.counts.GOOD} · ${G.counts.OK} · ${G.counts.MISS}</b></div></div>
      <div class="rrules">${rules.map(r=>`<div style="--lc:${r.color}"><small>${r.name} · RULE #${r.index+1} · ${r.cracked?'★ CRACKED in '+r.cards+' cards':'not cracked ('+r.correct+'/'+(SWAP_AFTER+1)+')'}</small><br>${esc(r.rule)}</div>`).join('')}</div>
      <div class="btnrow" style="justify-content:center"><button class="pbtn gold" id="drRetry">↻ AGAIN (Enter)</button><button class="pbtn ghost" id="drSetup">⚙ SETUP</button><button class="pbtn ghost" id="drArena">← ARENA</button></div></div>`;
    R.classList.remove('hidden'); view='results';
    R.querySelector('#drRetry').onclick=()=>go(); R.querySelector('#drSetup').onclick=()=>showView('setup'); R.querySelector('#drArena').onclick=()=>close();
    if(!turbo()){ if('SA'.includes(grade)){ SFX.fanfare(); FX.bigParty(); dReact('victory',4000); } else if(grade==='D'){ SFX.fail(); dReact('defeat',4000); } else dReact('win',2500); }
    hooks.emit({type:'danse-end', ...G.result});
  }

  /* ---------- setup screen ---------- */
  function setStatus(t){ $('dsStatus').innerHTML=t; }
  function lbl(code){ return keyLabels[code]||code.replace('Key',''); }
  function guessLabels(){
    const fr=/^fr/i.test(navigator.language||'');
    keyLabels={KeyX:'X',KeyA:fr?'Q':'A',KeyS:'S',KeyD:'D',KeyW:fr?'Z':'W',KeyF:'F',KeyJ:'J',KeyK:'K',Space:'␣'};
    try{ navigator.keyboard && navigator.keyboard.getLayoutMap && navigator.keyboard.getLayoutMap().then(m=>{
      for(const c of Object.keys(keyLabels)){ const v=m.get(c); if(v && c!=='Space') keyLabels[c]=v.toUpperCase(); } renderSetup(); }).catch(()=>{}); }catch(e){}
  }
  function renderSetup(){
    syncBuiltins();
    $('dsTracks').innerHTML=tracks.length? tracks.map((t,i)=>`<div class="dsTrack ${i===settings.track?'sel':''}" data-i="${i}"><b>${t.builtin?'★ ':'🎵 '}${esc(t.title)}</b><small>${esc(t.subtitle)}${t.ana?` · ${t.ana.bpm.toFixed(1)} BPM · ${fmtTime(t.ana.duration)}`:''}</small></div>`).join('')
      : '<div style="color:var(--dim);font-size:12px">No built-in track found — drop a file below (put <b>laplaces-angel.track.js</b> next to this page for the demo track).</div>';
    $('dsTracks').querySelectorAll('.dsTrack').forEach(el=>el.onclick=()=>{ settings.track=+el.dataset.i; SFX.click(); renderSetup(); analyzeSelected(); });
    $('dsDiffs').innerHTML=Object.entries(DIFFS).map(([k,d])=>`<div class="dsDiff ${k===settings.diff?'sel':''}" data-d="${k}" style="--dc:${d.color}"><span class="stars">${d.stars}</span><b>${d.name}</b><p>${d.desc}</p></div>`).join('');
    $('dsDiffs').querySelectorAll('.dsDiff').forEach(el=>el.onclick=()=>{ settings.diff=el.dataset.d; SFX.kakin(); renderSetup(); trackInfo(); });
    $('dsLayouts').querySelectorAll('button').forEach(b=>{ b.classList.toggle('sel',b.dataset.l===settings.layout); b.onclick=()=>{ settings.layout=b.dataset.l; SFX.click(); renderSetup(); }; });
    const kv=$('dsKeyViz'), codes=LAYOUTS[settings.layout].codes; kv.className=settings.layout;
    const cap=i=>`<div class="kcap" style="--kc:${KCOL[i]}"><b>${lbl(codes[i])}</b><span>${Math.round(KEYVALS[i]*100)}%</span></div>`;
    kv.innerHTML= settings.layout==='diamond'
      ? `<div></div>${cap(4)}<div></div>${cap(1)}${cap(2)}${cap(3)}<div></div>${cap(0)}<div></div>`
      : [0,1,2,3,4].map(cap).join('');
    $('dsKeyHint').innerHTML=LAYOUTS[settings.layout].hint+'<br>Always on: numpad 2·4·5·6·8, arrows ↓←␣→↑ · Esc = pause';
    trackInfo();
  }
  function trackInfo(){
    const t=tracks[settings.track];
    if(!t){ $('dsTrackInfo').textContent=''; return; }
    if(!t.ana){ $('dsTrackInfo').innerHTML='<i>Beat analysis runs when the track is selected (takes ~1 s).</i>'; return; }
    const k=pickK(t.ana.period,DIFFS[settings.diff].target);
    $('dsTrackInfo').innerHTML=`<b>${t.ana.bpm.toFixed(1)} BPM</b> · ${fmtTime(t.ana.duration)} · ${t.ana.beats.length} beats detected<br>${DIFFS[settings.diff].name}: 1 card every ${k} beat${k>1?'s':''} (${(k*t.ana.period).toFixed(2)} s)${DIFFS[settings.diff].lanes>1?' spread over 3 tracks':''}`;
  }
  async function analyzeSelected(){
    const t=tracks[settings.track]; if(!t||t.ana) return;
    try{ await prepare(t,s=>setStatus('🎧 '+s)); setStatus(`Ready · <b>${t.ana.bpm.toFixed(1)} BPM</b> — press <b>DANSE!</b> or Enter`); renderSetup(); }
    catch(e){ setStatus('⚠ Could not decode this file: '+esc(e.message||String(e))); }
  }
  function go(){ start({}).catch(e=>setStatus('⚠ '+esc(e.message))); }
  function showView(v){ view=v; $('dSetup').classList.toggle('hidden',v!=='setup'); $('dPlay').classList.toggle('hidden',v==='setup');
    if(v==='setup'){ stopRun(); renderSetup(); } }
  function openSetup(){ open=true; $('danse').classList.remove('hidden'); hooks.pauseBgm(); showView('setup');
    $('dAvatar').innerHTML=Chars.svg(hooks.getChar().id,'idle');
    setStatus(tracks.length? 'Pick a track & a difficulty · press <b>DANSE!</b>' : 'Load a track to begin');
    analyzeSelected(); }
  function close(){ stopRun(); open=false; $('danse').classList.add('hidden'); FX.rush(false); hooks.startBgm(); hooks.emit({type:'danse-close'}); }
  const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

  function init(h){
    hooks=h; guessLabels();
    $('dsBack').onclick=()=>{ SFX.click(); close(); };
    $('dsGo').onclick=()=>{ SFX.confirm(); go(); };
    $('dPauseBtn').onclick=()=>pause();
    $('dpResume').onclick=()=>resume(); $('dpRestart').onclick=()=>{ $('dPause').classList.add('hidden'); go(); }; $('dpQuit').onclick=()=>showView('setup');
    const sp=$('dsSpeed'), of=$('dsOffset');
    sp.oninput=()=>{ settings.speed=sp.value/100; $('dsSpeedV').textContent=settings.speed.toFixed(2)+'×'; };
    of.oninput=()=>{ settings.offset=+of.value; $('dsOffsetV').textContent=(settings.offset>0?'+':'')+settings.offset+' ms'; };
    $('dsHitSfx').onchange=e=>{ settings.hitSfx=e.target.checked; };
    const file=$('dsFile'), drop=$('dsDrop');
    const take=async f=>{ if(!f) return; setStatus('Reading '+esc(f.name)+'…'); const bytes=await f.arrayBuffer();
      settings.track=addTrack(bytes,f.name.replace(/\.[^.]+$/,'')); renderSetup(); analyzeSelected(); };
    file.onchange=()=>take(file.files[0]);
    drop.addEventListener('dragover',e=>{ e.preventDefault(); drop.classList.add('over'); });
    drop.addEventListener('dragleave',()=>drop.classList.remove('over'));
    drop.addEventListener('drop',e=>{ e.preventDefault(); drop.classList.remove('over'); take(e.dataTransfer.files[0]); });
    document.addEventListener('visibilitychange',()=>{ if(document.hidden && G && !G.ended && !G.paused) pause(); });
  }

  function getState(){
    if(!G) return {running:false, open, view};
    const now=songNow();
    return {running:!G.ended, open, view, paused:G.paused, songTime:+now.toFixed(3), duration:G.ana.duration, bpm:+G.ana.bpm.toFixed(2),
      difficulty:G.diff, seed:G.seed, approach:G.approach, score:G.score, combo:G.combo, maxCombo:G.maxCombo,
      rhythm:G.n? +(G.sumT/G.n).toFixed(3) : null, brier:G.n? +(G.sumB/G.n).toFixed(4) : null, cards:G.n, cracked:G.cracked, counts:{...G.counts},
      windows:{perfect:WINDOWS[0][0], great:WINDOWS[1][0], good:WINDOWS[2][0], ok:WINDOWS[3][0], miss:MISS_W}, swapAfterCorrect:SWAP_AFTER+1,
      lanes:G.lanes.map(L=>{ const st=L.game.getState(); return {lane:L.l, name:L.name, ruleIndex:L.ruleIdx, correct:L.correct, cards:L.cards,
        params:st.params, accepted:st.accepted.slice(-8), rejected:st.rejected.slice(-8).map(r=>r.item), swapAt:isFinite(L.swapAt)? +L.swapAt.toFixed(3) : null, revealedRules:L.revealed.map(r=>({...r})) }; }),
      visible:G.live.map(n=>({id:n.id, lane:n.lane, t:+n.t.toFixed(3), inSec:+(n.t-now).toFixed(3), item:{...n.item}})).sort((a,b)=>a.t-b.t),
      schedule:G.notes.filter(n=>n.state==='pending' && n.t-now<6).map(n=>({lane:n.lane, t:+n.t.toFixed(3)})),
      history:G.history.slice(-60), result:G.result||null};
  }
  const api={
    open:()=>{ openSetup(); return true; }, close:()=>close(),
    difficulties:()=>Object.entries(DIFFS).map(([id,d])=>({id, name:d.name, lanes:d.lanes, desc:d.desc})),
    tracks:()=>{ syncBuiltins(); return tracks.map((t,i)=>({index:i, title:t.title, builtin:!!t.builtin, analyzed:!!t.ana, bpm:t.ana? +t.ana.bpm.toFixed(2):null, duration:t.ana? t.ana.duration:null})); },
    loadTrack:(arrayBuffer,title='Custom track')=>{ const i=addTrack(arrayBuffer,title); if(open) renderSetup(); return i; },
    start:(opts)=>start(opts||{}),
    press:(p)=>press(Number(p),performance.now(),null),
    pause:()=>pause(), resume:()=>resume(),
    getState, keyValues:KEYVALS.slice()
  };
  return {init, api, handleKey, isOpen:()=>open, open:openSetup, close, _test:{buildChart, pickK, frame:()=>frame()}};
})();

/*DANSE-END*/
</script>
<script>
/* =================== Item rendering (SVG) =================== */
const Render = (() => {
  const HEX={red:'#ff4757',blue:'#3d8bff',green:'#2ed573',yellow:'#ffd32a',purple:'#a55eea',orange:'#ff7f2a'};
  function shade(hex,f){ const n=parseInt(hex.slice(1),16), r=n>>16, g=(n>>8)&255, b=n&255;
    const m=(v,t)=>Math.round(v*(1-f)+t*f); return `rgb(${m(r,16)},${m(g,18)},${m(b,43)})`; }
  document.getElementById('patternDefs').innerHTML=Object.entries(HEX).map(([id,hex])=>`
    <pattern id="pat-striped-${id}" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="7" height="7" fill="${shade(hex,.72)}"/><rect width="3.4" height="7" fill="${hex}"/></pattern>
    <pattern id="pat-dotted-${id}" width="9" height="9" patternUnits="userSpaceOnUse">
      <rect width="9" height="9" fill="${shade(hex,.72)}"/><circle cx="4.5" cy="4.5" r="2.1" fill="${hex}"/></pattern>`).join('');
  const SYM={
    star:'M0,-10 L2.9,-3.6 9.8,-3.2 4.6,1.5 6.2,8.3 0,4.6 -6.2,8.3 -4.6,1.5 -9.8,-3.2 -2.9,-3.6 Z',
    heart:'M0,6.5 C-8.5,-1 -5.5,-9.5 0,-4.5 C5.5,-9.5 8.5,-1 0,6.5 Z',
    moon:'M3.5,-8.5 A9,9 0 1,0 3.5,8.5 A6.8,6.8 0 1,1 3.5,-8.5 Z',
    bolt:'M2.5,-10 L-6,1.5 L-1,1.5 L-2.5,10 L6,-2.5 L1,-2.5 Z',
    diamond:'M0,-9.5 L6.5,0 L0,9.5 L-6.5,0 Z'
  };
  function symbolG(sym,x,y,k,color){
    if(sym==='flower'){
      let c=''; for(let i=0;i<5;i++){ const a=-Math.PI/2+i*2*Math.PI/5;
        c+=`<circle cx="${(Math.cos(a)*5).toFixed(2)}" cy="${(Math.sin(a)*5).toFixed(2)}" r="3.4" fill="${color}"/>`; }
      return `<g transform="translate(${x},${y}) scale(${k})">${c}<circle r="2.6" fill="#1a1e3e"/></g>`;
    }
    return `<g transform="translate(${x},${y}) scale(${k})"><path d="${SYM[sym]}" fill="${color}"/></g>`;
  }
  function polyPoints(sides,cx,cy,r){ const pts=[]; for(let i=0;i<sides;i++){ const a=-Math.PI/2+i*2*Math.PI/sides;
      pts.push(`${(cx+Math.cos(a)*r).toFixed(1)},${(cy+Math.sin(a)*r).toFixed(1)}`); } return pts.join(' '); }
  function itemSVG(item, w=86){
    const hex=HEX[item.color];
    const r=item.size? {small:15,medium:23,large:32}[item.size] : 25;
    const style=item.style||'solid';
    let fill=hex, stroke='#0b0d20', sw=2;
    if(style==='outline'){ fill='none'; stroke=hex; sw=4; }
    if(style==='striped'){ fill=`url(#pat-striped-${item.color})`; stroke=hex; sw=1.5; }
    if(style==='dotted'){ fill=`url(#pat-dotted-${item.color})`; stroke=hex; sw=1.5; }
    const sides=Engine.sidesOf(item);
    const shapeSvg = sides===0 ? `<circle cx="50" cy="52" r="${r}" fill="${fill}" stroke="${stroke}" stroke-width="${sw}"/>`
      : `<polygon points="${polyPoints(sides,50,52,r+2)}" fill="${fill}" stroke="${stroke}" stroke-width="${sw}"/>`;
    let syms='', badge='';
    if(item.symbol){
      const n=item.count||1;
      for(let i=0;i<n;i++){ const row=Math.floor(i/5), inRow=Math.min(n-row*5,5), idx=i%5;
        syms+=symbolG(item.symbol,50-(inRow-1)*8.2+idx*16.4,104+row*14.5,.62,'#f2f4ff'); }
      if(item.count!=null) badge=`<text x="10" y="20" font-size="15" font-weight="900" fill="#8b90c0">${item.count}</text>`;
    }
    return `<svg width="${w}" height="${w*1.3}" viewBox="0 0 100 130" xmlns="http://www.w3.org/2000/svg">
      <rect x="1.5" y="1.5" width="97" height="127" rx="11" fill="#1a1e3e" stroke="#343a6e" stroke-width="2"/>${shapeSvg}${syms}${badge}</svg>`;
  }
  return {itemSVG, HEX};
})();

/* =================== UI + API window.arena + character select + intro =================== */
let introDone=false;
(() => {
  const $=id=>document.getElementById(id);
  const params=new URLSearchParams(location.search);
  let game=null, state=null, spec={}, listeners=[];
  let curChar=Chars.get(params.get('char')||'bayes');
  let cleared=new Set(), turbo=false, characterChosen=!!(params.get('char') && Chars.get(params.get('char'),true));
  let lastActivity=Date.now();

  const HELP=`ELEUSIS ARENA — API for algorithms (window.arena)
=====================================================
Goal: PREDICT the secret rule, not play accepted cards.
An item = {shape, color, symbol?, size?, style?, count?} (active dimensions:
see getParams()). Some rules depend on the PREVIOUSLY ACCEPTED items
(rejected items do not change the sequence). Relational rules always accept
the first item. "circle" has 0 sides.

THE SCORE = mean Brier per card played (state.score):
  every play() comes with a bet p = P(accepted) ∈ [0,1].
  Brier of a card = (p − verdict)², verdict ∈ {0,1}.
  score = Σ brier / number of cards. 0 = prophet, 0.25 = coin flip (p=0.5)
  → LOWER IS BETTER. No bet given ⇒ p = 0.5.
  A rejection you PREDICTED (p<0.5) is good news; only a wrong prediction
  (brier > 0.25) is punished — in proportion to the Brier lost.

End of level: arena.reveal() — ONLY ONCE per level! The rule is shown and
no more play() is possible. Then arena.judge(bool):
  judge(true)  = "I was right!"  → next level
  judge(false) = "Dang! Missed!" → same level, new rule
(Declarative: the harness/player compares its own hypothesis.)

Methods:
  arena.levels()               → level list (dims, rule tiers)
  arena.newGame(level, seed?)  → new game (seed ⇒ reproducible)
  arena.getParams()            → allowed values per dimension
  arena.getState()             → full JSON state (score = mean Brier,
                                 history = every card with its bet;
                                 rule = null until revealed)
  arena.play(spec, p?)         → {accepted, item, bet:{p,outcome,brier,good}, state}
      e.g. arena.play({shape:'square',color:'red',symbol:'star',
                       size:'large',style:'striped',count:4}, 0.82)
  arena.reveal()               → {rule, state} — one shot only!
  arena.judge(correct)         → state (next level if true, else same level)
  arena.onEvent(cb)            → cb({type:'play'|'reveal'|'judge'|'newGame'|'character'|'danse-…',...})
  arena.characters()           → playable thinkers (cosmetic only)
  arena.selectCharacter(id)    → pick a thinker, closes intro/select screens
  arena.skipIntro()            → skip the intro
  arena.setTurbo(true)         → no animations/sounds/overlays (fast harness)
  arena.help()                 → this text

DANSE MODE (rhythm × prediction) — arena.danse:
  .tracks()                    → available tracks (built-in + loaded)
  .loadTrack(arrayBuffer,title)→ add any audio file, returns its index
  .start({difficulty:'easy'|'hard'|'epic', track:0, seed?, speed?, offset?})
                               → Promise; beat analysis runs in-browser
  .getState()                  → songTime, visible cards {lane,t,inSec,item},
                                 schedule (next note times), lanes (accepted
                                 sequence, correct count, revealed rules),
                                 score, rhythm, brier, history, result
  .press(p)                    → bet p ∈ [0,1] on the card in the frame NOW
                                 (timing judged: perfect ±45ms … miss >185ms)
  .pause() .resume() .close()
  Events: danse-start · danse-hit · danse-cracked · danse-swap · danse-end
  A rule is revealed & replaced at the next break once a lane has >10
  correct calls. Per card: 300·timing + 700·(1 − brier/0.25), × combo.

URL params: ?skipIntro=1 &char=bayes &turbo=1 &level=3 &seed=42
State is also published in <script id="arena-state" type="application/json">;
each timeline card carries data-item / data-verdict / data-bet.
The secret rule lives in a closure: not readable via DOM, window or state.
Characters are purely cosmetic — scoring is identical for all.

MUSIC: put intro.mp3 (intro) and music.mp3 (background loop) next to the
HTML file — loaded automatically if present. Exact intro timeline:
window.INTRO_TIMELINE.`;

  function emit(ev){ listeners.forEach(cb=>{ try{cb(ev);}catch(e){} }); }
  function publishState(){
    state={...game.getState(), character:curChar.id, clearedLevels:[...cleared].sort((a,b)=>a-b)};
    $('arena-state').textContent=JSON.stringify(state);
    return state;
  }

  window.arena={
    help:()=>HELP,
    levels:()=>Engine.levels(),
    newGame:(level=0,seed=null)=>{ startGame(level,seed); return publishState(); },
    getParams:()=>game.getState().params,
    getState:()=>publishState(),
    play:(s,p)=>{ const r=game.play(s,p); afterPlay(r); return {...r, state:publishState()}; },
    reveal:()=>{ const r=game.reveal(); afterReveal(r); return {...r, state:publishState()}; },
    judge:(correct)=>judge(!!correct),
    onEvent:(cb)=>{ listeners.push(cb); return ()=>{listeners=listeners.filter(x=>x!==cb);} },
    characters:()=>Chars.list().map(c=>({id:c.id,name:c.name,title:c.title,era:c.era})),
    selectCharacter:(id)=>{ if(!Chars.get(id,true)) throw new Error('Unknown character: '+id+'. See arena.characters().');
      characterChosen=true; setCharacter(id); Intro.finish(); closeCharSelect(); return publishState(); },
    skipIntro:()=>{ Intro.finish(); },
    setTurbo:(on=true)=>{ setTurbo(!!on); return !!on; },
    danse:Danse.api,
  };
  Danse.init({getChar:()=>curChar, emit, isTurbo:()=>turbo, pauseBgm:()=>{ try{ $('bgm').pause(); }catch(e){} }, startBgm:()=>{ if(introDone) startBgm(); }});

  /* ---------- character ---------- */
  function setCharacter(id){
    curChar=Chars.get(id);
    const r=document.documentElement.style;
    r.setProperty('--char',curChar.color); r.setProperty('--charA',curChar.color+'55');
    $('charName').textContent=curChar.short; $('charTitle').textContent=curChar.title;
    react('idle',0);
    if(game) publishState();
    emit({type:'character', id:curChar.id});
  }
  let reactTimer=null;
  function react(rx, hold=1800){
    $('avatar').innerHTML=Chars.svg(curChar.id, rx);
    FX.restart($('avatarMotion'),'x'); $('avatarMotion').className='rx-'+rx;
    clearTimeout(reactTimer);
    if(rx!=='idle' && hold>0) reactTimer=setTimeout(()=>react('idle',0), hold);
  }
  let bubbleTimer=null, typeTimer=null;
  function say(text, ms=2400){
    if(turbo) return;
    const b=$('bubble'), t=$('bubbleText');
    b.classList.remove('hidden'); FX.restart(b,'pop');
    clearInterval(typeTimer); clearTimeout(bubbleTimer);
    let i=0; t.textContent='';
    typeTimer=setInterval(()=>{ t.textContent=text.slice(0,++i); if(i%2) SFX.blip(curChar.voice); if(i>=text.length) clearInterval(typeTimer); },24);
    bubbleTimer=setTimeout(()=>b.classList.add('hidden'), ms+text.length*24);
  }
  const sayLine=(key,prob=1)=>{ if(Math.random()<prob) say(Chars.line(curChar.id,key)); };

  /* ---------- HUD, gauge, charts ---------- */
  const RANKS=[[0.04,"Laplace's Demon"],[0.08,'Oracle'],[0.12,'Prophet'],[0.17,'Sharp Bayesian'],[0.22,'Keen Guesser'],
    [0.26,'Coin Flipper'],[0.35,'Overconfident'],[0.5,'Hot-Headed'],[9,"Gambler's Ruin"]];
  const rankOf=(s,n)=> n<3? (n? 'Warming up…' : 'Unranked') : RANKS.find(([t])=>s<t)[1];
  (function initGauge(){
    const arc=(z0,z1,col)=>{ const a0=(180-z0*360)*Math.PI/180, a1=(180-z1*360)*Math.PI/180, r=80;
      return `<path d="M${(100+r*Math.cos(a0)).toFixed(1)},${(100-r*Math.sin(a0)).toFixed(1)} A${r},${r} 0 0,1 ${(100+r*Math.cos(a1)).toFixed(1)},${(100-r*Math.sin(a1)).toFixed(1)}" stroke="${col}" stroke-width="16" fill="none"/>`; };
    $('gauge').innerHTML=arc(0,.1,'#2ed573')+arc(.1,.2,'#a3e635')+arc(.2,.3,'#ffd32a')+arc(.3,.5,'#ff4757')
      +'<text x="16" y="108" font-size="11" fill="#8b90c0">0</text><text x="92" y="12" font-size="11" fill="#8b90c0">.25</text><text x="172" y="108" font-size="11" fill="#8b90c0">.5+</text>'
      +'<g id="needle"><path d="M96,100 L100,26 L104,100 Z" fill="#fff" stroke="#0b0d20" stroke-width="2"/></g><circle cx="100" cy="100" r="8" fill="#ffd32a" stroke="#0b0d20" stroke-width="2"/>';
  })();
  function refreshHud(){
    $('levelName').textContent=state.levelName;
    $('movesVal').textContent=state.moves;
    const cv=$('comboVal'); cv.textContent='×'+state.combo;
    $('comboBox').classList.toggle('fire',state.combo>=3);
    $('comboFill').style.width=(state.combo? ((state.combo%3)||3)/3*100 : 0)+'%';
    const bv=$('brierVal'), txt=state.moves? state.score.toFixed(3) : '—';
    if(bv.textContent!==txt){ bv.textContent=txt; FX.restart(bv,'bump'); }
    bv.classList.toggle('good', state.moves>0 && state.score<0.15);
    bv.classList.toggle('bad',  state.moves>0 && state.score>0.30);
    const rk=rankOf(state.score,state.moves);
    $('rankVal').textContent=rk; $('gaugeRank').textContent= state.moves? rk : 'Place your first bet';
    $('gaugeNum').textContent=txt;
    const v=state.moves? Math.min(state.score,0.5) : 0.25;
    $('needle').style.transform=`rotate(${-90+v/0.5*180}deg)`;
    $('needle').style.opacity= state.moves? 1 : .35;
    FX.rush(state.combo>=4);
    drawSpark(); drawCalib(); drawLevelMap(); drawTicker();
    $('tlHint').classList.toggle('hidden', state.moves>0);
  }
  function drawSpark(){
    const h=state.history; let s='<line x1="0" y1="36" x2="120" y2="36" stroke="#ffd32a" stroke-dasharray="3 3" stroke-width="1" opacity=".6"/>';
    if(h.length){
      let sum=0; const pts=h.map((e,i)=>{ sum+=e.brier; const m=sum/(i+1);
        return [h.length===1?60:(i/(h.length-1))*118+1, 66-Math.min(m,.5)/.5*60]; });
      const line=pts.map(p=>p.map(v=>v.toFixed(1)).join(',')).join(' ');
      s+=`<polygon points="1,66 ${line} ${pts[pts.length-1][0].toFixed(1)},66" fill="${curChar.color}" opacity=".25"/>`
        +`<polyline points="${line}" fill="none" stroke="${curChar.color}" stroke-width="2"/>`
        +`<circle cx="${pts[pts.length-1][0]}" cy="${pts[pts.length-1][1]}" r="3" fill="#fff"/>`;
    }
    $('spark').innerHTML=s;
  }
  function drawCalib(){
    const bins=[0,0,0,0,0].map(()=>({n:0,p:0,y:0}));
    state.history.forEach(e=>{ const b=bins[Math.min(4,Math.floor(e.p*5))]; b.n++; b.p+=e.p; b.y+=e.accepted?1:0; });
    let s='<rect x="30" y="5" width="60" height="60" fill="#10132e" stroke="#343a6e"/><line x1="30" y1="65" x2="90" y2="5" stroke="#8b90c0" stroke-dasharray="3 3"/>'
      +'<text x="2" y="12" font-size="8" fill="#8b90c0">obs</text><text x="94" y="68" font-size="8" fill="#8b90c0">bet</text>';
    bins.forEach(b=>{ if(!b.n) return; const p=b.p/b.n, f=b.y/b.n, ok=Math.abs(p-f)<.15;
      s+=`<circle cx="${(30+p*60).toFixed(1)}" cy="${(65-f*60).toFixed(1)}" r="${Math.min(7,2+Math.sqrt(b.n)*1.2).toFixed(1)}" fill="${ok?'#2ed573':'#ff4757'}" stroke="#0b0d20" stroke-width="1"/>`; });
    $('calib').innerHTML=s;
  }
  function drawLevelMap(){
    const m=$('levelMap'); m.innerHTML='';
    Engine.levels().forEach(l=>{ const d=document.createElement('div');
      d.className='lvdot'+(cleared.has(l.index)?' cleared':'')+(l.index===state.level?' cur':'');
      d.title=l.name; d.innerHTML=`<span>${l.index}</span>`;
      d.onclick=()=>{ SFX.click(); startGame(l.index); }; m.appendChild(d); });
  }
  const shortItem=it=>[it.size,it.style,it.color,it.count!=null?('×'+it.count):null,it.symbol,it.shape].filter(Boolean).join(' ');
  function drawTicker(){
    $('tickerItems').innerHTML=state.history.slice(-8).reverse().map(e=>{
      const good=e.brier<0.25-1e-12, neu=Math.abs(e.brier-.25)<1e-12;
      return `<span class="tick ${neu?'':good?'g':'b'}">#${e.n} ${shortItem(e.item)} → ${e.accepted?'✔':'✕'} · bet ${Math.round(e.p*100)}% · ${e.brier.toFixed(2)}</span>`; }).join('');
  }

  /* ---------- timeline ---------- */
  function cardEl(item,verdict,bet,w=86){
    const d=document.createElement('div');
    d.className='card '+(verdict?'ok':'ko')+(bet.brier<0.04?' great':bet.brier>=0.64?' awful':'');
    d.innerHTML=Render.itemSVG(item,w);
    const tag=document.createElement('span');
    tag.className='betTag '+(bet.neutral?'n':bet.good?'g':'b');
    tag.textContent=Math.round(bet.p*100)+'%';
    d.title=`Bet ${Math.round(bet.p*100)}% · Brier ${bet.brier.toFixed(3)}`;
    d.appendChild(tag);
    d.dataset.item=JSON.stringify(item);
    d.dataset.verdict=verdict?'accepted':'rejected';
    d.dataset.bet=JSON.stringify({p:bet.p,brier:+bet.brier.toFixed(4)});
    return d;
  }
  function newCol(){ const c=document.createElement('div'); c.className='tlcol';
    c.innerHTML='<div class="tlAccept"></div><div class="tlRejects"></div>'; $('timeline').appendChild(c); return c; }
  function resetTimeline(){ $('timeline').innerHTML=''; newCol().querySelector('.tlAccept').innerHTML='<div class="startMark">START</div>'; }
  function addToTimeline(item,ok,bet){
    const tl=$('timeline'); let col, card;
    if(ok){ col=newCol(); card=cardEl(item,true,bet); col.querySelector('.tlAccept').appendChild(card); }
    else { col=tl.lastElementChild; card=cardEl(item,false,bet,70); col.querySelector('.tlRejects').appendChild(card); }
    tl.scrollLeft=tl.scrollWidth;
    return card;
  }

  /* ---------- builder ---------- */
  function buildDims(){
    const p=state.params, box=$('dims'); box.innerHTML=''; spec={};
    const rows=[['shape',p.shape],['color',p.color],['symbol',p.symbol],['size',p.size],['style',p.style]];
    for(const [d,vals] of rows){
      if(!vals) continue;
      spec[d]=vals[0];
      const row=document.createElement('div'); row.className='dimrow';
      row.innerHTML=`<span class="dimlbl">${d}</span>`;
      vals.forEach(v=>{
        const ch=document.createElement('button'); ch.className='chip'; ch.dataset.dim=d; ch.dataset.val=v;
        ch.innerHTML=(d==='color'?`<span class="dot" style="background:${Render.HEX[v]}"></span>`:'')+v;
        ch.onclick=()=>{ SFX.click(); spec[d]=v; row.querySelectorAll('.chip').forEach(c=>c.classList.toggle('sel',c===ch)); refreshPreview(true); };
        row.appendChild(ch);
      });
      row.querySelector('.chip').classList.add('sel');
      box.appendChild(row);
    }
    if(p.count){
      spec.count=1;
      const row=document.createElement('div'); row.className='dimrow';
      row.innerHTML='<span class="dimlbl">count</span>';
      for(let n=1;n<=p.count;n++){
        const ch=document.createElement('button'); ch.className='chip'; ch.textContent=n; ch.dataset.dim='count'; ch.dataset.val=n;
        ch.onclick=()=>{ SFX.click(); spec.count=n; row.querySelectorAll('.chip').forEach(c=>c.classList.toggle('sel',c===ch)); refreshPreview(true); };
        row.appendChild(ch);
      }
      row.querySelector('.chip').classList.add('sel');
      box.appendChild(row);
    }
    refreshPreview();
  }
  function specItem(){ const p=state.params;
    return {shape:spec.shape, color:spec.color, symbol:p.symbol?spec.symbol:null,
            size:p.size?spec.size:null, style:p.style?spec.style:null, count:p.count?spec.count:null}; }
  function refreshPreview(pop){ const pc=$('previewCard'); pc.innerHTML=Render.itemSVG(specItem(),104); if(pop) FX.restart(pc,'x'); }
  $('preview').addEventListener('mousemove',e=>{ const r=$('preview').getBoundingClientRect();
    const x=(e.clientX-r.left)/r.width-.5, y=(e.clientY-r.top)/r.height-.5;
    $('previewCard').style.transform=`rotateY(${x*30}deg) rotateX(${-y*24}deg) scale(1.06)`; });
  $('preview').addEventListener('mouseleave',()=>{ $('previewCard').style.transform=''; });

  /* ---------- bet panel ---------- */
  const slider=$('betSlider');
  function verbal(p){
    if(p<=.05) return ['Certainly rejected','#ff4757']; if(p<=.25) return ['Probably rejected','#ff6b81'];
    if(p<.45) return ['Leaning reject','#d98cb3'];      if(p<=.55) return ['No idea','#8b90c0'];
    if(p<.75) return ['Leaning accept','#9be7b4'];      if(p<.95) return ['Probably accepted','#5fe08f'];
    return ['Certainly accepted','#2ed573'];
  }
  let lastTick=0, lastThink=0;
  function updateBet(fromUser){
    const p=slider.value/100, [w,c]=verbal(p);
    $('betVal').textContent=slider.value+'%';
    const vb=$('betVerbal'); vb.textContent=w; vb.style.color=c;
    $('betStakes').innerHTML=`if ✔ brier <b>${((1-p)**2).toFixed(2)}</b> · if ✕ brier <b>${(p*p).toFixed(2)}</b>`;
    if(fromUser){
      const now=Date.now(); lastActivity=now;
      if(now-lastTick>40){ SFX.tick(); lastTick=now; }
      if(now-lastThink>2500 && $('avatarMotion').className==='rx-idle'){ lastThink=now; react('thinking',1300); }
    }
  }
  slider.oninput=()=>updateBet(true);
  document.querySelectorAll('#betQuick button').forEach(b=>b.onclick=()=>{ slider.value=b.dataset.v; updateBet(true); SFX.click(); });

  /* ---------- feedback: the Brier decides, not the verdict ---------- */
  function afterPlay(r){
    publishState(); refreshHud(); lastActivity=Date.now();
    const card=addToTimeline(r.item,r.accepted,r.bet);
    const rect=card.getBoundingClientRect();
    const cx=rect.left+rect.width/2, cy=rect.top+rect.height/2;
    const b=r.bet;
    if(b.neutral){
      SFX.neutral(); FX.floater(cx,cy,'p = 50% · brier 0.25','#8b90c0',15);
      FX.onoma('…','*shrug*','#8b90c0',-3); react('thinking',1000);
    } else if(b.good){
      const m=(0.25-b.brier)/0.25;
      SFX.goodBet(m,state.combo); FX.glow('good'); FX.ring(cx,cy,'#2ed573');
      FX.burst(cx,cy, Math.round(8+m*34), 5+m*5);
      FX.floater(cx,cy-20,(r.accepted?'✔':'✕')+' called it! '+b.brier.toFixed(2), m>.6?'#2ed573':'#a8e6bc', 18+m*12);
      const milestone = state.combo>=3 && state.combo%3===0;
      if(milestone){
        FX.comboBurst(state.combo); SFX.combo(); FX.onoma('ゴゴゴゴ','MENACING','#a55eea',-8); FX.punch();
        react('combo',2200); sayLine('combo');
      } else if(m>0.85){
        FX.onoma('キラーン!','SHING!','#2ed573',-6); FX.punch(); react('win'); sayLine('win',.6);
      } else {
        FX.onoma('ピコッ','blip','#9be7b4',-4); react('win',1200); sayLine('win',.25);
      }
    } else {
      const m=(b.brier-0.25)/0.75;
      SFX.badBet(m); FX.glow('bad'); FX.shake(0.4+m*2.4); FX.ring(cx,cy,'#ff4757');
      FX.floater(cx,cy-20,'💥 brier '+b.brier.toFixed(2),'#ff4757',18+m*14);
      if(b.brier>=0.81){
        SFX.gaan(); FX.impact(); FX.onoma('ドーン!!','DOOM','#ff4757',-10); react('shocked',2000); sayLine('shocked');
      } else if(m>0.3){
        FX.onoma('ガーン!','GAAN!','#ff6b81',-7); react('lose'); sayLine('lose',.6);
      } else {
        FX.onoma('ムッ','hmph','#d98cb3',-4); react('lose',1200); sayLine('lose',.25);
      }
    }
    emit({type:'play', accepted:r.accepted, item:r.item, bet:{...b}});
  }

  /* ---------- reveal (one shot) + judgement ---------- */
  let judgeVeil=null;
  function afterReveal(r){
    publishState(); refreshHud();
    SFX.reveal(); FX.onoma('ババーン!','BA-BAAN!','#ffd32a',-8); FX.punch(); FX.shake(.8);
    react('thinking',0); sayLine('thinking');
    emit({type:'reveal', rule:r.rule});
    $('btnReveal').disabled=true;
    if(judgeVeil) judgeVeil.remove();
    judgeVeil=document.createElement('div'); judgeVeil.className='modalveil';
    judgeVeil.innerHTML=`<div class="modal" style="text-align:center">
      <h2>📜 THE RULE WAS…</h2>
      <div id="ruleReveal"></div>
      <div style="color:var(--dim);font-size:13px;margin-bottom:6px">
        Final Brier: <b style="color:var(--accent)">${state.moves? state.score.toFixed(3):'—'}</b>
        over ${state.moves} cards · rank <b style="color:var(--char)">${rankOf(state.score,state.moves)}</b><br>Did you crack it?</div>
      <div class="btnrow" style="justify-content:center">
        <button class="pbtn gold" id="jYes">🎯 I WAS RIGHT!</button>
        <button class="pbtn danger" id="jNo">💀 DANG! MISSED!</button>
      </div></div>`;
    document.body.appendChild(judgeVeil);
    const rr=judgeVeil.querySelector('#ruleReveal');
    if(turbo){ rr.textContent=r.rule; }
    else { let i=0; const iv=setInterval(()=>{ rr.textContent=r.rule.slice(0,i+=2); if(i%4===0) SFX.blip(300); if(i>=r.rule.length){ rr.textContent=r.rule; clearInterval(iv);} },16); }
    judgeVeil.querySelector('#jYes').onclick=()=>window.arena.judge(true);
    judgeVeil.querySelector('#jNo').onclick=()=>window.arena.judge(false);
  }
  function judge(correct){
    if(!state.revealed) throw new Error('Reveal the rule first (arena.reveal()) before judging.');
    if(judgeVeil){ judgeVeil.remove(); judgeVeil=null; }
    const cur=state.level, last=Engine.levels().length-1;
    emit({type:'judge', correct, level:cur});
    if(correct){
      cleared.add(cur);
      SFX.fanfare(); FX.bigParty(); FX.glow('good'); FX.onoma('やったー!','YATTA!','#ffd32a',-8);
      FX.floater(innerWidth/2, innerHeight/2, cur<last? 'NEXT LEVEL ➔':'⭐ SUMMIT REACHED ⭐', '#ffd32a', 42);
      startGame(Math.min(cur+1,last));
      react('victory',3200); sayLine('victory');
    } else {
      SFX.fail(); FX.glow('bad'); FX.shake(1.6); FX.onoma('ズーン…','ZUUN…','#8b90c0',-4);
      FX.floater(innerWidth/2, innerHeight/2, 'SAME LEVEL… NEW RULE', '#ff4757', 30);
      startGame(cur);
      react('defeat',3000); sayLine('defeat');
    }
    return publishState();
  }

  /* ---------- game lifecycle ---------- */
  function startGame(level,seed=null){
    game=Engine.newGame(level,seed);
    publishState();
    $('levelSel').value=String(state.level);
    $('btnReveal').disabled=false;
    if(judgeVeil){ judgeVeil.remove(); judgeVeil=null; }
    resetTimeline(); buildDims(); refreshHud();
    emit({type:'newGame', level:state.level});
  }
  function setTurbo(on){
    turbo=on; window.__turbo=on; document.body.classList.toggle('turbo',on);
    if(on){ Intro.finish(); closeCharSelect(); try{ $('bgm').pause(); }catch(e){} }
  }
  function startBgm(){ const bgm=$('bgm'); bgm.volume=.5; if(!SFX.isMuted() && !turbo) bgm.play().catch(()=>{}); }

  const sel=$('levelSel');
  Engine.levels().forEach(l=>{ const o=document.createElement('option'); o.value=l.index; o.textContent=l.name; sel.appendChild(o); });
  sel.onchange=()=>{ SFX.click(); startGame(+sel.value); };
  $('btnNew').onclick=()=>{ SFX.click(); startGame(state.level); };
  $('btnChar').onclick=()=>{ SFX.click(); openCharSelect(); };
  $('btnDanse').onclick=()=>{ SFX.kakin(); Danse.open(); };
  $('btnTest').onclick=()=>{ try{ window.arena.play(specItem(), slider.value/100); }catch(e){ alert(e.message); } };
  $('btnReveal').onclick=()=>{
    if(state.revealed) return;
    const v=document.createElement('div'); v.className='modalveil';
    v.innerHTML=`<div class="modal" style="text-align:center"><h2>⚠ REVEAL THE RULE?</h2>
      <p style="color:var(--dim)">You get <b style="color:var(--ink)">one</b> reveal per level. After it, no more testing:
      you will judge for yourself whether your hypothesis was right.</p>
      <div class="btnrow" style="justify-content:center"><button class="pbtn ghost" id="rvCancel">Not yet</button>
      <button class="pbtn gold" id="rvGo">👁 REVEAL!</button></div></div>`;
    document.body.appendChild(v);
    v.querySelector('#rvCancel').onclick=()=>{ SFX.click(); v.remove(); };
    v.querySelector('#rvGo').onclick=()=>{ v.remove(); try{ window.arena.reveal(); }catch(e){ alert(e.message); } };
  };
  $('btnSound').onclick=()=>{ const m=SFX.toggle(); $('btnSound').textContent=m?'🔇':'🔊'; if(m) $('bgm').pause(); else if(introDone) startBgm(); };
  $('btnHelp').onclick=()=>{
    const v=document.createElement('div'); v.className='modalveil';
    v.innerHTML=`<div class="modal"><h2>❓ How to play</h2>
      <p>A <b>secret rule</b> decides which items join the sequence. Build items, <b>bet</b> the probability that
      each one gets accepted, and test it. <b>The goal is not to play accepted cards — it is to predict.</b>
      A rejection you called at 10% is a win; a certainty that gets busted is a slap (and the screen shakes accordingly).</p>
      <p>Your score = <b>mean Brier per card</b>: (bet − verdict)², averaged. 0 = prophet, 0.25 = coin flip, lower is better.
      When you think you have it, hit <b>👁 REVEAL THE RULE</b> — once only! — then judge yourself:
      right → next level; missed → you stay here with a fresh rule.</p>
      <p style="color:var(--dim)">Keys: <b>Enter</b> test · <b>← →</b> adjust bet · <b>Esc</b> skip intro.</p>
      <h2>🤖 API for algorithms</h2><pre>${HELP.replace(/</g,'&lt;')}</pre>
      <div class="btnrow"><button class="pbtn gold" id="hOk">LET'S GO</button></div></div>`;
    document.body.appendChild(v);
    v.querySelector('#hOk').onclick=()=>v.remove();
  };
  addEventListener('keydown',e=>{
    if(Danse.handleKey(e)) return;
    if(csOpen){ csKey(e); return; }
    if(!introDone){ if(e.key==='Escape') Intro.finish(); return; }
    if(document.querySelector('.modalveil')) return;
    if(e.key==='Enter'){ e.preventDefault(); $('btnTest').click(); }
    else if(e.key==='ArrowLeft'||e.key==='ArrowRight'){
      if(document.activeElement===slider) return;
      e.preventDefault(); slider.value=Math.max(0,Math.min(100,+slider.value+(e.key==='ArrowRight'?5:-5))); updateBet(true);
    }
  });
  document.addEventListener('pointerdown',e=>{ if(introDone && !turbo) FX.burst(e.clientX,e.clientY,6,2.5,[curChar.color,'#fff','#ffd32a']); });
  setInterval(()=>{ if(turbo||!introDone||csOpen||Danse.isOpen()||document.querySelector('.modalveil')) return;
    if(Date.now()-lastActivity>16000){ lastActivity=Date.now(); sayLine('idle'); } },2000);

  /* =================== CHARACTER SELECT =================== */
  let csBuilt=false, csSel=curChar.id, csOpen=false, csShown=null, csTypeT=null;
  function buildCharSelect(){
    const roster=$('csRoster'); roster.innerHTML='';
    Chars.list().forEach(c=>{
      const t=document.createElement('div'); t.className='cstile'; t.dataset.id=c.id; t.style.setProperty('--tc',c.color);
      t.innerHTML=Chars.svg(c.id,'idle',{portrait:true})+`<div class="tn">${c.short}</div>`;
      t.onmouseenter=()=>{ SFX.tick(); csPreview(c.id, c.id===csSel?'select':'idle'); };
      t.onclick=()=>csPick(c.id);
      t.ondblclick=()=>{ csPick(c.id); csConfirm(); };
      roster.appendChild(t);
    });
    $('csRoster').onmouseleave=()=>csPreview(csSel,'select');
    $('csGo').onclick=csConfirm;
    $('csDanse').onclick=()=>{ if(!csOpen) return; characterChosen=true; SFX.confirm(); setCharacter(csSel); closeCharSelect(); Danse.open(); };
    csBuilt=true;
  }
  function csPreview(id, rx='idle'){
    const key=id+'|'+rx; if(csShown===key) return; csShown=key;
    const c=Chars.get(id), box=$('charSelect');
    box.style.setProperty('--csC',c.color); box.style.setProperty('--csA',c.color+'55');
    $('csBigName').textContent=c.short;
    $('csAvatar').innerHTML=Chars.svg(id,rx);
    FX.restart($('csAvatarMotion'),'x'); $('csAvatarMotion').className='rx-'+rx;
    $('csName').textContent=c.name; $('csTitleC').textContent=c.title; $('csEra').textContent=c.era;
    $('csStats').innerHTML=Object.entries(c.stats).map(([k,v])=>`<div class="csStat"><span>${k}</span><div class="csBar"><i data-w="${v*20}"></i></div></div>`).join('');
    requestAnimationFrame(()=>requestAnimationFrame(()=>$('csStats').querySelectorAll('i').forEach(i=>i.style.width=i.dataset.w+'%')));
    const q=$('csQuoteText'), text='“'+c.catch+'”'; clearInterval(csTypeT); q.textContent='';
    if(turbo){ q.textContent=text; return; }
    let i=0; csTypeT=setInterval(()=>{ q.textContent=text.slice(0,++i); if(i%3===0) SFX.blip(c.voice); if(i>=text.length) clearInterval(csTypeT); },18);
  }
  function csMark(){ document.querySelectorAll('.cstile').forEach(t=>t.classList.toggle('sel',t.dataset.id===csSel)); }
  function csPick(id){
    csSel=id; csMark(); csShown=null; csPreview(id,'select');
    SFX.kakin(); FX.restart($('csFlash'),'go');
  }
  function csConfirm(){
    if(!csOpen) return;
    characterChosen=true; SFX.confirm();
    const w=$('wipe'); document.documentElement.style.setProperty('--char',Chars.get(csSel).color);
    FX.restart(w,'go');
    setTimeout(()=>{ closeCharSelect(); setCharacter(csSel); react('select',2000); say(Chars.line(csSel,'select')); },430);
  }
  function csKey(e){
    const ids=Chars.list().map(c=>c.id); let i=ids.indexOf(csSel);
    const step={ArrowLeft:-1,ArrowRight:1,ArrowUp:-5,ArrowDown:5}[e.key];
    if(step){ e.preventDefault(); i=(i+step+ids.length)%ids.length; csPick(ids[i]); }
    else if(e.key==='Enter'){ e.preventDefault(); csConfirm(); }
    else if(e.key==='Escape' && characterChosen){ closeCharSelect(); }
  }
  function openCharSelect(){
    if(turbo) return;
    if(!csBuilt) buildCharSelect();
    csOpen=true; $('charSelect').classList.remove('hidden');
    csSel=curChar.id; csMark(); csShown=null; csPreview(csSel,'select');
  }
  function closeCharSelect(){ csOpen=false; $('charSelect').classList.add('hidden'); clearInterval(csTypeT); }

  /* =================== INTRO — precise timeline =================== */
  /* All times in ms from the CLICK on the entry gate (intro.mp3 starts at 0):
       0      heartbeat thump #1 (starfield drifting)      450  heartbeat thump #2
       1200   SLAM "THERE IS A RULE." (+ giant 法 kanji at 1300)
       2900   SLAM "HIDDEN."    3500 SLAM "SILENT."    4100 SLAM "RELENTLESS."
       4900   Bayes' formula draws itself · riser 2 s · stars accelerate (warp at 5900)
       6900   ROSTER MONTAGE: 10 thinkers × 400 ms (6900, 7300 … 10500) — 1 cut per beat @150 BPM
       10900  SLAM "ONLY THE CALIBRATED"      11700  SLAM "WILL SURVIVE."
       12500  CLIMAX: white flash + BOOM + shockwave rings + logo slam + confetti
       12800  lens-flare sweep      13600 tagline types on (~1 s)      14600 "GET READY"
       15400  fade-out starts (600 ms)
       16000  END → character select; music.mp3 (loop) starts
   */
  window.INTRO_TIMELINE={ total_ms:16000, bpm_hint:150, steps:{
    heartbeat1:0, heartbeat2:450, slam_THERE_IS_A_RULE:1200, kanji:1300, slam_HIDDEN:2900, slam_SILENT:3500, slam_RELENTLESS:4100,
    formula_and_riser:4900, warp:5900, montage_start:6900, montage_cut_every:400, montage_cuts:10, montage_end:10900,
    slam_ONLY_THE_CALIBRATED:10900, slam_WILL_SURVIVE:11700, climax_flash_boom_logo:12500, lens_flare:12800,
    tagline:13600, get_ready:14600, fadeOut:15400, end_characterSelect:16000 } };

  const Intro=(()=>{
    const root=$('intro'), gate=$('introGate'), stage=$('introStage'), im=$('introMusic');
    let timers=[], done=false, raf=null;
    const at=(t,fn)=>timers.push(setTimeout(fn,t));
    const cv=$('introCanvas'), cx=cv.getContext('2d');
    let stars=[], speed=.15, target=.15;
    const newStar=any=>({x:Math.random()*2-1, y:Math.random()*2-1, z:any? Math.random()*.9+.1 : 1});
    function initStars(){ cv.width=innerWidth; cv.height=innerHeight; stars=Array.from({length:420},()=>newStar(true)); }
    function frame(){
      speed+=(target-speed)*.05;
      const w=cv.width, h=cv.height;
      cx.fillStyle=`rgba(4,5,14,${speed>2?.22:.45})`; cx.fillRect(0,0,w,h);
      for(const s of stars){
        const pz=s.z; s.z-=.004*speed;
        if(s.z<=.02){ Object.assign(s,newStar(false)); continue; }
        const sx=w/2+s.x/s.z*w*.5, sy=h/2+s.y/s.z*h*.5, px=w/2+s.x/pz*w*.5, py=h/2+s.y/pz*h*.5;
        if(sx<-50||sx>w+50||sy<-50||sy>h+50){ Object.assign(s,newStar(false)); continue; }
        const b=Math.min(1,(1-s.z)*1.5);
        cx.strokeStyle=`rgba(${200+55*b|0},${190+50*b|0},255,${b})`; cx.lineWidth=Math.max(.6,(1-s.z)*3.2);
        cx.beginPath(); cx.moveTo(px,py); cx.lineTo(sx,sy); cx.stroke();
      }
      raf=requestAnimationFrame(frame);
    }
    function shk(){ FX.restart(stage,'shk'); }
    function slam(text,{hold=900,small=false,color=null}={}){
      const d=document.createElement('div'); d.className='slam'+(small?' small':''); d.textContent=text;
      if(color) d.style.color=color;
      stage.appendChild(d); void d.offsetWidth; d.classList.add('go');
      SFX.hit(); shk();
      setTimeout(()=>{ d.classList.remove('go'); d.classList.add('out'); setTimeout(()=>d.remove(),260); }, hold);
    }
    function cut(c,i){
      const m=$('montage'); m.style.setProperty('--mc',c.color);
      $('mChar').innerHTML=Chars.svg(c.id,'select');
      $('mName').textContent=c.short; $('mTitle').textContent=c.title; $('mNum').textContent=`THINKER ${String(i+1).padStart(2,'0')} / 10`;
      FX.restart(m,'cut'); FX.restart($('cutflash'),'go'); SFX.whoosh(); SFX.thump();
    }
    function play(){
      gate.classList.add('hidden'); stage.classList.remove('hidden'); $('introSkip').classList.remove('hidden');
      SFX.unlock();
      try{ im.currentTime=0; im.volume=.9; im.play().catch(()=>{}); }catch(e){}
      $('fxCanvas').style.zIndex=310;
      initStars(); frame();
      SFX.thump(); at(450,()=>SFX.thump());
      at(1200,()=>{ slam('THERE IS A RULE.',{hold:1500}); SFX.rumble(3.6); });
      at(1300,()=>$('kanji').classList.add('show'));
      at(2900,()=>slam('HIDDEN.',{hold:480,small:true}));
      at(3500,()=>slam('SILENT.',{hold:480,small:true}));
      at(4100,()=>{ slam('RELENTLESS.',{hold:700,color:'#ff4757'}); target=.5; });
      at(4900,()=>{ $('kanji').classList.add('hide'); $('formula').classList.add('show'); SFX.riser(2); target=1.4; });
      at(5900,()=>{ target=5; });
      at(6800,()=>{ $('formula').classList.add('hidden'); $('formulaSub').classList.add('hidden'); });
      Chars.list().forEach((c,i)=>at(6900+i*400,()=>{ if(i===0) $('montage').classList.add('on'); cut(c,i); }));
      at(10900,()=>{ $('montage').classList.remove('on'); target=.8; slam('ONLY THE CALIBRATED',{hold:700,small:true}); });
      at(11700,()=>slam('WILL SURVIVE.',{hold:650,color:'#ffd32a'}));
      at(12500,()=>{ FX.restart($('whiteflash'),'go'); SFX.boom(); shk(); target=.3;
        ['ir1','ir2','ir3'].forEach((id,k)=>setTimeout(()=>FX.restart($(id),'go'),k*140));
        $('introLogo').classList.add('show'); $('introGearL').classList.add('show'); $('introGearR').classList.add('show');
        FX.bigParty(); });
      at(12800,()=>FX.restart($('flare'),'go'));
      at(13600,()=>{ const t='BET · PREDICT · PIERCE THE SECRET', el=$('introTag'); let i=0;
        const iv=setInterval(()=>{ el.textContent=t.slice(0,++i); if(t[i-1]!==' ') SFX.blip(900); if(i>=t.length) clearInterval(iv); },30); });
      at(14600,()=>$('introPress').classList.add('show'));
      at(15400,()=>root.classList.add('fadeout'));
      at(16000,finish);
    }
    function finish(){
      if(done) return; done=true; introDone=true;
      timers.forEach(clearTimeout); timers=[];
      try{ im.pause(); }catch(e){}
      cancelAnimationFrame(raf);
      $('fxCanvas').style.zIndex='';
      root.classList.add('fadeout'); setTimeout(()=>root.remove(),650);
      startBgm();
      if(!characterChosen) openCharSelect();
    }
    gate.addEventListener('click',play,{once:true});
    $('introSkip').onclick=e=>{ e.stopPropagation(); finish(); };
    return {finish, isDone:()=>done};
  })();

  /* ---------- boot ---------- */
  updateBet(false);
  const lv0=params.get('level'), sd0=params.get('seed');
  startGame(lv0!=null? +lv0 : 0, sd0!=null? +sd0 : null);
  setCharacter(curChar.id);
  if(params.get('turbo')==='1') setTurbo(true);
  if(params.get('skipIntro')==='1') Intro.finish();
  console.log('%cELEUSIS ⚡ ARENA','font-size:20px;font-weight:900;color:#ffd32a');
  console.log('API: arena.help() — score = mean Brier, one reveal per level. Harness tip: ?skipIntro=1&char=bayes&turbo=1');
})();
</script>
</body>
</html>
